export module glm.vec2;

import "glm/vec2.hpp";

namespace glm
{
	export using bvec2 = glm::bvec2;

	export using i8vec2 = glm::i8vec2;
	export using u8vec2 = glm::u8vec2;

	export using i16vec2 = glm::i16vec2;
	export using u16vec2 = glm::u16vec2;

	export using ivec2 = glm::ivec2;
	export using uvec2 = glm::uvec2;

	export using vec2 = glm::vec2;
	export using dvec2 = glm::dvec2;

	export using i64vec2 = glm::i64vec2;
	export using u64vec2 = glm::u64vec2;
