export module glm.vec4;

import "glm/vec4.hpp";

namespace glm
{
	export using bvec4 = glm::bvec4;

	export using i8vec4 = glm::i8vec4;
	export using u8vec4 = glm::u8vec4;

	export using i16vec4 = glm::i16vec4;
	export using u16vec4 = glm::u16vec4;

	export using ivec4 = glm::ivec4;
	export using uvec4 = glm::uvec4;

	export using vec4 = glm::vec4;
	export using dvec4 = glm::dvec4;

	export using i64vec4 = glm::i64vec4;
	export using u64vec4 = glm::u64vec4;
}
