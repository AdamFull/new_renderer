export module glm.vec3;

import "glm/vec3.hpp";

namespace glm
{
	export using bvec3 = glm::bvec3;

	export using i8vec3 = glm::i8vec3;
	export using u8vec3 = glm::u8vec3;

	export using i16vec3 = glm::i16vec3;
	export using u16vec3 = glm::u16vec3;

	export using ivec3 = glm::ivec3;
	export using uvec3 = glm::uvec3;

	export using vec3 = glm::vec3;
	export using dvec3 = glm::dvec3;

	export using i64vec3 = glm::i64vec3;
	export using u64vec3 = glm::u64vec3;
