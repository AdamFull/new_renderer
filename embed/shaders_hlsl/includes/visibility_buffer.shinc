{
	includes: ["shader_inputs"];

	code: 
	"""
		// Input buffers
		REGISTER_TEXTURE_SLOT(1, 0, Texture2D, SamplerState, visbuffer_geometry, 1)
		REGISTER_TEXTURE_SLOT(1, 1, Texture2D, SamplerState, visbuffer_matobj, 2)
		REGISTER_TEXTURE_SLOT(1, 2, Texture2D, SamplerState, visbuffer_skinvbo, 3)

		[[vk::binding(1, 3)]] cbuffer GeometryBuffers : register(b2)
		{
			RawVertexBuffer vb;
			RawIndexBuffer ib;
			MeshletBuffer mb; 
			MeshletVertexRemapBuffer vrb;
			MeshletBoundsBuffer bb;
			MeshletTriangleBuffer tb;
			MeshLodBuffer lb;
		};

		// Visbuffer structures
		struct VertexAttribute
		{
			float3 pos;
			float3 pos_dx;
			float3 pos_dy;

			float linearZ;

			float2 uv;
			float2 uv_dx;
			float2 uv_dy;

			float3 normal;
			float4 tangent;
			float4 color;
			
			float3 barycentrics;
		};

		struct BarycentricDeriv
		{
			float3 barycentrics;
			float3 ddx;
			float3 ddy;
		};

		struct VisibilityBuffer
		{
			uint32_t drawID;
			uint32_t triangleID;
			uint32_t transparent;

			uint32_t matID;
			uint32_t objID;

			uint32_t vboID;
		};

		bool loadVisBuffer(in float2 uv, out VisibilityBuffer res)
		{
			uint32_t geometryData = SAMPLE_TEXTURE2D(visbuffer_geometry, uv).RGBA;
			res.drawID = (geometryData >> 23) & 0x000000FF;
			res.triangleID = (geometryData & 0x007FFFFF);
			res.transparent = (geometryData >> 31);
			res.triangleID -= 1u;

			uint32_t matobjData = SAMPLE_TEXTURE2D(visbuffer_matobj, uv).RGBA;
			res.matID = matobjData & 0xFFFF;
			res.objID = matobjData >> 16;

			res.vboID = SAMPLE_TEXTURE2D(visbuffer_skinvbo, uv).RGBA;

			return (res.triangleID != 0xFFFFFFFFu);
		}

		FRawVertex[3] loadTriangle(in uint32_t drawID, in uint32_t primID)
		{
			FRawVertex[3] vertices;

			FDrawIndexedIndirectData draw_command = indirectCommandBuffer.Get().commands[drawID];

			// Index of the first vertex of this draw call's geometry
			uint32_t startIndex = draw_command.firstIndex;

			// Get position in the Index Buffer of each vertex in this triangle (eg 31, 32, 33)
			uint32_t triVert1IndexBufferPosition = (primID * 3 + 0) + startIndex;
			uint32_t triVert2IndexBufferPosition = (primID * 3 + 1) + startIndex;
			uint32_t triVert3IndexBufferPosition = (primID * 3 + 2) + startIndex;	

			// Now get vertex index from index buffer (eg, 17, 41, 32)
			Index triVert0Index = ib.Get().indices[triVert1IndexBufferPosition];
			Index triVert1Index = ib.Get().indices[triVert2IndexBufferPosition];
			Index triVert2Index = ib.Get().indices[triVert3IndexBufferPosition];

			// Load vertex data of the 3 control points
			vertices[0] = vb.Get().vertices[draw_command.vertexOffset + triVert0Index];
			vertices[1] = vb.Get().vertices[draw_command.vertexOffset + triVert1Index];
			vertices[2] = vb.Get().vertices[draw_command.vertexOffset + triVert2Index];

			return vertices;
		}

		// Computes the partial derivatives of a triangle from the projected screen space vertices
		BarycentricDeriv computeBarycentrics(float4 vertexCS0, float4 vertexCS1, float4 vertexCS2, float2 pixelCS, float2 invSize)
		{
			BarycentricDeriv ret ;

			float3 pos0 = vertexCS0.xyz / vertexCS0.w;
			float3 pos1 = vertexCS1.xyz / vertexCS1.w;
			float3 pos2 = vertexCS2.xyz / vertexCS2.w;

			float3 RcpW = 1.0 / float3(vertexCS0.w, vertexCS1.w, vertexCS2.w);

			float3 pos120X = float3(pos1.x, pos2.x, pos0.x);
			float3 pos120Y = float3(pos1.y, pos2.y, pos0.y);
			float3 pos201X = float3(pos2.x, pos0.x, pos1.x);
			float3 pos201Y = float3(pos2.y, pos0.y, pos1.y);

			float3 C_dx = pos201Y - pos120Y;
			float3 C_dy = pos120X - pos201X;

			float3 C = C_dx * (pixelCS.x - pos120X) + C_dy * (pixelCS.y - pos120Y);
			float3 G = C * RcpW;

			float H = dot(C, RcpW);
			float rcpH = 1.0 / H;

			ret.barycentrics = G * rcpH;

			float3 G_dx = C_dx * RcpW;
			float3 G_dy = C_dy * RcpW;

			float H_dx = dot(C_dx, RcpW);
			float H_dy = dot(C_dy, RcpW);

			ret.ddx = (G_dx * H - G * H_dx) * (rcpH * rcpH) * (2.0f * invSize.x);
			ret.ddy = (G_dy * H - G * H_dy) * (rcpH * rcpH) * (-2.0f * invSize.y);

			return ret;
		}

		float interpolate(float a, float b, float c, float3 barycentrics)
		{
			return a * barycentrics.x + b * barycentrics.y + c * barycentrics.z;
		}

		float2 interpolate(float2 a, float2 b, float2 c, float3 barycentrics)
		{
			return a * barycentrics.x + b * barycentrics.y + c * barycentrics.z;
		}

		float3 interpolate(float3 a, float3 b, float3 c, float3 barycentrics)
		{
			return a * barycentrics.x + b * barycentrics.y + c * barycentrics.z;
		}

		float4 interpolate(float4 a, float4 b, float4 c, float3 barycentrics)
		{
			return a * barycentrics.x + b * barycentrics.y + c * barycentrics.z;
		}

		VertexAttribute getVertexData(float2 uv, in VisibilityBuffer visbuffer)
		{
			FRawVertex[3] vertices = loadTriangle(visbuffer.drawID, visbuffer.triangleID);

			// Load vertex data of the 3 vertices
			float3 position0 = float3(vertices[0].px, vertices[0].py, vertices[0].pz);
			float3 position1 = float3(vertices[1].px, vertices[1].py, vertices[1].pz);
			float3 position2 = float3(vertices[2].px, vertices[2].py, vertices[2].pz);

			// Load mesh model matrix
			FSceneNode node = nodeBuffer.Get().nodes[visbuffer.objID];
			mat4 model = node.model;
			
#ifdef HAS_SKIN
			if(node.skeletonID != ~0u)
			{
#if defined(JOINTS_8BIT)
				u8vec4 joints;
				joints.x = uint8_t(vertices[0].joints_8 & 0xFF);
				joints.y = uint8_t((vertices[0].joints_8 >> 8) & 0xFF);
				joints.z = uint8_t((vertices[0].joints_8 >> 16) & 0xFF);
				joints.w = uint8_t((vertices[0].joints_8 >> 24) & 0xFF);
#elif defined(JOINTS_16BIT)
				u16vec4 joints;
#endif
				mat4 skinMat = 
					vertices[0].wx * jointsBuffer.Get().matrices[node.skeletonID + joints.x] +
					vertices[0].wy * jointsBuffer.Get().matrices[node.skeletonID + joints.y] +
					vertices[0].wz * jointsBuffer.Get().matrices[node.skeletonID + joints.z] +
					vertices[0].ww * jointsBuffer.Get().matrices[node.skeletonID + joints.w];
		
				model = model * skinMat;
			}
#endif // HAS_SKIN

			// Transform positions to clip space
			mat4 mvp = frameData.projection * frameData.view * model;
			float4 clipPos0 = mvp * float4(position0, 1.0);
			float4 clipPos1 = mvp * float4(position1, 1.0);
			float4 clipPos2 = mvp * float4(position2, 1.0);

			//uv.y = 1.0 - uv.y;
			float2 ndcClip = uv * 2.0 - 1.0;

			BarycentricDeriv bary = computeBarycentrics(clipPos0, clipPos1, clipPos2, ndcClip, frameData.invViewportDimension);

			VertexAttribute res;

			// INTERPOLATE POSITION
			position0 = (model * float4(position0, 1.0)).xyz;
			position1 = (model * float4(position1, 1.0)).xyz;
			position2 = (model * float4(position2, 1.0)).xyz;
			
			res.pos = interpolate(position0, position1, position2, bary.barycentrics);
			res.pos_dx = interpolate(position0, position1, position2, bary.ddx);
			res.pos_dy = interpolate(position0, position1, position2, bary.ddy);

			res.linearZ = interpolate(clipPos0.w, clipPos1.w, clipPos2.w, bary.barycentrics);
			res.barycentrics = bary.barycentrics;

			// INTERPOLATE TEXCOORD
#ifdef HAS_TEXCOORD
			float2 uv0 = float2(vertices[0].u, vertices[0].v);
			float2 uv1 = float2(vertices[1].u, vertices[1].v);
			float2 uv2 = float2(vertices[2].u, vertices[2].v);

			res.uv = interpolate(uv0, uv1, uv2, bary.barycentrics);
			res.uv_dx = interpolate(uv0, uv1, uv2, bary.ddx);
			res.uv_dy = interpolate(uv0, uv1, uv2, bary.ddy);
#endif

			// INTERPOLATE NORMAL
#ifdef HAS_NORMAL
			float3 normal0 = float3(vertices[0].nx, vertices[0].ny, vertices[0].nz);
			float3 normal1 = float3(vertices[1].nx, vertices[1].ny, vertices[1].nz);
			float3 normal2 = float3(vertices[2].nx, vertices[2].ny, vertices[2].nz);

			float3 normal = interpolate(normal0, normal1, normal2, bary.barycentrics);
			res.normal = normalize(mat3(model) * normal);
#else
			res.normal = cross(res.pos_dx, res.pos_dy);
#endif // HAS_NORMAL

			// INTERPOLATE TANGENT
#if defined(TANGENT_VEC3) || defined(TANGENT_VEC4)
			float4 tangent0 = float4(vertices[0].tx, vertices[0].ty, vertices[0].tz, 1.0);
			float4 tangent1 = float4(vertices[1].tx, vertices[1].ty, vertices[1].tz, 1.0);
			float4 tangent2 = float4(vertices[2].tx, vertices[2].ty, vertices[2].tz, 1.0);
#if defined(TANGENT_VEC4)
			tangent0.w = vertices[0].tw;
			tangent1.w = vertices[1].tw;
			tangent2.w = vertices[2].tw;
#endif // TANGENT_VEC4

			float4 tangent = interpolate(tangent0, tangent1, tangent2, bary.barycentrics);
			res.tangent = float4(normalize(mat3(model) * float3(tangent)), tangent.w);
#else	
			float3 tangent = (res.uv_dy.t * res.pos_dx - res.uv_dx.t * res.pos_dy) / (res.uv_dx.s * res.uv_dy.t - res.uv_dy.s * res.uv_dx.t); 
			tangent = normalize(tangent - res.normal * dot(res.normal, tangent));
			res.tangent = float4(tangent, 1.0);
#endif // TANGENT

			// INTERPOLATE COLOR
#if defined(COLOR_VEC3) || defined(COLOR_VEC4)
			float4 color0 = float4(vertices[0].cr, vertices[0].cg, vertices[0].cb, 1.0);
			float4 color1 = float4(vertices[1].cr, vertices[1].cg, vertices[1].cb, 1.0);
			float4 color2 = float4(vertices[2].cr, vertices[2].cg, vertices[2].cb, 1.0);
#if defined(COLOR_VEC4)
			color0.a = vertices[0].ca;
			color1.a = vertices[1].ca;
			color2.a = vertices[2].ca;
#endif // COLOR_VEC4
			res.color = interpolate(color0, color1, color2, bary.barycentrics);
#else
			res.color = float4(1.0);
#endif // COLOR

			return res;
		}
	""";
}