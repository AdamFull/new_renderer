{
	includes: ["interop/base"];

	code: 
	"""
	// Vertex inputs
#ifdef VERTEX_SHADER
	struct VSInput
	{
		[[vk::location(0)]] float4 Pos : POSITION0;

#if defined(COLOR_VEC3)
		[[vk::location(1)]] float3 Color : COLOR0;
#elif defined(COLOR_VEC4)
		[[vk::location(1)]] float3 Color : COLOR0;
#endif // HAS_COLOR
		
#ifdef HAS_TEXCOORD
		[[vk::location(2)]] float2 UV : TEXCOORD0;
#endif // HAS_TEXCOORD
		
#ifdef HAS_NORMAL
		[[vk::location(3)]] float3 Normal : NORMAL0;
#endif // HAS_NORMAL
		
#if defined(TANGENT_VEC3)
		[[vk::location(4)]] float3 Tangent : TANGENT0;
#elif defined(TANGENT_VEC4)
		[[vk::location(4)]] float4 Tangent : TANGENT0;
#endif // HAS_TANGENT

#ifdef HAS_SKIN
		[[vk::location(5)]] uint4 Joints : BLENDINDICES0;
		[[vk::location(6)]] float4 Weights : BLENDWEIGHT0;
#endif // HAS_SKIN
	};
#endif // VERTEX_SHADER

	#define REGISTER_TEXTURE_SLOT(SetIndex, BindingIndex, TextureType, SamplerType, TextureName, RegisterIndex) \
	[[vk::combinedImageSampler]][[vk::binding(SetIndex, BindingIndex)]] TextureType TextureName : register(t##RegisterIndex); \
	[[vk::combinedImageSampler]][[vk::binding(SetIndex, BindingIndex)]] SamplerType TextureName##_sampler : register(t##RegisterIndex);

	#define REGISTER_TEXTURE_SLOT_ARRAY(SetIndex, BindingIndex, TextureType, SamplerType, TextureName, RegisterIndex) \
	[[vk::combinedImageSampler]][[vk::binding(SetIndex, BindingIndex)]] TextureType TextureName[] : register(t##RegisterIndex); \
	[[vk::combinedImageSampler]][[vk::binding(SetIndex, BindingIndex)]] SamplerType TextureName##_sampler[] : register(t##RegisterIndex);

	// Bindless texture
	REGISTER_TEXTURE_SLOT_ARRAY(0, 2, Texture2D, SamplerState, globalTextures, 0)

	#define GET_GLOB_TEXTURE_SLOT(texture_index) globalTextures[textureRemapBuffer.Get().remap[texture_index]]
	#define GET_GLOB_SAMPLER_SLOT(texture_index) globalTextures_sampler[textureRemapBuffer.Get().remap[texture_index]]

	#define SAMPLE_TEXTURE2D_SLOT(texture_index, texcoord) GET_GLOB_TEXTURE_SLOT(texture_index).Sample(GET_GLOB_SAMPLER_SLOT(texture_index), texcoord)
	#define SAMPLE_TEXTURE2D(texture, texcoord) texture.Sample(texture##_sampler, texcoord)

	#define SAMPLE_TEXTURE2D_GRAD_SLOT(texture_index, texcoord, texcoord_dx, texcoord_dy) GET_GLOB_TEXTURE_SLOT(texture_index).SampleGrad(GET_GLOB_SAMPLER_SLOT(texture_index), texcoord, texcoord_dx, texcoord_dy)
	#define SAMPLE_TEXTURE2D_GRAD(texture, texcoord, texcoord_dx, texcoord_dy) texture.SampleGrad(texture##_sampler, texcoord, texcoord_dx, texcoord_dy)

	#define SAMPLE_TEXTURE2D_GRAD_LOD(texture_index, texcoord, mip_level) GET_GLOB_TEXTURE_SLOT(texture_index).SampleLevel(GET_GLOB_SAMPLER_SLOT(texture_index), texcoord, mip_level)
	#define SAMPLE_TEXTURE2D_LOD(texture, texcoord, mip_level) texture.SampleLevel(texture##_sampler, texcoord, mip_level)
	""";
}