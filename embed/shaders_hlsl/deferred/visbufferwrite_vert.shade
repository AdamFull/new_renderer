{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["shader_inputs"];

	code: 
	"""
		struct VSOutput
		{
			float4 Pos : SV_POSITION;
			[[vk::location(0)]] uint32_t drawID : SV_Target0;
			[[vk::location(1)]] uint32_t matID : SV_Target1;
			[[vk::location(2)]] uint32_t objID : SV_Target2;
			[[vk::location(3)]] uint32_t vboID : SV_Target3;
		};

		struct FUniformMeshData
		{
			uint32_t callID;
		};

		[[vk::push_constant]] FUniformMeshData meshData;

		VSOutput main(VSInput input, in uint instanceID : SV_InstanceID) 
		{
			VSOutput output = (VSOutput)0;

			uint32_t draw_index = meshData.callID + gl_DrawIDARB + instanceID;
			FDrawMeshinfo draw_info = drawInfoBuffer.infos[draw_index];

			// Calculate skinned matrix from weights and joint indices of the current vertex
			FSceneNode node = nodeBuffer.nodes[draw_info.nodeID];
			float4x4 modelMatrix = node.model;

#ifdef HAS_SKIN
			if(node.skeletonID != ~0u)
			{
#if defined(JOINTS_8BIT)
				uint4 joints = uint4(uint8_t(input.Joints.x * 255.0), uint8_t(input.Joints.y * 255.0), uint8_t(input.Joints.z * 255.0), uint8_t(input.Joints.w * 255.0));
#elif defined(JOINTS_16BIT)
				min16uint4 joints = min16uint4(uint16_t(input.Joints.x * 65535.0), uint16_t(input.Joints.y * 65535.0), uint16_t(input.Joints.z * 65535.0), uint16_t(input.Joints.w * 65535.0));
#endif
				float4x4 skinMat = 
					input.Weights.x * jointsBuffer.Get().matrices[node.skeletonID + joints.x] +
					input.Weights.y * jointsBuffer.Get().matrices[node.skeletonID + joints.y] +
					input.Weights.z * jointsBuffer.Get().matrices[node.skeletonID + joints.z] +
					input.Weights.w * jointsBuffer.Get().matrices[node.skeletonID + joints.w];
		
				modelMatrix = modelMatrix * skinMat;
			}
#endif // HAS_SKIN


			float4 localPos = modelMatrix * float4(input.Pos, 1.0);
			localPos = float4(localPos.xyz / localPos.w, 1.0);

			FMesh mesh = meshBuffer.meshes[draw_info.meshID];

			output.drawID = meshData.callID + gl_DrawIDARB;
			output.matID = mesh.materialID;
			output.objID = draw_info.nodeID;
			output.vboID = draw_info.vboID;
			output.Pos = frameData.projection * frameData.view * localPos;

			return output;
		}
	""";
}