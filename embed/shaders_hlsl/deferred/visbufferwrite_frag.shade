{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack"
	];

	definitions: [];

	require_extensions: [];
	includes: [];

	code: 
	"""
		// Force early depth/stencil test
		struct VSOutput
		{
			[[vk::location(0)]] uint32_t drawID : SV_Target0;
			[[vk::location(1)]] uint32_t matID : SV_Target1;
			[[vk::location(2)]] uint32_t objID : SV_Target2;
			[[vk::location(3)]] uint32_t vboID : SV_Target3;
		};

		struct PSOutput
		{
		    float4 vbid : SV_Target0;
		    float4 moid : SV_Target1;
		    float4 svid : SV_Target2;
		};

		// Engel's packing function (without alpha bit)
		uint packVBID(bool opaque, uint drawID, uint primitiveID)
		{
			uint drawID_primID = ((drawID << 23) & 0x7F800000) | (primitiveID & 0x007FFFFF);
			return (opaque) ? drawID_primID : (1 << 31) | drawID_primID;
		}

		uint packMOID(uint matID, uint objID)
		{
			return (objID << 16) | (matID & 0xFFFF);
		}

		PSOutput main(VSOutput input, uint primitiveID : SV_PrimitiveId) 
		{
			PSOutput output;

			vbid = packVBID(true, input.drawID, primitiveID + 1u);
			moid = packMOID(input.matID, input.objID);
			svid = input.vboID;

			return output;
		}
	""";
}