{
	name: "visibilitybuffer";
	lang: "hlsl";
	shaders: [
		{
			name: "write";
			sources: [
				{
					type: "vertex";
					shader_name: "visbufferwrite_vert";
				},
				{
					type: "fragment";
					shader_name: "visbufferwrite_frag";
				}
			];
		},
		{
			name: "shade";
			sources: [
				{
					type: "compute";
					shader_name: "visbuffershade_comp";
				}
			];
		},
		{
			name: "write_mesh";
			sources: [
				{
					type: "task";
					shader_name: "visbufferwrite_task";
				},
				{
					type: "mesh";
					shader_name: "visbufferwrite_mesh";
				}
			];
		}
	];

	compile: [
		{ 
			shader_name: "write";
			permutation_generator: {
				definitions: [
					{ base: "HAS_TEXCOORD" },
					{ base: "HAS_NORMAL" },
					{ base: "HAS_SKIN", var:[{ base: "JOINTS_8BIT" }, { base: "JOINTS_16BIT" }] },
					{ base: "COLOR_VEC3" },
					{ base: "COLOR_VEC4" },
					{ base: "TANGENT_VEC3" },
					{ base: "TANGENT_VEC4" },
					{ base: "INDEX_8BIT" },
					{ base: "INDEX_16BIT" }
				];
			};
		},
		{
			shader_name: "shade";
			permutation_generator: {
				definitions: [
					{ base: "HAS_TEXCOORD" },
					{ base: "HAS_NORMAL" },
					{ base: "HAS_SKIN", var:[{ base: "JOINTS_8BIT" }, { base: "JOINTS_16BIT" }] },
					{ base: "COLOR_VEC3" },
					{ base: "COLOR_VEC4" },
					{ base: "TANGENT_VEC3" },
					{ base: "TANGENT_VEC4" },
					{ base: "INDEX_8BIT" },
					{ base: "INDEX_16BIT" }
				];
			};
		}
		// {
		// 	shader_name: "write_mesh";
		// 	permutation_generator: {
		// 		definitions: [
		// 			{ base: "HAS_TEXCOORD" },
		// 			{ base: "HAS_NORMAL" },
		// 			{ base: "HAS_SKIN", var:[{ base: "JOINTS_8BIT" }, { base: "JOINTS_16BIT" }] },
		// 			{ base: "COLOR_VEC3" },
		// 			{ base: "COLOR_VEC4" },
		// 			{ base: "TANGENT_VEC3" },
		// 			{ base: "TANGENT_VEC4" },
		// 			{ base: "INDEX_8BIT" },
		// 			{ base: "INDEX_16BIT" }
		// 		];
		// 	};
		// }
	];
}