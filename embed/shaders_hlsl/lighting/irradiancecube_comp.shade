{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack"
	];

	definitions: [];
	require_extensions: [];
	includes: ["compute_common", "lighting_model"];

	// TODO: add permute reject
	code: 
	"""
		[[vk::binding(1, 0)]] RWTexture2D<float4> out_color : register(u0);
		REGISTER_TEXTURE_SLOT(1, 1, TextureCube, SamplerState, sampler_color, 1)
		
		const float deltaPhi = (2.0f * PI) / 180.0f;
		const float deltaTheta = (0.5f * PI) / 64.0f;
		
		[numthreads(8, 8, 1)]
		void main(uint3 globalInvocationID : SV_DispatchThreadID, uint3 localInvocationID : SV_GroupThreadID) 
		{
			uint2 image_size = imageSize(out_color);

			uint2 px = uint2(0, 0);
			float2 uv = float2(0, 0);
			if(swizzle_compute_workgroups_8x8(globalInvocationID.xy, localInvocationID.xy, image_size, uv, px))
				return;
		
			for (uint32_t i = 0; i != 6; ++i) 
			{
				float3 N = normalize(cubeDir(uv, i));
				float3 up = float3(0.0f, 1.0f, 0.0f);
				float3 right = normalize(cross(up, N));
				up = cross(N, right);
		
				float3 colour = float3(0.0f);
				uint32_t sampleCount = 0u;
		
				for (float phi = 0.0f; phi < TWO_PI; phi += deltaPhi) 
				{
					for (float theta = 0.0f; theta < HALF_PI; theta += deltaTheta) 
					{
						float3 tempVec = cos(phi) * right + sin(phi) * up;
						float3 sampleVector = cos(theta) * N + sin(theta) * tempVec;
						colour += SAMPLE_TEXTURE2D(sampler_color, sampleVector).rgb * cos(theta) * sin(theta);
						sampleCount++;
					}
				}
		
				out_color[uint3(px.x, px.y, i)] = float4(PI * colour / float(sampleCount), 1.0f);
			}
		}
	""";
}