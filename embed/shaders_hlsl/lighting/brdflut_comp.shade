{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack"
	];

	definitions: [];
	require_extensions: [];
	includes: ["compute_common", "lighting_model"];

	code: 
	"""
		[[vk::binding(1, 0)]] RWTexture2D<float4> out_color : register(u0);

		const uint NUM_SAMPLES = 1024u;

		float2 BRDF(float NoV, float roughness) 
		{
			// Normal always points along z-axis for the 2D lookup 
			const float3 N = float3(0.0f, 0.0f, 1.0f);
			float3 V = float3(sqrt(1.0f - NoV * NoV), 0.0f, NoV);
		
			float2 LUT = float2(0.0f);
		
			for (uint i = 0u; i < NUM_SAMPLES; i++) 
		    {
				float2 Xi = hammersley2d(i, NUM_SAMPLES);
				float3 H = importanceSample_GGX(Xi, roughness, N);
				float3 L = 2.0f * dot(V, H) * H - V;
		
				float dotNL = max(dot(N, L), 0.0f);
				float dotNV = max(dot(N, V), 0.0f);
				float dotVH = max(dot(V, H), 0.0f); 
				float dotNH = max(dot(H, N), 0.0f);
		
				if (dotNL > 0.0f) 
		        {
					float G = G_SchlicksmithGGX(dotNL, dotNV, roughness);
					float G_Vis = (G * dotVH) / (dotNH * dotNV);
					float Fc = pow(1.0f - dotVH, 5.0f);
					LUT += float2((1.0f - Fc) * G_Vis, Fc * G_Vis);
				}
			}
		
			return LUT / float(NUM_SAMPLES);
		}
		
		[numthreads(8, 8, 1)]
		void main(uint3 globalInvocationID : SV_DispatchThreadID, uint3 localInvocationID : SV_GroupThreadID) 
		{
			uint2 image_size = write_color.GetDimensions();

			uint2 px = uint2(0, 0);
			float2 uv = float2(0, 0);
			if(swizzle_compute_workgroups_8x8(globalInvocationID.xy, localInvocationID.xy, image_size, uv, px))
				return;

			out_color[uint2(px.x, px.y)] = float4(BRDF(uv.x, 1.0f - uv.y), 0.0f, 1.0f);
		}
	""";
}