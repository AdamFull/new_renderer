{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_nonuniform_qualifier"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [ 
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_ARB_shader_viewport_layer_array" 
	];

	includes: [ "shader_inputs" ];

	code: 
	"""
		struct VSOutput
		{
			[[vk::location(0)]] float2 UV : TEXCOORD0;
			[[vk::location(1)]] uint32_t materialID : SV_Target0;
		};

		layout(location = 0) in vec2 inUV;
		layout(location = 1) flat in uint materialID;
		
		void main(VSOutput input) 
		{
			if(input.materialID != ~0u)
			{
				FMaterial mat = materialBuffer.Get().materials[materialID];
				if(mat.baseColorTexture != ~0u)
				{
					float sample_alpha = SAMPLE_TEXTURE2D_SLOT(mat.baseColorTexture, input.UV).a;
					if(sample_alpha < 1.f)
						discard;
				}
			}
		}
	""";
}