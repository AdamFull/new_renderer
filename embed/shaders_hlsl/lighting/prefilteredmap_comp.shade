{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack"
	];

	definitions: [];
	require_extensions: [];
	includes: ["lighting_model", "compute_common"];

	code: 
	"""
		[[vk::binding(1, 0)]] RWTexture2D<float4> out_color : register(u0);
		REGISTER_TEXTURE_SLOT(1, 1, TextureCube, SamplerState, sampler_color, 1)

		[[vk::binding(1, 2)]] cbuffer ComputeCubemapData : register(b2)
		{
			float roughness;
		} data;

		const uint32_t samples = 32u;

		float3 prefilterEnvMap(float3 R, float roughness) 
		{
			float3 N = R;
			float3 V = R;
			float3 colour = float3(0.0f);
			float totalWeight = 0.0f;
			float envMapDim = float(textureSize(envmap, 0).s);
		
			for (uint32_t i = 0u; i < samples; i++) 
		    {
				float2 Xi = hammersley2d(i, samples);
				float3 H = importanceSample_GGX(Xi, roughness, N);
				float3 L = 2.0f * dot(V, H) * H - V;
				float dotNL = clamp(dot(N, L), 0.0f, 1.0f);
		
				if (dotNL > 0.0f) 
		        {
					// Filtering based on https://placeholderart.wordpress.com/2015/07/28/implementation-notes-runtime-environment-map-filtering-for-image-based-lighting/
		
					float dotNH = clamp(dot(N, H), 0.0f, 1.0f);
					float dotVH = clamp(dot(V, H), 0.0f, 1.0f);
		
					// Probability Distribution Function
					float pdf = D_GGX(dotNH, roughness) * dotNH / (4.0f * dotVH) + 0.0001f;
					// Slid angle of current smple
					float omegaS = 1.0f / (float(samples) * pdf);
					// Solid angle of 1 pixel across all cube faces
					float omegaP = 4.0f * PI / (6.0f * envMapDim * envMapDim);
					// Biased (+1.0) mip level for better result
					float mipLevel = roughness == 0.0f ? 0.0f : max(0.5f * log2(omegaS / omegaP) + 1.0f, 0.0f);
					colour += SAMPLE_TEXTURE2D_LOD(sample_color, L, mipLevel).rgb * dotNL;
					totalWeight += dotNL;
		
				}
			}
		
			return (colour / totalWeight);
		}
		
		[numthreads(8, 8, 1)]
		void main(uint3 globalInvocationID : SV_DispatchThreadID, uint3 localInvocationID : SV_GroupThreadID) 
		{
			uint2 image_size = imageSize(out_color);

			uint2 px = uint2(0, 0);
			float2 uv = float2(0, 0);
			if(swizzle_compute_workgroups_8x8(globalInvocationID.xy, localInvocationID.xy, image_size, uv, px))
				return;
		
			for (uint32_t i = 0; i != 6; ++i) 
		    {
				float3 R = normalize(cubeDir(uv, i));
				out_color[uint3(px.x, px.y, i)] = vec4(prefilterEnvMap(R, data.roughness), 1.0f);
			}
		}
	""";
}