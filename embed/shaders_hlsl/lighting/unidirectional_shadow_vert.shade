{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA", "SHADOW_DATA"];

	require_extensions: [ 
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_ARB_shader_viewport_layer_array" 
	];
	includes: [ "shader_inputs" ];

	code: 
	"""
		struct VSOutput
		{
		    float4 Pos : SV_POSITION;
		    uint Layer : SV_RenderTargetArrayIndex;
			[[vk::location(0)]] float2 UV : TEXCOORD0;
			[[vk::location(1)]] uint32_t materialID : SV_Target0;
		};

		layout(location = 0) out vec2 outTexcoord;
		layout(location = 1) flat out uint materialID;
		
		struct FShadowmapData
		{
			uint32_t callID;
			uint32_t shadowIndex;
			int32_t layer;
		};

		[[vk::push_constant]] FShadowmapData shadowData;
		
		VSOutput main(VSInput input, in uint instanceID : SV_InstanceID)
		{
			VSOutput output;

			uint32_t draw_index = shadowData.callID + gl_DrawIDARB + gl_InstanceIndex;
			FDrawMeshinfo draw_info = drawInfoBuffer.infos[draw_index];

			FSceneNode node = nodeBuffer.nodes[draw_info.nodeID];
			mat4 modelMatrix = node.model;

#ifdef HAS_SKIN
			if(node.skeletonID != ~0u)
			{
#if defined(JOINTS_8BIT)
				u8vec4 joints = u8vec4(uint8_t(input.Joints.x * 255.0), uint8_t(input.Joints.y * 255.0), uint8_t(input.Joints.z * 255.0), uint8_t(input.Joints.w * 255.0));
#elif defined(JOINTS_16BIT)
				u16vec4 joints = u16vec4(uint16_t(input.Joints.x * 65535.0), uint16_t(input.Joints.y * 65535.0), uint16_t(input.Joints.z * 65535.0), uint16_t(input.Joints.w * 65535.0));
#endif
				mat4 skinMat = 
					input.Weights.x * jointsBuffer.Get().matrices[node.skeletonID + joints.x] +
					input.Weights.y * jointsBuffer.Get().matrices[node.skeletonID + joints.y] +
					input.Weights.z * jointsBuffer.Get().matrices[node.skeletonID + joints.z] +
					input.Weights.w * jointsBuffer.Get().matrices[node.skeletonID + joints.w];
					
				modelMatrix = modelMatrix * skinMat;
			}
#endif // HAS_SKIN
		
			vec4 localPos = modelMatrix * vec4(input.Pos, 1.0);
			localPos = vec4(localPos.xyz / localPos.w, 1.0);

#ifdef HAS_TEXCOORD
			output.UV = input.UV;
#endif

			mat4 viewProj;
#if defined(CASCADED_SHADOW)
			FCascadedShadowCommit shadow = cascadedShadowBuffer.Get().shadows[shadowData.shadowIndex];
			viewProj = shadow.cascadeViewProj[shadowData.layer];
#else
			FSpotShadowCommit shadow = spotShadowBuffer.Get().shadows[shadowData.shadowIndex];
			viewProj = shadow.viewProj;
#endif

			materialID = ~0u;

			FMesh mesh = meshBuffer.Get().meshes[draw_info.meshID];
			if(mesh.materialID != ~0u)
			{
				materialID = mesh.materialID;
			}

			output.Layer = shadowData.layer;
			output.Pos = viewProj * localPos;

			return output;
		}
	""";
}