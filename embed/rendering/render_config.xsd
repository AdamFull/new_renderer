<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="RenderConfig">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="RenderVars">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Var" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="name" type="xs:string" use="required" />
                      <xs:attribute name="dtype" type="xs:string" use="required" />
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="VarBlock" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Var" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:string">
                            <xs:attribute name="name" type="xs:string" use="required" />
                            <xs:attribute name="dtype" type="xs:string" use="required" />
                            <xs:attribute name="type" type="xs:string" use="optional" />
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Val" type="xs:string" maxOccurs="unbounded" minOccurs="0"/>
                  </xs:sequence>
                  <xs:attribute name="name" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="RenderResources">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Image" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required" />
                  <xs:attribute name="file" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="Texture2D" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required" />
                  <xs:attribute name="size_2d" type="xs:string" use="optional" />
                  <xs:attribute name="scale" type="xs:string" use="optional" />
                  <xs:attribute name="format" type="xs:string" use="required" />
                  <xs:attribute name="usage" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="TextureCube" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required" />
                  <xs:attribute name="size_2d" type="xs:string" use="optional" />
                  <xs:attribute name="format" type="xs:string" use="required" />
                  <xs:attribute name="usage" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="Texture2DArray" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required" />
                  <xs:attribute name="size_2d" type="xs:string" use="optional" />
                  <xs:attribute name="layers" type="xs:string" use="required" />
                  <xs:attribute name="format" type="xs:string" use="required" />
                  <xs:attribute name="usage" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="Buffer" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required" />
                  <xs:attribute name="size" type="xs:string" use="required" />
                  <xs:attribute name="count" type="xs:string" use="optional" />
                  <xs:attribute name="type" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="Backbuffer" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="If" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Texture2D" maxOccurs="1">
                      <xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required" />
                        <xs:attribute name="format" type="xs:string" use="required" />
                        <xs:attribute name="usage" type="xs:string" use="required" />
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="cond" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="Else" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Texture2D" maxOccurs="1">
                      <xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required" />
                        <xs:attribute name="format" type="xs:string" use="required" />
                        <xs:attribute name="usage" type="xs:string" use="required" />
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="RenderGraph">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Node" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Out" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:attribute name="slot" type="xs:string" use="optional" />
                        <xs:attribute name="target" type="xs:string" use="required" />
                        <xs:attribute name="clear" type="xs:string" use="optional" />
                        <xs:attribute name="mip" type="xs:string" use="optional" />
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="In" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:attribute name="slot" type="xs:string" use="optional" />
                        <xs:attribute name="target" type="xs:string" use="required" />
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Depth" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:attribute name="target" type="xs:string" use="required" />
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Stencil" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:attribute name="target" type="xs:string" use="required" />
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Pass" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Node" maxOccurs="unbounded" minOccurs="0" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Group" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Node" maxOccurs="unbounded" minOccurs="0" />
                          <xs:element name="Group" maxOccurs="unbounded" minOccurs="0" />
                        </xs:sequence>
                        <xs:attribute name="debug_scope" type="xs:string" use="optional" />
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Exchange" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:attribute name="in" type="xs:string" use="required" />
                        <xs:attribute name="out" type="xs:string" use="required" />
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="For" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Node" maxOccurs="unbounded" minOccurs="0" />
                        </xs:sequence>
                        <xs:attribute name="var" type="xs:string" use="required" />
                        <xs:attribute name="from" type="xs:string" use="required" />
                        <xs:attribute name="to" type="xs:string" use="required" />
                        <xs:attribute name="step" type="xs:string" use="optional" />
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="If" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Node" maxOccurs="unbounded" minOccurs="0" />
                          <xs:element name="Pass" maxOccurs="unbounded" minOccurs="0" />
                        </xs:sequence>
                        <xs:attribute name="cond" type="xs:string" use="required" />
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Else" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Node" maxOccurs="unbounded" minOccurs="0" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="name" type="xs:string" use="required" />
                  <xs:attribute name="type" type="xs:string" use="required" />
                  <xs:attribute name="pass_type" type="xs:string" use="optional" />
                  <xs:attribute name="shader" type="xs:string" use="optional" />
                  <xs:attribute name="threads_by" type="xs:string" use="optional" />
                  <xs:attribute name="threads_x" type="xs:string" use="optional" />
                  <xs:attribute name="threads_y" type="xs:string" use="optional" />
                  <xs:attribute name="threads_z" type="xs:string" use="optional" />
                  <xs:attribute name="flags" type="xs:string" use="optional" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
