<RenderConfig>
    <!-- Render Variables Section -->
    <RenderVars>
        <!-- Individual Variables -->
        <Var name="low_precision_velocity" dtype="bool">true</Var>

        <Var name="max_sun_count" dtype="u32">3</Var>
        <Var name="max_sun_cast_shadow_count" dtype="u32">3</Var>
        <Var name="cascade_shadow_resolution" dtype="u32">2048</Var>
        <Var name="cascade_count" dtype="u32">4</Var>

        <Var name="max_spot_count" dtype="u32">64</Var>
        <Var name="max_spot_shadow_count" dtype="u32">16</Var>
        <Var name="spot_shadow_resolution" dtype="u32">1024</Var>

        <Var name="max_point_count" dtype="u32">64</Var>
        <Var name="max_point_shadow_count" dtype="u32">8</Var>
        <Var name="point_shadow_resolution" dtype="u32">512</Var>

        <VarBlock name="post_process">
            <VarBlock name="fxaa">
                <Var name="enable" dtype="bool">false</Var>
                <Var name="quality" type="list" dtype="f32">
                    <Val>1.0</Val> <Val>0.75</Val> <Val>0.5</Val> <Val>0.25</Val> <Val>0.0</Val>
                </Var>
                <Var name="threshold" type="list" dtype="f32">
                    <Val>0.333</Val> <Val>0.250</Val> <Val>0.166</Val> <Val>0.125</Val> <Val>0.063</Val>
                </Var>
                <Var name="threshold_min" type="list" dtype="f32">
                    <Val>0.0833</Val> <Val>0.0625</Val> <Val>0.0312</Val>
                </Var>
            </VarBlock>

            <VarBlock name="dof">
                <Var name="enable" dtype="bool">false</Var>
                <Var name="blur_scale" dtype="f32">1.0</Var>
                <Var name="blur_strength" dtype="f32">1.0</Var>
                <Var name="bokeh_samples" dtype="i32">5</Var>
                <Var name="bokeh_poly" dtype="f32">8.0</Var>
                <Var name="focus_point" dtype="f32">8.24</Var>
                <Var name="near_field" dtype="f32">0.3</Var>
                <Var name="near_transition" dtype="f32">0.125</Var>
                <Var name="far_field" dtype="f32">8.0</Var>
                <Var name="far_transition" dtype="f32">3.0</Var>
            </VarBlock>

            <VarBlock name="bloom">
                <Var name="enable" dtype="bool">false</Var>
                <Var name="threshold" dtype="f32">1.0</Var>
                <Var name="filter_radius" dtype="f32">0.005</Var>
                <Var name="strength" dtype="f32">0.3</Var>
                <Var name="layer_count" dtype="i32" flags="invisible">7</Var>
                <Var name="use_brightness" dtype="bool" flags="invisible">true</Var>
            </VarBlock>

            <VarBlock name="chromatic_aberration">
                <Var name="enable" dtype="bool">false</Var>
                <Var name="distortion" dtype="f32">2.2</Var>
                <Var name="iterations" dtype="i32">12</Var>
            </VarBlock>

            <VarBlock name="vignette">
                <Var name="enable" dtype="bool">false</Var>
                <Var name="inner" dtype="f32">0.15</Var>
                <Var name="outer" dtype="f32">1.35</Var>
                <Var name="opacity" dtype="f32">0.85</Var>
            </VarBlock>

            <VarBlock name="tonemap">
                <Var name="enable" dtype="bool">false</Var>
                <Var name="adaptive" dtype="bool">true</Var>
                <Var name="gamma" dtype="f32">2.2</Var>
                <Var name="exposure" dtype="f32">4.5</Var>
                <Var name="whitePoint" dtype="f32">4.0</Var>
                <Var name="lumMin" dtype="f32">-5.0</Var>
                <Var name="lumMax" dtype="f32">3.0</Var>
                <Var name="tau" dtype="f32">1.1</Var>
            </VarBlock>

            <VarBlock name="film_grain">
                <Var name="enable" dtype="bool">false</Var>
                <Var name="amount" dtype="f32">0.01</Var>
            </VarBlock>

            <VarBlock name="motion_blur">
                <Var name="enable" dtype="bool">false</Var>
                <Var name="low_precision" dtype="bool">true</Var>
                <Var name="scele" dtype="f32">1.0</Var>
                <Var name="max_samples" dtype="i32">16</Var>
                <Var name="max_velocity" dtype="f32">30.0</Var>
                <Var name="threshold" dtype="f32">0.0001</Var>
            </VarBlock>
        </VarBlock>
    </RenderVars>

    <!-- Render Resources Section -->
    <RenderResources>
        <!-- Load Default Images -->
        <TextureCube name="CasualDay4K" file="/root/embed/rendering/textures/CasualDay4K.ktx2"/>
        <Texture2D name="LensDirtMask" file="/root/embed/rendering/textures/DirtMaskTextureExample.png"/>

        <!-- Other Targets -->
        <!-- Image size can be set by width/height, size_2d, scale-->
        <Texture2D name="brdf_lut_target" size_2d="1024" format="rg16_sfloat" usage="sample|storage" />
        <TextureCube name="irradiance_cube_target" size_2d="64" format="rgba32_sfloat" usage="sample|storage" />
        <TextureCube name="prefiltered_cube_target" size_2d="512" format="rgba16_sfloat" usage="sample|storage" />

        <!-- Shadow Targets -->
        <Texture2DArray name="cascaded_shadows_target" size_2d="{cascade_shadow_resolution}" layers="{max_sun_cast_shadow_count * cascade_count}" format="d32_sfloat" usage="sample" />
        <Texture2DArray name="directional_shadows_target" size_2d="{spot_shadow_resolution}" layers="{max_spot_shadow_count}" format="d16_unorm" usage="sample" />
        <Texture2DArray name="omni_shadows_target" size_2d="{point_shadow_resolution}" layers="{max_point_shadow_count}" format="d16_unorm" usage="sample" />

        <!-- Visibility Buffer Targets -->
        <Texture2D name="visbuffer_geometry_target" format="rgba8_unorm" usage="sample" />
        <Texture2D name="visbuffer_vboinst_target" format="rgba8_unorm" usage="sample" />
        <Texture2D name="zbuffer_depth_target" format="d32_sfloat" usage="sample" />

        <If cond="{use_low_precision_velocity}">
            <Texture2D name="motion_vectors_target" format="rg8_unorm" usage="sample|storage" />
        </If>
        <Else>
            <Texture2D name="motion_vectors_target" format="rg16_sfloat" usage="sample|storage" />
        </Else>

        <!-- hdr Targets -->
        <Texture2D name="hdr0" format="r11g11b10_ufloat" usage="sample|storage" />
        <Texture2D name="hdr0_div2" scale="0.5" format="r11g11b10_ufloat" usage="sample|storage" />
        <Texture2D name="hdr1" format="r11g11b10_ufloat" usage="sample|storage" />
        <Texture2D name="hdr0_history" format="r11g11b10_ufloat" usage="sample|storage" />
        <Texture2D name="bokeh_target" scale="0.5" format="r11g11b10_ufloat" usage="sample|storage" />
        <Texture2D name="bloom_chain" scale="0.5" mip_levels="{post_process:bloom:layer_count}" format="r11g11b10_ufloat" usage="sample|storage" />

        <!-- Eye Adaptation Targets -->
        <Texture2D name="avg_brightness_target" size_2d="1" format="r32_sfloat" usage="sample|storage" />
        <Buffer name="histogram_buffer" size="4" count="256" type="storage" />

        <Backbuffer name="present_target" />
    </RenderResources>

    <!-- Render Nodes Section -->
    <RenderNodes>
        <!-- generate brdf lut -->
        <Node name="generate_brdflut" type="compute" pass_type="default" shader="lighting:brgflut_generator" threads_by="brdf_lut_target" flags="one_time|divide_by_locals">
            <Out slot="out_color" target="brdf_lut_target"/>
        </Node>

        <!-- Workgroups can be set by target or manual. threads_by and threads_x, threads_y, threads_z-->
        <Node name="generate_irradiance_cube" type="compute" pass_type="default" shader="lighting:irradiancecube_generator" threads_by="irradiance_cube_target" flags="one_time|divide_by_locals">
            <Out slot="out_color" target="irradiance_cube_target"/>
            <In slot="sampler_color" target="CasualDay4K"/>
        </Node>

        <Node name="generate_prefiltered_cube" type="compute" pass_type="cubemap" shader="lighting:prefilteredmap_generator" threads_by="prefiltered_cube_target" flags="one_time|divide_by_locals">
            <Out slot="out_color" target="prefiltered_cube_target"/>
            <In slot="sampler_color" target="CasualDay4K"/>
        </Node>

        <!-- Culling -->
        <Node name="clear_counters_pass" type="compute" pass_type="default" shader="culling:clear_counters" threads_by="IndirectCountBuffer" flags="divide_by_locals">
            <Out target="IndirectCountBuffer"/>
        </Node>

        <Node name="gpu_culling_pass" type="compute" pass_type="culling" shader="culling:cull_and_batch">
            <Out target="GeometryBatches"/>
            <Out target="IndexedDrawIndirectBuffer"/>
            <Out target="IndirectCountBuffer"/>
        </Node>

        <!-- Shadow Passes -->
        <Node name="cascaded_shadow_map_pass" type="graphics" pass_type="csm" shader="lighting:unidirectional_shadow:CASCADED_SHADOW">
            <Depth target="cascaded_shadows_target"/>
            <In target="GeometryBatches"/>
            <In target="IndexedDrawIndirectBuffer"/>
            <In target="IndirectCountBuffer"/>
        </Node>

        <Node name="spot_shadow_map_pass" type="graphics" pass_type="dsm" shader="lighting:unidirectional_shadow">
            <Depth target="directional_shadows_target"/>
            <In target="GeometryBatches"/>
            <In target="IndexedDrawIndirectBuffer"/>
            <In target="IndirectCountBuffer"/>
        </Node>

        <Node name="omni_shadow_map_pass" type="graphics" pass_type="osm" shader="lighting:unidirectional_shadow:OMNI_SHADOW">
            <Depth target="omni_shadows_target"/>
            <In target="GeometryBatches"/>
            <In target="IndexedDrawIndirectBuffer"/>
            <In target="IndirectCountBuffer"/>
        </Node>

        <!-- Visibility Buffer Write -->
        <Node name="visibility_buffer_write_pass" type="graphics" pass_type="geometry" shader="visibilitybuffer:write">
            <Depth target="zbuffer_depth_target"/>

            <Out target="visbuffer_geometry_target" clear="zeros"/>
            <Out target="visbuffer_vboinst_target" clear="zeros"/>

            <In target="GeometryBatches"/>
            <In target="IndexedDrawIndirectBuffer"/>
            <In target="IndirectCountBuffer"/>
        </Node>

    </RenderNodes>
</RenderConfig>