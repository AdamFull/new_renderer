{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: [];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["shader_inputs", "util"];

	code: 
	"""
		struct VS_INPUT { [[vk::location(0)]] float2 inUV : TEXCOORD0; };
		struct PS_OUTPUT { [[vk::location(0)]] float4 color : SV_Target; };

		REGISTER_TEXTURE_SLOT(1, 0, Texture2D<float4>, SamplerState, input_image);

		PS_OUTPUT main(VS_INPUT input) 
		{
			PS_OUTPUT output;

			output.color = texture(input_image, input);

			//if(postprocess.enable_film_grain > 0)
			//{
			//	float randomIntensity = frac(10000 * sin((gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * frameData.dt) * 3.14));
			//	output.color.rgb += postprocess.fg_amount * randomIntensity;
			//}

			if(postprocess.enable_vignette > 0)
			{
				float3 fragcolor = color.rgb;
				fragcolor *= 1.0f - smoothstep(postprocess.v_inner_radius, postprocess.v_outer_radius, length(inUV - 0.5f));
				output.color.rgb = lerp(color.rgb, fragcolor, postprocess.v_opacity);
			}

			// https://www.shadertoy.com/view/dlcfRX
			//color.rgb = float3x3(.842, .0423, .0424, .0784, .878, .0784, .0792, .0792, .879) * color.rgb;
			//color.rgb = clamp((log2(color.rgb) + 12.47393) / 16.5, float3(0), float3(1));
			//color.rgb = .5 + .5 * sin(((-3.11 * color.rgb + 6.42) * color.rgb - .378) * color.rgb - 1.44);
			//color.rgb = float3x3(1.2, -.053, -.053, -.1, 1.15, -.1, -.1, -.1, 1.15) * color.rgb;

			return output;
		}
	""";
}