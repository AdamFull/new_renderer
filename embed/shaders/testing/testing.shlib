{
	name: "testing";

	shaders: [
		{
			name: "screenspace";
			sources: [
				{
					type: "vertex";
					common: true;
					shader_name: "screenspace_vert";
				},
				{
					type: "fragment";
					shader_name: "screenspace_frag";
				}
			];
		},
		{
			name: "visbufferwrite";
			sources: [
				{
					type: "vertex";
					shader_name: "visbufferwrite_vert";
				},
				{
					type: "fragment";
					shader_name: "visbufferwrite_frag";
				}
			];
		}
	];

	compile: [
		{ 
			shader_name: "screenspace";
			permutations: [
				{ definitions: [] },
				{ definitions: ["EDITOR_MODE"] }
			];
		},
		{ 
			shader_name: "visbufferwrite";
			permutation_generator: {
				definitions: [
					"HAS_COLOR",
					"HAS_TEXCOORD",
					"HAS_NORMAL",
					"HAS_TANGENT",
					"HAS_SKIN"
				];
			};
		}
	];
}