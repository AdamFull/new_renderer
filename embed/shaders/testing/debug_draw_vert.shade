{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: [];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["shader_inputs"];

	code: 
	"""
		layout (location = 0) in vec2 inPos;
		layout (location = 1) in vec4 inColor;
		layout (location = 2) in vec2 inUV;
		
		layout (location = 0) out vec2 outUV;
		layout (location = 1) out vec4 outColor;

		layout (push_constant) uniform PushConstants 
		{
			vec2 scale;
			vec2 translate;
		} constants;
		
		out gl_PerVertex 
		{
			vec4 gl_Position;   
		};
		
		void main() 
		{
			FCamera camera = GetCamera(frameData.defaultCameraID);
			mat4 projection = getProjectionMatrix(camera.matricesOffset);
			mat4 view = getViewMatrix(camera.matricesOffset);
			//projection[1][1] *= -1.f;

			outUV = inUV;
			outColor = inColor;
			//gl_Position = projection * view * vec4(inPos, 1.0);
			gl_Position = vec4(inPos.xy * constants.scale + constants.translate, 0.0, 1.0);
		}
	""";
}