{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters"
	];

	definitions: [];

	require_extensions: [];
	includes: [];

	code: 
	"""
		layout(std140, binding = 0) uniform GlobalUniformFrameData
		{
			mat4 view;
			mat4 invView;
			mat4 projection;
			mat4 invProjection;
			mat4 viewProjection;
			mat4 invViewProjection;
			vec3 viewDirection;
			vec2 viewportDimension;
			vec4 frustumPlanes[6];
		} frameData;

		layout(std140, set = 1, binding = 0) uniform UniformMeshData
		{
			mat4 model;
			mat4 normal;
			vec4 object_id;
		} meshData;

		layout(location = 0) in vec3 inPosition;
		layout(location = 2) in vec2 inTexCoord;
		layout(location = 3) in vec3 inNormal;
		layout(location = 4) in vec4 inTangent;

		layout(location = 0) flat out uint drawID;
		layout(location = 1) out vec2 uv;
		out gl_PerVertex
		{
			vec4 gl_Position;
		};

		void main() 
		{
			drawID = gl_DrawIDARB;
			uv = inTexCoord;
			gl_Position = frameData.projection * frameData.view * meshData.model * vec4(inPosition, 1.f);
		}
	""";
}