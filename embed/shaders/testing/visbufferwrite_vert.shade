{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier"
	];

	definitions: ["VERTEX_SHADER", "MESH_DATA"];

	require_extensions: [];
	includes: ["shader_inputs"];

	code: 
	"""
		layout(location = 0) flat out uint drawID;
#ifdef HAS_TEXCOORD
		layout(location = 1) out vec2 uv;
#endif
		out gl_PerVertex
		{
			vec4 gl_Position;
		};

		void main() 
		{
			drawID = gl_DrawIDARB;
#ifdef HAS_TEXCOORD
			uv = inTexCoord;
#endif
			gl_Position = frameData.projection * frameData.view * meshData.model * vec4(inPosition, 1.f);
		}
	""";
}