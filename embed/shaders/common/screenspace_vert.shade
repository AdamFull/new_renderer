{
	version: 460;

	enable_extensions: [];

	definitions: [];
	require_extensions: [];
	includes: [];

	code: 
	"""
		struct VSOutput
		{
		    float2 outUV : TEXCOORD0;
		    float4 position : SV_Position;
		};
		
		VSOutput main(uint id : SV_VertexID)
		{
		    VSOutput output;
		
		    output.outUV = float2((id << 1) & 2, id & 2);
		    output.position = float4(output.outUV * 2.0f - 1.0f, 0.0f, 1.0f);
		
		    return output;
		}
	""";
}