{
	includes: [];

	code: 
	"""
	// Vertex inputs
#ifdef VERTEX_SHADER
		layout(location = 0) in vec3 inPosition;
#ifdef HAS_COLOR
		layout(location = 1) in vec3 inColor;
#endif // HAS_COLOR
#ifdef HAS_TEXCOORD
		layout(location = 2) in vec2 inTexCoord;
#endif // HAS_TEXCOORD
#ifdef HAS_NORMAL
		layout(location = 3) in vec3 inNormal;
#endif // HAS_NORMAL
#ifdef HAS_TANGENT
		layout(location = 4) in vec4 inTangent;
#endif // HAS_TANGENT
#ifdef HAS_SKIN
			layout(location = 5) in vec4 inJoints;
			layout(location = 6) in vec4 inWeights;
#endif // HAS_SKIN
#endif // VERTEX_SHADER

		// Global descriptors
		layout(std140, set = 0, binding = 0) uniform GlobalUniformFrameData
		{
			mat4 view;
			mat4 invView;
			mat4 projection;
			mat4 invProjection;
			mat4 viewProjection;
			mat4 invViewProjection;
			vec3 viewDirection;
			vec2 viewportDimension;
			vec4 frustumPlanes[6];
		} frameData;

		layout(set = 0, binding = 1) uniform sampler2D textures[];

#ifdef MESH_DATA
		layout(std140, set = 1, binding = 0) uniform UniformMeshData
		{
			mat4 model;
			mat4 normal;
			vec4 object_id;
		} meshData;
		
#ifdef HAS_SKIN
		layout(std140, set = 0, binding = 2) uniform FSkinning
		{
			mat4 jointMatrices[128];
		};
#endif // HAS_SKIN
#endif // MESH_DATA

		struct Vertex
		{
			vec3 pos;
#ifdef HAS_COLOR
			vec3 color;
#endif // HAS_COLOR
#ifdef HAS_TEXCOORD
		vec2 uv;
#endif // HAS_TEXCOORD
#ifdef HAS_NORMAL
		vec3 normal;
#endif // HAS_NORMAL
#ifdef HAS_TANGENT
		vec4 tangent;
#endif // HAS_TANGENT
#ifdef HAS_SKIN
			vec4 joints;
			vec4 weights;
#endif // HAS_SKIN
		};
		
		//layout(std140, set = 0, binding = 3) uniform UBOMaterial
		//{
		//	vec4 baseColorFactor;
		//	vec3 emissiveFactor;
		//	float emissiveStrength;
