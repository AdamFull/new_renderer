{
	includes: ["interop/base"];

	code: 
	"""
	#define REGISTER_TEXTURE_SLOT(SetIndex, BindingIndex, TextureType, SamplerType, TextureName, RegisterIndex) \
	[[vk::combinedImageSampler]][[vk::binding(SetIndex, BindingIndex)]] TextureType TextureName : register(t##RegisterIndex); \
	[[vk::combinedImageSampler]][[vk::binding(SetIndex, BindingIndex)]] SamplerType TextureName##_sampler : register(s##RegisterIndex);

	#define REGISTER_UAV_SLOT(SetIndex, BindingIndex, TextureType, TextureName, RegisterIndex) \
	[[vk::binding(SetIndex, BindingIndex)]] TextureType TextureName : register(u##RegisterIndex);

	// Vertex inputs
#ifdef VERTEX_SHADER
	struct VSMeshInput
	{
		[[vk::location(0)]] float4 Pos : POSITION0;

#if defined(COLOR_VEC3)
		[[vk::location(1)]] float3 Color : COLOR0;
#elif defined(COLOR_VEC4)
		[[vk::location(1)]] float3 Color : COLOR0;
#endif // HAS_COLOR
		
#ifdef HAS_TEXCOORD
		[[vk::location(2)]] float2 UV : TEXCOORD0;
#endif // HAS_TEXCOORD
		
#ifdef HAS_NORMAL
		[[vk::location(3)]] float3 Normal : NORMAL0;
#endif // HAS_NORMAL
		
#if defined(TANGENT_VEC3)
		[[vk::location(4)]] float3 Tangent : TANGENT0;
#elif defined(TANGENT_VEC4)
		[[vk::location(4)]] float4 Tangent : TANGENT0;
#endif // HAS_TANGENT

#ifdef HAS_SKIN
		[[vk::location(5)]] uint4 Joints : BLENDINDICES0;
		[[vk::location(6)]] float4 Weights : BLENDWEIGHT0;
#endif // HAS_SKIN
	};
#endif // VERTEX_SHADER

	// Bindless texture
	[[vk::combinedImageSampler]][[vk::binding(0, 3)]] Texture2D globalTextures[] : register(t0);
	[[vk::combinedImageSampler]][[vk::binding(0, 3)]] SamplerState globalTextures_sampler[] : register(s0);

	#define GET_GLOB_TEXTURE_2D(texture_index) globalTextures[NonUniformResourceIndex(textureRemapBuffer.Get().remap[texture_index])]
	#define GET_GLOB_SAMPLER_2D(texture_index) globalTextures_sampler[NonUniformResourceIndex(textureRemapBuffer.Get().remap[texture_index])]

	float4 GlobSample2D(uint texture_index, float2 texcoord, uint2 offset = 0) { return GET_GLOB_TEXTURE_2D(texture_index).Sample(GET_GLOB_SAMPLER_2D(texture_index), texcoord, offset); }
	float4 GlobSampleLod2D(uint texture_index, float2 texcoord, float level, uint2 offset = 0) { return GET_GLOB_TEXTURE_2D(texture_index).SampleLevel(GET_GLOB_SAMPLER_2D(texture_index), texcoord, level, offset); }
	float4 GlobSampleGrad2D(uint texture_index, float2 texcoord, float2 ddx, float2 ddy, uint2 offset = 0) { return GET_GLOB_TEXTURE_2D(texture_index).SampleGrad(GET_GLOB_SAMPLER_2D(texture_index), texcoord, ddx, ddy, offset); }

	#define TEX2D(TextureName, texcoord) TextureName.Sample(TextureName##_sampler, texcoord)
	#define TEX2DOFFSET(TextureName, texcoord, offset) TextureName.Sample(TextureName##_sampler, texcoord, offset)
	#define TEX2DLOD(TextureName, texcoord, level) TextureName.SampleLevel(TextureName##_sampler, texcoord, level)
	#define TEX2DLODOFFSET(TextureName, texcoord, level, offset) TextureName.SampleLevel(TextureName##_sampler, texcoord, level, offset)
	#define TEX2DGRAD(TextureName, texcoord, ddx, ddy) TextureName.SampleGrad(TextureName##_sampler, texcoord, ddx, ddy)
	#define TEX2DGRADOFFSET(TextureName, texcoord, ddx, ddy, offset) TextureName.SampleGrad(TextureName##_sampler, texcoord, ddx, ddy, offset)

	// Base global object getters
	FSceneNode getSceneNode(in uint32_t index) { return nodeBuffer.get().nodes[NonUniformResourceIndex(index)]; }
	void setSceneNode(in uint32_t index, in FSceneNode node) { nodeBuffer.get().nodes[NonUniformResourceIndex(index)] = node; }

	// Matrix getters
	float4x4 getMatrixById(uint global_offset, uint local_offset) { return matrixBuffer.matrices[NonUniformResourceIndex(global_offset + local_offset)]; }
	void setMatrixById(uint global_offset, uint local_offset, in float4x4 matrix) { matrixBuffer.matrices[NonUniformResourceIndex(global_offset + local_offset)] = matrix; }

	float4x4 getModelMatrix(uint global_offset) { return getMatrixById(global_offset, model_matrix_offset); }
	float4x4 getOldModelMatrix(uint global_offset) { return getMatrixById(global_offset, old_model_matrix_offset); }
	float4x4 getViewMatrix(uint global_offset) { return getMatrixById(global_offset, view_matrix_offset); }
	float4x4 getInvViewMatrix(uint global_offset) { return getMatrixById(global_offset, inv_view_matrix_offset); }
	float4x4 getProjectionMatrix(uint global_offset) { return getMatrixById(global_offset, projection_matrix_offset); }
	float4x4 getInvProjectionMatrix(uint global_offset) { return getMatrixById(global_offset, inv_projection_matrix_offset); }
	float4x4 getViewProjectionMatrix(uint global_offset) { return getMatrixById(global_offset, view_projection_matrix_offset); }
	float4x4 getPrevViewProjectionMatrix(uint global_offset) { return getMatrixById(global_offset, prev_view_projection_matrix_offset); }
	float4x4 getInvViewProjectionMatrix(uint global_offset) { return getMatrixById(global_offset, inv_view_projection_matrix_offset); }
	float4x4 getReprojectionMatrix(uint global_offset) { return getMatrixById(global_offset, reprojection_matrix_offset); }

	FMesh getMesh(uint index) { return meshBuffer.Get().meshes[NonUniformResourceIndex(index)]; }
	void setMesh(uint index, in FMesh mesh) { meshBuffer.Get().meshes[NonUniformResourceIndex(index)] = mesh; }

	FMaterial getMaterial(uint index) { return materialBuffer.Get().materials[NonUniformResourceIndex(index)]; }
	void setMaterial(uint index, in FMaterial material) { return materialBuffer.Get().materials[NonUniformResourceIndex(index)] = material; }

	FLightCommit getLight(uint index) { return lightsBuffer.Get().lights[NonUniformResourceIndex(index)]; }
	void setLight(uint index, in FLightCommit light) { lightsBuffer.Get().lights[NonUniformResourceIndex(index)] = light; }
	
	// Shadow getters
	FCascadedShadowCommit getCascadedShadowCommit(uint index) { return cascadedShadowBuffer.Get().shadows[NonUniformResourceIndex(index)]; }
	void setCascadedShadowCommit(uint index, in FCascadedShadowCommit commit) { cascadedShadowBuffer.Get().shadows[NonUniformResourceIndex(index)] = commit; }

	FOmniShadowCommit getOmniShadowCommit(uint index) { return omniShadowBuffer.Get().shadows[NonUniformResourceIndex(index)]; }
	void setOmniShadowCommit(uint index, in FOmniShadowCommit commit) { omniShadowBuffer.Get().shadows[NonUniformResourceIndex(index)] = commit; }

	FSpotShadowCommit getSpotShadowCommit(uint index) { return spotShadowBuffer.Get().shadows[NonUniformResourceIndex(index)]; }
	void setSpotShadowCommit(uint index, in FSpotShadowCommit commit) { spotShadowBuffer.Get().shadows[NonUniformResourceIndex(index)] = commit; }

	FGeometryBatch getDrawInfo(uint index) { return drawInfoBuffer.Get().infos[NonUniformResourceIndex(index)]; }
	void setDrawInfo(uint index, in FGeometryBatch batch) { drawInfoBuffer.Get().infos[NonUniformResourceIndex(index)] = batch; }

	FGeometryBatch getRawDrawInfo(uint index) { return rawDrawInfoBuffer.Get().infos[NonUniformResourceIndex(index)]; }
	void setRawDrawInfo(uint index, in FGeometryBatch batch) { rawDrawInfoBuffer.Get().infos[NonUniformResourceIndex(index)] = batch; }

	float4 getFrustumSides(uint index) { return frustumSidesBuffer.Get().sides[NonUniformResourceIndex(index)]; }
	void setFrustumSides(uint index, in float4 side) { frustumSidesBuffer.Get().sides[NonUniformResourceIndex(index)] = side; }

	FDrawIndexedIndirectData getDrawIndexedIndirectData(uint index) { return indirectCommandBuffer.Get().commands[NonUniformResourceIndex(index)]; }
	void setDrawIndexedIndirectData(uint index, in FDrawIndexedIndirectData indirect_data) { indirectCommandBuffer.Get().commands[NonUniformResourceIndex(index)] = indirect_data; }

	uint32_t getIndirectCount(uint index) { return indirectCountBuffer.Get().indices[NonUniformResourceIndex(index)]; }
	void setIndirectCount(uint index, in uint32_t value) { indirectCountBuffer.Get().indices[NonUniformResourceIndex(index)] = value; }
	uint32_t IncrementIndirectCount(uint index) { uint32_t output; InterlockedAdd(indirectCountBuffer.Get().indices[NonUniformResourceIndex(index)], 1, output); return output; }

	uint32_t getTextureRemapIndex(uint index) { return textureRemapBuffer.Get().remap[NonUniformResourceIndex(index)]; } 
	void setTextureRemapIndex(uint index, in uint32_t value) { textureRemapBuffer.Get().remap[NonUniformResourceIndex(index)] = value; } 
	
	FCamera getCamera(uint index) { return cameraBuffer.Get().cameras[NonUniformResourceIndex(index)]; }
	void setCamera(uint index, in FCamera camera) { cameraBuffer.Get().cameras[NonUniformResourceIndex(index)] = camera; }
	""";
}