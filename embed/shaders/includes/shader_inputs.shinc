{
	includes: ["interop/base"];

	code: 
	"""
	// Vertex inputs
#ifdef VERTEX_SHADER
		layout(location = 0) in vec3 inPosition;
#if defined(COLOR_VEC3)
		layout(location = 1) in vec3 inColor;
#elif defined(COLOR_VEC4)
		layout(location = 1) in vec4 inColor;
#endif // HAS_COLOR
#ifdef HAS_TEXCOORD
		layout(location = 2) in vec2 inTexCoord;
#endif // HAS_TEXCOORD
#ifdef HAS_NORMAL
		layout(location = 3) in vec3 inNormal;
#endif // HAS_NORMAL
#if defined(TANGENT_VEC3)
		layout(location = 4) in vec3 inTangent;
#elif defined(TANGENT_VEC4)
		layout(location = 4) in vec4 inTangent;
#endif // HAS_TANGENT
#ifdef HAS_SKIN
		layout(location = 5) in vec4 inJoints;
		layout(location = 6) in vec4 inWeights;
#endif // HAS_SKIN
#endif // VERTEX_SHADER

	// Global descriptors
	layout(std140, set = 0, binding = 0) uniform GlobalUniformFrameData
	{
		FGlobalUniformData frameData;
	};

	// Bindless texture
	layout(set = 0, binding = 1) uniform sampler2D globalTextures[];

#ifdef MESH_DATA
	layout(std430, set = 0, binding = 2) readonly buffer NodeStorage
	{
		FSceneNode nodes[];
	} sbn[];	

	layout(std430, set = 0, binding = 2) readonly buffer MaterialStorage
	{
		FMaterial materials[];
	} mbn[];	

#ifdef HAS_SKIN
	layout(std430, set = 0, binding = 2) readonly buffer SkinningJoints
	{
		mat4 matrices[];
	} jbn[];
#endif // HAS_SKIN

	layout(std430, set = 0, binding = 2) buffer GeometryBatches
	{
		FGeometryGPUBatch geometry_batches[];
	} gbn[];

	layout(std430, set = 0, binding = 2) buffer IndirectIndexedComands
	{
		FDrawIndexedIndirectData indexed_draw_commands[];
	} cbn[];
#endif // MESH_DATA

#ifdef LIGHT_DATA
	layout(std430, set = 0, binding = 2) readonly buffer DirectionalLights
	{
		FDirectionalLightCommit directional_lights[];
	} dlbn[];

	layout(std430, set = 0, binding = 2) readonly buffer PointLights
	{
		FPointLightCommit point_lights[];
	} plbn[];

	layout(std430, set = 0, binding = 2) readonly buffer SpotLights
	{
		FSpotLightCommit spot_lights[];
	} slbn[];
#endif // LIGHT_DATA

#ifdef SHADOW_DATA
	layout(std430, set = 0, binding = 2) readonly buffer CascadedShadows
	{
		FCascadedShadowCommit cascaded_shadows[];
	} csbn[];

	layout(std430, set = 0, binding = 2) readonly buffer OmniShadows
	{
		FOmniShadowCommit omni_shadows[];
	} osbn[];

	layout(std430, set = 0, binding = 2) readonly buffer SpotShadows
	{
		FSpotShadowCommit spot_shadows[];
	} ssbn[];
#endif // SHADOW_DATA

#ifdef CULLING_DATA
	layout(std430, set = 0, binding = 2) readonly buffer CullingInfo
	{
		FGeometryGPUCullInfo culling_infos[];
	} cibn[];

	layout(std430, set = 0, binding = 2) readonly buffer SceneFrustum
	{
		vec4 scene_frustums[];
	} sfbn[];
#endif

#if defined(INDEX_8BIT)
	#define Index uint8_t
#elif defined(INDEX_16BIT)
	#define Index uint16_t
#else
	#define Index uint
#endif

struct RawVertex
{
	float px;
	float py;
	float pz;

#if defined(COLOR_VEC3) || defined(COLOR_VEC4)
	float cr;
	float cg;
	float cb;
#endif // COLOR_VEC3
#if defined(COLOR_VEC4)
	float ca;
#endif // COLOR_VEC4

#ifdef HAS_TEXCOORD
	float u;
	float v;
#endif // HAS_TEXCOORD

#ifdef HAS_NORMAL
	float nx;
	float ny;
	float nz;
#endif // HAS_NORMAL

#if defined(TANGENT_VEC3) || defined(TANGENT_VEC4)
	float tx;
	float ty;
	float tz;
#endif // TANGENT_VEC3
#if defined(TANGENT_VEC4)
	float tw;
#endif // TANGENT_VEC4

#ifdef HAS_SKIN
#if defined(JOINTS_8BIT) || defined(JOINTS_16BIT)
	uint joints_8;
#endif // JOINTS_8BIT
#if defined(JOINTS_16BIT)
	uint joints_16;
#endif // JOINTS_16BIT

	float wx;
	float wy;
	float wz;
	float ww;
#endif // HAS_SKIN
};
	""";
}