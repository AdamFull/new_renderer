{
	includes: [];

	code: 
	"""
	// Vertex inputs
#ifdef VERTEX_SHADER
		layout(location = 0) in vec3 inPosition;
#if defined(COLOR_VEC3)
		layout(location = 1) in vec3 inColor;
#elif defined(COLOR_VEC4)
		layout(location = 1) in vec4 inColor;
#endif // HAS_COLOR
#ifdef HAS_TEXCOORD
		layout(location = 2) in vec2 inTexCoord;
#endif // HAS_TEXCOORD
#ifdef HAS_NORMAL
		layout(location = 3) in vec3 inNormal;
#endif // HAS_NORMAL
#if defined(TANGENT_VEC3)
		layout(location = 4) in vec3 inTangent;
#elif defined(TANGENT_VEC4)
		layout(location = 4) in vec4 inTangent;
#endif // HAS_TANGENT
#ifdef HAS_SKIN
		layout(location = 5) in vec4 inJoints;
		layout(location = 6) in vec4 inWeights;
#endif // HAS_SKIN
#endif // VERTEX_SHADER

	// Global descriptors
	layout(std140, set = 0, binding = 0) uniform GlobalUniformFrameData
	{
		mat4 view;
		mat4 invView;
		mat4 projection;
		mat4 invProjection;
		mat4 viewProjection;
		mat4 invViewProjection;
		vec3 viewDirection;
		vec2 viewportDimension;
		float nearPlane;
		float farPlane;
		vec4 frustumPlanes[6];
	} frameData;

	// Bindless texture
	layout(set = 0, binding = 1) uniform sampler2D textures[];

#ifdef MESH_DATA
	struct FMaterial
	{
		// Alpha
		uint alphaMode;
		float alphaCutoff;

		uint baseColorTexture;
		vec4 baseColorFactor;

		uint metallicRoughnessTexture;
		float metallicFactor;
		float roughnessFactor;

		uint normalTexture;
		float normalScale;

		uint occlusionTexture;
		float occlusionStrenth;

		uint emissiveTexture;
		vec3 emissiveFactor;
		
		uint doubleSided;

		// KHR_materials_clearcoat
		float clearcoatFactor;
		float clearcoatRoughnessFactor;

		// KHR_materials_emissive_strength
		float emissiveStrength;

		// KHR_materials_ior
		float ior;

		// KHR_materials_iridescence
		float iridescenceFactor;
		float iridescenceIor;
		float iridescenceThicknessMinimum;
		float iridescenceThicknessMaximum;

		// KHR_materials_sheen
		vec3 sheenColorFactor;
		float sheenRoughnessFactor;

		// KHR_materials_specular
		float specularFactor;
		vec3 specularColorFactor;


		// KHR_materials_transmission
		float transmissionFactor;

		// KHR_materials_unlit ?

		// KHR_materials_volume
		float thicknessFactor;
		float attenuationDistance;
		vec3 attenuationColor;
	};

	layout(std140, set = 1, binding = 0) uniform UniformMeshData
	{
		uint vboId;
		uint objectId;
		uint materialId;
		uint skinId;
	} meshData;

	layout(std430, set = 1, binding = 1) readonly buffer ModelStorage
	{
		mat4 model[];
	} modelStorage;	

	layout(std430, set = 1, binding = 2) readonly buffer MaterialStorage
	{
		FMaterial materials[];
	};	

#ifdef HAS_SKIN
	layout(std430, set = 1, binding = 3) readonly buffer SkinningJoints
	{
		mat4 matrices[];
	};
#endif // HAS_SKIN
#endif // MESH_DATA

#if defined(INDEX_8BIT)
	#define Index uint8_t
#elif defined(INDEX_16BIT)
	#define Index uint16_t
#else
	#define Index uint
#endif

struct RawVertex
{
	float px;
	float py;
	float pz;

#if defined(COLOR_VEC3) || defined(COLOR_VEC4)
	float cr;
	float cg;
	float cb;
#endif // COLOR_VEC3
#if defined(COLOR_VEC4)
	float ca;
#endif // COLOR_VEC4

#ifdef HAS_TEXCOORD
	float u;
	float v;
#endif // HAS_TEXCOORD

#ifdef HAS_NORMAL
	float nx;
	float ny;
	float nz;
#endif // HAS_NORMAL

#if defined(TANGENT_VEC3) || defined(TANGENT_VEC4)
	float tx;
	float ty;
	float tz;
#endif // TANGENT_VEC3
#if defined(TANGENT_VEC4)
	float tw;
#endif // TANGENT_VEC4

#ifdef HAS_SKIN
#if defined(JOINTS_8BIT) || defined(JOINTS_16BIT)
	uint joints_8;
#endif // JOINTS_8BIT
#if defined(JOINTS_16BIT)
	uint joints_16;
#endif // JOINTS_16BIT

	float wx;
	float wy;
	float wz;
	float ww;
#endif // HAS_SKIN
};

	//Vertex get_hl_vertex(in RawVertex)

	void apply_joint_matrix(inout mat4 model, in vec4 in_joints, in vec4 in_weights)
	{
#ifdef HAS_SKIN
#if defined(JOINTS_8BIT)
			u8vec4 joints = u8vec4(uint8_t(in_joints.x * 255.0), uint8_t(in_joints.y * 255.0), uint8_t(in_joints.z * 255.0), uint8_t(in_joints.w * 255.0));
#elif defined(JOINTS_16BIT)
			u16vec4 joints = u16vec4(uint16_t(in_joints.x * 65535.0), uint16_t(in_joints.y * 65535.0), uint16_t(in_joints.z * 65535.0), uint16_t(in_joints.w * 65535.0));
#endif
			uint begin_pos = meshData.skinId * 128;
			mat4 skinMat = 
				in_weights.x * matrices[begin_pos + joints.x] +
				in_weights.y * matrices[begin_pos + joints.y] +
				in_weights.z * matrices[begin_pos + joints.z] +
				in_weights.w * matrices[begin_pos + joints.w];
		
			model = model * skinMat;
#endif // HAS_SKIN
	}
		
	//layout(std140, set = 0, binding = 3) uniform UBOMaterial
	//{
	//	vec4 baseColorFactor;
	//	vec3 emissiveFactor;
	//	float emissiveStrength;
	//	int alphaMode;
	//	float alphaCutoff;
	//	float normalScale;
	//	float occlusionStrenth;
	//	float metallicFactor;
	//	float roughnessFactor;
	//	float tessellationFactor;
	//	float displacementStrength;
	//} material;
	//
	//#ifdef BINDLESS_TEXTURES
	//layout(std140, set = 0, binding = 4) uniform UBOMaterialTextures
	//{
	//	uint color_tex;
	//	uint rmah_tex;
	//	uint normal_tex;
	//	uint occlusion_tex;
	//	uint emissive_tex;
	//	uint height_tex;
	//} texture_ids;
	//#endif
	//
	//struct FInstance
	//{
	//	mat4 model;
	//	vec4 color;
	//};
	//
	//layout(std430, set = 0, binding = 5) buffer readonly UBOInstancing
	//{
	//	FInstance instances[512];
	//} instancing;
	//

	//#define sample_texture(samplerName, texCoord) texture(textures[texture_ids.samplerName], texCoord)
	//#define sample_texture_lod(samplerName, texCoord, lodn) textureLod(textures[texture_ids.samplerName], texCoord, lodn)
	//#define get_texture_size(samplerName, lodn) textureSize(textures[texture_ids.samplerName], lodn)

	""";
}