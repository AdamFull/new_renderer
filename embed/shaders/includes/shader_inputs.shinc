{
	includes: [];

	code: 
	"""
	// Vertex inputs
#ifdef VERTEX_SHADER
		layout(location = 0) in vec3 inPosition;
#if defined(COLOR_VEC3)
		layout(location = 1) in vec3 inColor;
#elif defined(COLOR_VEC4)
		layout(location = 1) in vec4 inColor;
#endif // HAS_COLOR
#ifdef HAS_TEXCOORD
		layout(location = 2) in vec2 inTexCoord;
#endif // HAS_TEXCOORD
#ifdef HAS_NORMAL
		layout(location = 3) in vec3 inNormal;
#endif // HAS_NORMAL
#if defined(TANGENT_VEC3)
		layout(location = 4) in vec3 inTangent;
#elif defined(TANGENT_VEC4)
		layout(location = 4) in vec4 inTangent;
#endif // HAS_TANGENT
#ifdef HAS_SKIN
		layout(location = 5) in vec4 inJoints;
		layout(location = 6) in vec4 inWeights;
#endif // HAS_SKIN
#endif // VERTEX_SHADER

	// Global descriptors
	layout(std140, set = 0, binding = 0) uniform GlobalUniformFrameData
	{
		mat4 view;
		mat4 invView;
		mat4 projection;
		mat4 invProjection;
		mat4 viewProjection;
		mat4 invViewProjection;
		vec3 viewDirection;
		vec2 viewportDimension;
		vec4 frustumPlanes[6];
	} frameData;

	// Bindless texture
	layout(set = 0, binding = 1) uniform sampler2D textures[];

#ifdef MESH_DATA
	layout(std140, set = 1, binding = 0) uniform UniformMeshData
	{
		uint objectId;
		uint materialId;
	} meshData;

	layout(std430, set = 1, binding = 1) readonly buffer ModelStorage
	{
		mat4 model[];
	} modelStorage;	
#ifdef HAS_SKIN
	layout(std140, set = 1, binding = 2) uniform UniformSkinningJoints
	{
		mat4 matrices[128];
	};
#endif // HAS_SKIN
#endif // MESH_DATA
	struct Vertex
	{
		vec3 pos;
#if defined(COLOR_VEC3)
		vec3 color;
#elif defined(COLOR_VEC4)
		vec4 color;
#endif // HAS_COLOR
#ifdef HAS_TEXCOORD
		vec2 uv;
#endif // HAS_TEXCOORD
#ifdef HAS_NORMAL
		vec3 normal;
#endif // HAS_NORMAL
#if defined(TANGENT_VEC3)
		vec3 tangent;
#elif defined(TANGENT_VEC4)
		vec4 tangent;
#endif // HAS_TANGENT
#ifdef HAS_SKIN
#if defined(JOINTS_8BIT)
		u8vec4 joints;
#elif defined(JOINTS_16BIT)
		u16vec4 joints;
#endif // JOINTS_BIT
		vec4 weights;
#endif // HAS_SKIN
	};
		
	//layout(std140, set = 0, binding = 3) uniform UBOMaterial
	//{
	//	vec4 baseColorFactor;
	//	vec3 emissiveFactor;
	//	float emissiveStrength;
	//	int alphaMode;
	//	float alphaCutoff;
