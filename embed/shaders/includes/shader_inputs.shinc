	//	float occlusionStrenth;
	//	float metallicFactor;
	//	float roughnessFactor;
	//	float tessellationFactor;
	//	float displacementStrength;
	//} material;
	//
	//#ifdef BINDLESS_TEXTURES
	//layout(std140, set = 0, binding = 4) uniform UBOMaterialTextures
	//{
	//	uint color_tex;
	//	uint rmah_tex;
	//	uint normal_tex;
	//	uint occlusion_tex;
	//	uint emissive_tex;
	//	uint height_tex;
	//} texture_ids;
	//#endif
