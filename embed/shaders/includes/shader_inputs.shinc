{
	includes: ["interop/base"];

	code: 
	"""
	#define REGISTER_IMAGE_SLOT(SetIndex, BindingIndex, TextureType, TextureName) \
	[[vk::binding(SetIndex, BindingIndex)]] TextureType TextureName;

	#define REGISTER_TEXTURE_SLOT(SetIndex, BindingIndex, TextureType, SamplerType, TextureName) \
	[[vk::combinedImageSampler]][[vk::binding(SetIndex, BindingIndex)]] TextureType TextureName; \
	[[vk::combinedImageSampler]][[vk::binding(SetIndex, BindingIndex)]] SamplerType TextureName##_sampler;

	#define REGISTER_UAV_SLOT(SetIndex, BindingIndex, TextureType, TextureName) \
	[[vk::binding(SetIndex, BindingIndex)]] TextureType TextureName;

	// Vertex inputs
#ifdef VERTEX_SHADER
	struct VSMeshInput
	{
		[[vk::location(0)]] float4 Pos : POSITION0;

#if defined(COLOR_VEC3)
		[[vk::location(1)]] float3 Color : COLOR0;
#elif defined(COLOR_VEC4)
		[[vk::location(1)]] float3 Color : COLOR0;
#endif // HAS_COLOR
		
#ifdef HAS_TEXCOORD
		[[vk::location(2)]] float2 UV : TEXCOORD0;
#endif // HAS_TEXCOORD
		
#ifdef HAS_NORMAL
		[[vk::location(3)]] float3 Normal : NORMAL0;
#endif // HAS_NORMAL
		
#if defined(TANGENT_VEC3)
		[[vk::location(4)]] float3 Tangent : TANGENT0;
#elif defined(TANGENT_VEC4)
		[[vk::location(4)]] float4 Tangent : TANGENT0;
#endif // HAS_TANGENT

#ifdef HAS_SKIN
		[[vk::location(5)]] uint4 Joints : BLENDINDICES0;
		[[vk::location(6)]] float4 Weights : BLENDWEIGHT0;
#endif // HAS_SKIN
	};
#endif // VERTEX_SHADER

	// Bindless texture
	[[vk::combinedImageSampler]][[vk::binding(0, 3)]] Texture2D globalTextures[];
	[[vk::combinedImageSampler]][[vk::binding(0, 3)]] SamplerState globalTextures_sampler[];

	#define GET_GLOB_TEXTURE_2D(texture_index) globalTextures[NonUniformResourceIndex(LoadBuffer<uint32_t>(textureRemapBuffer, texture_index))]
	#define GET_GLOB_SAMPLER_2D(texture_index) globalTextures_sampler[NonUniformResourceIndex(LoadBuffer<uint32_t>(textureRemapBuffer, texture_index))]

	inline float4 GlobSample2D(uint texture_index, float2 texcoord, uint2 offset = 0) { return GET_GLOB_TEXTURE_2D(texture_index).Sample(GET_GLOB_SAMPLER_2D(texture_index), texcoord, offset); }
	inline float4 GlobSampleLod2D(uint texture_index, float2 texcoord, float level, uint2 offset = 0) { return GET_GLOB_TEXTURE_2D(texture_index).SampleLevel(GET_GLOB_SAMPLER_2D(texture_index), texcoord, level, offset); }
	inline float4 GlobSampleGrad2D(uint texture_index, float2 texcoord, float2 ddx, float2 ddy, uint2 offset = 0) { return GET_GLOB_TEXTURE_2D(texture_index).SampleGrad(GET_GLOB_SAMPLER_2D(texture_index), texcoord, ddx, ddy, offset); }

	#define TEX2D(TextureName, texcoord) TextureName.Sample(TextureName##_sampler, texcoord)
	#define TEX2DOFFSET(TextureName, texcoord, offset) TextureName.Sample(TextureName##_sampler, texcoord, offset)
	#define TEX2DLOD(TextureName, texcoord, level) TextureName.SampleLevel(TextureName##_sampler, texcoord, level)
	#define TEX2DLODOFFSET(TextureName, texcoord, level, offset) TextureName.SampleLevel(TextureName##_sampler, texcoord, level, offset)
	#define TEX2DGRAD(TextureName, texcoord, ddx, ddy) TextureName.SampleGrad(TextureName##_sampler, texcoord, ddx, ddy)
	#define TEX2DGRADOFFSET(TextureName, texcoord, ddx, ddy, offset) TextureName.SampleGrad(TextureName##_sampler, texcoord, ddx, ddy, offset)

	// Base global object getters
	inline FSceneNode GetSceneNode(in uint32_t index) { return LoadBuffer<FSceneNode>(nodeBuffer, index); }
	inline void SetSceneNode(in uint32_t index, in FSceneNode node) { StoreBuffer<FSceneNode>(nodeBuffer, index, node); }

	// Matrix getters
	inline float4x4 GetMatrixById(uint global_offset, uint local_offset) { return LoadBuffer<float4x4>(matrixBuffer, global_offset + local_offset); }
	inline void SetMatrixById(uint global_offset, uint local_offset, in float4x4 matrix) { StoreBuffer<float4x4>(matrixBuffer, global_offset + local_offset, matrix); }

	inline float4x4 GetModelMatrix(uint global_offset) { return GetMatrixById(global_offset, model_matrix_offset); }
	inline float4x4 GetOldModelMatrix(uint global_offset) { return GetMatrixById(global_offset, old_model_matrix_offset); }
	inline float4x4 GetViewMatrix(uint global_offset) { return GetMatrixById(global_offset, view_matrix_offset); }
	inline float4x4 GetInvViewMatrix(uint global_offset) { return GetMatrixById(global_offset, inv_view_matrix_offset); }
	inline float4x4 GetProjectionMatrix(uint global_offset) { return GetMatrixById(global_offset, projection_matrix_offset); }
	inline float4x4 GetInvProjectionMatrix(uint global_offset) { return GetMatrixById(global_offset, inv_projection_matrix_offset); }
	inline float4x4 GetViewProjectionMatrix(uint global_offset) { return GetMatrixById(global_offset, view_projection_matrix_offset); }
	inline float4x4 GetPrevViewProjectionMatrix(uint global_offset) { return GetMatrixById(global_offset, prev_view_projection_matrix_offset); }
	inline float4x4 GetInvViewProjectionMatrix(uint global_offset) { return GetMatrixById(global_offset, inv_view_projection_matrix_offset); }
	inline float4x4 GetReprojectionMatrix(uint global_offset) { return GetMatrixById(global_offset, reprojection_matrix_offset); }

	inline FMesh GetMesh(uint index) { return LoadBuffer<FMesh>(meshBuffer, index); }
	inline void SetMesh(uint index, in FMesh mesh) { StoreBuffer<FMesh>(meshBuffer, index, mesh); }

	inline FMaterial GetMaterial(uint index) { return LoadBuffer<FMaterial>(materialBuffer, index); }
	inline void SetMaterial(uint index, in FMaterial material) { return StoreBuffer<FMaterial>(materialBuffer, index, material); }

	inline FLightCommit GetLight(uint index) { return LoadBuffer<FLightCommit>(lightsBuffer, index); }
	inline void SetLight(uint index, in FLightCommit light) { StoreBuffer<FLightCommit>(lightsBuffer, index, light); }
	
	// Shadow getters
	inline FCascadedShadowCommit GetCascadedShadowCommit(uint index) { return LoadBuffer<FCascadedShadowCommit>(cascadedShadowBuffer, index); }
	inline void SetCascadedShadowCommit(uint index, in FCascadedShadowCommit commit) { StoreBuffer<FCascadedShadowCommit>(cascadedShadowBuffer, index, commit); }

	inline FOmniShadowCommit GetOmniShadowCommit(uint index) { return LoadBuffer<FOmniShadowCommit>(omniShadowBuffer, index); }
	inline void SetOmniShadowCommit(uint index, in FOmniShadowCommit commit) { StoreBuffer<FOmniShadowCommit>(omniShadowBuffer, index, commit); }

	inline FSpotShadowCommit GetSpotShadowCommit(uint index) { return LoadBuffer<FSpotShadowCommit>(spotShadowBuffer, index); }
	inline void SetSpotShadowCommit(uint index, in FSpotShadowCommit commit) { StoreBuffer<FSpotShadowCommit>(spotShadowBuffer, index, commit); }

	inline FGeometryBatch GetDrawInfo(uint index) { return LoadBuffer<FGeometryBatch>(drawInfoBuffer, index); }
	inline void SetDrawInfo(uint index, in FGeometryBatch batch) { StoreBuffer<FGeometryBatch>(drawInfoBuffer, index, batch); }

	inline FGeometryBatch GetRawDrawInfo(uint index) { return LoadBuffer<FGeometryBatch>(rawDrawInfoBuffer, index); }
	inline void SetRawDrawInfo(uint index, in FGeometryBatch batch) { StoreBuffer<FGeometryBatch>(rawDrawInfoBuffer, index, batch); }

	inline float4 GetFrustumSides(uint index) { return LoadBuffer<float4>(frustumSidesBuffer, index); }
	inline void SetFrustumSides(uint index, in float4 side) { StoreBuffer<float4>(frustumSidesBuffer, index, side); }

	inline FDrawIndexedIndirectData GetDrawIndexedIndirectData(uint index) { return LoadBuffer<FDrawIndexedIndirectData>(indirectCommandBuffer, index); }
	inline void SetDrawIndexedIndirectData(uint index, in FDrawIndexedIndirectData indirect_data) { StoreBuffer<FDrawIndexedIndirectData>(indirectCommandBuffer, index, indirect_data); }

	inline uint32_t getIndirectCount(uint index) { return LoadBuffer<uint32_t>(indirectCountBuffer, index); }
	inline void SetIndirectCount(uint index, in uint32_t value) { StoreBuffer<uint32_t>(indirectCountBuffer, index, value); }
	inline uint32_t IncrementIndirectCount(uint index) { uint32_t output; InterlockedAdd(LoadBuffer<uint32_t>(indirectCountBuffer, index), 1, output); return output; }

	inline uint32_t GetTextureRemapIndex(uint index) { return LoadBuffer<uint32_t>(textureRemapBuffer, index); } 
	inline void SetTextureRemapIndex(uint index, in uint32_t value) { StoreBuffer<uint32_t>(textureRemapBuffer, index, value); } 
	
	inline FCamera GetCamera(uint index) { return LoadBuffer<FCamera>(cameraBuffer, index); }
	inline void SetCamera(uint index, in FCamera camera) { StoreBuffer<FCamera>(cameraBuffer, index, camera); }

	inline float3 GetCameraPosition(uint matricesOffset)
	{
	    float4x4 inv_view = GetInvViewMatrix(matricesOffset);
	    float3 camera_pos = float3(inv_view._m30, inv_view._m31, inv_view._m32);
	    return camera_pos;
	}
	""";
}