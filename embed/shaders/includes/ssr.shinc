{
	includes: ["util"];

	code: 
	"""
        const float rayStep = 0.2f;
		const int iterationCount = 100;
		const float distanceBias = 0.05f;
		const int sampleCount = 4;
		const float samplingCoefficient = 0.01f;
		const float reflectionSpecularFalloffExponent = 3.f;
		const int debugDraw = -1;
		const int isBinarySearchEnabled = 1;
		const int isAdaptiveStepEnabled = 1;
		const int isExponentialStepEnabled = -1;
		const int isSamplingEnabled = 1;

		float3 generatePositionFromDepth(float2 texturePos, float depth) 
		{
			FCamera camera = GetCamera(frameData.defaultCameraID);

			float4 ndc = float4((texturePos - 0.5) * 2, depth, 1.f);
			float4 inversed = mul(ndc, GetInvProjectionMatrix(camera.matricesOffset));
			inversed /= inversed.w;
			return inversed.xyz;
		}
		
		float2 generateProjectedPosition(float3 pos)
		{
			FCamera camera = GetCamera(frameData.defaultCameraID);

			float4 samplePosition = mul(float4(pos, 1.f), GetProjectionMatrix(camera.matricesOffset));
			samplePosition.xy = (samplePosition.xy / samplePosition.w) * 0.5 + 0.5;
			return samplePosition.xy;
		}

		float2 SSRRaycast(in float3 position, in float3 reflection, in Texture2D<float> depth_texture, in SamplerState sampler, out float3 color) 
		{
			float3 stp = rayStep * reflection;
			float3 marchingPosition = position + stp;
			float delta;
			float depthFromScreen;
			float2 screenPosition;
			
			int i = 0;
			[unroll]
			for (; i < iterationCount; i++) 
			{
				screenPosition = generateProjectedPosition(marchingPosition);
				depthFromScreen = abs(generatePositionFromDepth(screenPosition, depth_texture.Sample(sampler, screenPosition).x).z);
				delta = abs(marchingPosition.z) - depthFromScreen;
		
				if (abs(delta) < distanceBias) 
				{
					color = float3(1);
					if(debugDraw > 0)
						color = float3( 0.5+ sign(delta)/2,0.3,0.5- sign(delta)/2);
					return screenPosition;
				}
		
				if (isBinarySearchEnabled > 0 && delta >= 0)
					break;
		
				if (isAdaptiveStepEnabled > 0)
				{
					float directionSign = sign(abs(marchingPosition.z) - depthFromScreen);
					//this is sort of adapting step, should prevent lining reflection by doing sort of iterative converging
					//some implementation doing it by binary search, but I found this idea more cheaty and way easier to implement
					stp = stp * (1.0 - rayStep * max(directionSign, 0.0));
					marchingPosition += stp * (-directionSign);
				}
				else
					marchingPosition += stp;
			
				if (isExponentialStepEnabled > 0)
					stp *= 1.05;
		    }
		
		
			if(isBinarySearchEnabled > 0)
			{
				[unroll]
				for(; i < iterationCount; i++){
					
					stp *= 0.5;
					marchingPosition = marchingPosition - stp * sign(delta);
					
					screenPosition = generateProjectedPosition(marchingPosition);
					depthFromScreen = abs(generatePositionFromDepth(screenPosition, depth_sampler.Sample(sampler, screenPosition).x).z);
					delta = abs(marchingPosition.z) - depthFromScreen;
					
					if (abs(delta) < distanceBias) 
					{
		                color = float3(1);
		                if(debugDraw > 0)
		                    color = float3( 0.5+ sign(delta)/2,0.3,0.5- sign(delta)/2);
						return screenPosition;
					}
				}
			}
			
		    return float2(0.0);
		}

		float3 computeSSR(in float2 uv, in float3 position, in float3 normal, in float metallic, in float roughness, in sampler2D depth_sampler, in sampler2D color_sampler)
		{
			float3 ssr = float3(0.0);

			const float roughnessThreshold = 0.7f;
			bool ssrEnabled = roughness < roughnessThreshold;
			if(ssrEnabled)
			{
				float3 reflectionDirection = normalize(reflect(position, normalize(normal)));
				float3 firstBasis = normalize(cross(float3(0.f, 0.f, 1.f), reflectionDirection));
				float3 secondBasis = normalize(cross(reflectionDirection, firstBasis));
				float4 resultingColor = float4(0.f);
		
				for (int i = 0; i < sampleCount; i++) 
				{
					float2 coeffs = float2(random(uv + float2(0, i)) + random(uv + float2(i, 0))) * samplingCoefficient;
					float3 reflectionDirectionRandomized = reflectionDirection + firstBasis * coeffs.x + secondBasis * coeffs.y;
		
					float3 debugColor;
					float2 coords = SSRRaycast(position, normalize(reflectionDirectionRandomized), depth_sampler, debugColor);
					if (coords != float2(0.0f))
					{
						float4 reflColor = textureLod(color_sampler, coords, 0);
						reflColor.rgb *= debugColor;
		
						float2 dCoords = smoothstep(0.2, 0.6, abs(float2(0.5, 0.5) - coords.xy));
						float screenEdgefactor = clamp(1.0 - (dCoords.x + dCoords.y), 0.0, 1.0);
						float reflectionMultiplier = pow(metallic, reflectionSpecularFalloffExponent) * screenEdgefactor * -reflectionDirection.z;
		
						reflColor.rgb *= clamp(reflectionMultiplier, 0.0, 0.9);
		
						resultingColor += reflColor;
					}
				}
		
				if (resultingColor.w != 0)
				{
					resultingColor /= resultingColor.w;
					ssr = resultingColor.rgb;
				}

				//float roughnessMask = saturate(1.0f - (roughness / roughnessThreshold));
				//float ssrWeight = (resultingColor.w * roughnessMask);
				//ssr = clamp(resultingColor.xyz * ssrWeight, 0.0, 1.0);
			}

			return ssr;
		}

		// Convert view space position to screen UVs (0, 1). Non-linear Z
		float3 ViewPositionToUV(float3 view, float4x4 projection)
		{
			float4 proj = mul(float4(view, 1.0), projection);
			proj.xyz /= proj.w;
			proj.x = (proj.x + 1.0) / 2.0;
			proj.y = (proj.y + 1.0) / 2.0;
			//proj.y = 1.0 - (proj.y + 1.0) / 2.0;
			return proj.xyz;
		}
		
		float3 ScreenSpaceReflections(in float3 worldPosition, in float3 N, in float3 V, in float R, in sampler2D depthTexture, in sampler2D previousSceneColor, float dither, inout float ssrWeight)
		{
			FCamera camera = GetCamera(frameData.defaultCameraID);
			float4x4 float4x4 = GetViewMatrix(camera.matricesOffset);

			float3 ssr = float3(0.0);
			float3 debug = float3(0.0);
			const float roughnessThreshold = 0.75f;
			bool ssrEnabled = R < roughnessThreshold;
			if(ssrEnabled)
			{
				float reflectionThreshold = 0.0f;
				float3 reflectionWs = normalize(reflect(-V, N));
				if (dot(V, reflectionWs) <= reflectionThreshold)
				{
					float jitter = dither - 1.0f;
					uint maxSteps = 8;
				
					float3 rayStartVS = float3(mul(float4(worldPosition, 1.0), view));
					float linearDepth = rayStartVS.z;
					float3 reflectionVs = float3(mul(float4(reflectionWs, 1.0), view));
					float3 rayEndVS = rayStartVS + (reflectionVs * linearDepth);
				
					float4x4 projection = GetProjectionMatrix(camera.matricesOffset);
					float3 rayStart = ViewPositionToUV(rayStartVS, projection);
					float3 rayEnd = ViewPositionToUV(rayEndVS, projection);
				
					float3 rayStep = ((rayEnd - rayStart) / float(maxSteps));
					rayStep = rayStep / length(rayEnd.xy - rayStart.xy);
					float3 rayPos = rayStart + (rayStep * jitter);
					float zThickness = abs(rayStep.z);
				
					uint hitIndex = 0;
					float3 bestHit = rayPos;
					float prevSceneZ = rayStart.z;
					for (uint currStep = 0; currStep < maxSteps; currStep += 4)
					{
						uvec4 step = uvec4(1u, 2u, 3u, 4u) + currStep;
						float4 sceneZ = float4(
							textureLod(depthTexture, rayPos.xy + rayStep.xy * step.x, 0).x,
							textureLod(depthTexture, rayPos.xy + rayStep.xy * step.y, 0).x,
							textureLod(depthTexture, rayPos.xy + rayStep.xy * step.z, 0).x,
							textureLod(depthTexture, rayPos.xy + rayStep.xy * step.w, 0).x
						);
						
						float4 currentPosition = rayPos.z + rayStep.z * step;
						uvec4 zTest = uvec4(lessThan(abs(sceneZ - currentPosition - zThickness), float4(zThickness)));
						uint zMask = (((zTest.x << 0u) | (zTest.y << 1u)) | (zTest.z << 2u)) | (zTest.w << 3u);
						
						if(zMask > 0)
						{
							uint firstHit = findLSB(zMask);
							if(firstHit > 0)
								prevSceneZ = sceneZ[firstHit - 1];
				
							bestHit = rayPos + (rayStep * float(currStep + firstHit + 1));
							float zAfter = sceneZ[firstHit] - bestHit.z;
							float zBefore = (prevSceneZ - bestHit.z) + rayStep.z;
							float weight = saturate(zAfter / (zAfter - zBefore));
							float3 prevRayPos = bestHit - rayStep;
							bestHit = (prevRayPos * weight) + (bestHit * (1.0f - weight));
							hitIndex = currStep + firstHit;
							break;
						}
						prevSceneZ = sceneZ.w;
					}
				
					float4 hitColor = float4(0.0);
					if (hitIndex > 0)
					{
						float4x4 reprojection = GetReprojectionMatrix(camera.matricesOffset);

						debug += float3(0.0, 0.5, 0.0);
						float4 uv = float4(bestHit.xy, 0.0, 1.0);
						uv = mul(uv, reprojection);
				
						float2 distanceFromCenter = (float2(uv.x, uv.y) * 2.0f) - float2(1.0f, 1.0f);
						float edgeAttenuation = clamp((1.0 - (float(hitIndex / maxSteps))) * 4.0f, 0.0, 1.0);
						edgeAttenuation *= smoothstep(0.0f, 0.5f, clamp(1.0 - dot(distanceFromCenter, distanceFromCenter), 0.0, 1.0));
						float3 reflectionResult = textureLod(previousSceneColor, uv.xy, 0).rgb;
						hitColor = float4(reflectionResult, edgeAttenuation);
					}
					float roughnessMask = saturate(1.0f - (R / roughnessThreshold));
					ssrWeight = (hitColor.w * roughnessMask);
					ssr = clamp(hitColor.xyz, 0.0, 1.0);
				}
			}
			return ssr;
			//return debug;
		}

		float screen_fade(float2 uv)
		{
			float2 fade = max(12.0f * abs(uv - 0.5f) - 5.0f, 0.0f);
			return saturate(1.0 - dot(fade, fade));
		}

#if 1
		float ScreenSpaceShadows(float3 worldPosition, float3 lightDirection, in sampler2D depthTexture, int stepCount, float rayLength, float ditherOffset)
		{
			FCamera camera = GetCamera(frameData.defaultCameraID);
			float4x4 projection = GetProjectionMatrix(camera.matricesOffset);
			float4x4 view_projection = GetViewProjectionMatrix(camera.matricesOffset);
		
			float4 rayStartPS = view_projection * float4(worldPosition, 1.0);
			float4 rayDirPS = view_projection * float4(-lightDirection * rayLength, 0.0);
			float4 rayEndPS = rayStartPS + rayDirPS;
			rayStartPS.xyz /= rayStartPS.w;
			rayEndPS.xyz /= rayEndPS.w;
		
			float3 rayStep = rayEndPS.xyz - rayStartPS.xyz;
			float stepSize = 1.0f / stepCount;
		
			float4 rayDepthClip = rayStartPS + projection * float4(0.0, 0.0, rayLength, 0.0);
			rayDepthClip.xyz /= rayDepthClip.w;
			float tolerance = abs(rayDepthClip.z - rayStartPS.z) * stepSize * 2.0;
		
			float occlusion = 0.0f;
			float hitStep = -1.0f;
		
			float n = stepSize * ditherOffset + stepSize;
		
			[unroll]
			for(uint i = 0; i < stepCount; ++i)
			{
				float3 rayPos = rayStartPS.xyz + n * rayStep;
				float depth = textureLod(depthTexture, rayPos.xy * float2(0.5f, -0.5f) + float2(0.5f, 0.5f), 0).r;
				float diff = rayPos.z - depth;
		
				bool hit = abs(diff + tolerance) < tolerance;
				hitStep = hit && hitStep < 0.0f ? n : hitStep;
				n += stepSize;
			}
		
			if(hitStep > 0.0f)
			{
				float2 hitUV = rayStartPS.xy + n * rayStep.xy;
				hitUV = hitUV * float2(0.5f, -0.5f) + float2(0.5f, 0.5f);
				occlusion = screen_fade(hitUV);
			}
			return 1.0f - occlusion;
		}
#else
		// Settings
		const uint  g_sss_max_steps                     = 32;     // Max ray steps, affects quality and performance.
		const float g_sss_ray_max_distance              = 0.5f;   // Max shadow length, longer shadows are less accurate.
		const float g_sss_thickness                     = 0.05f;  // Depth testing thickness.
		const float g_sss_max_delta_from_original_depth = 0.005f; // The maximum allowed depth deviation from the original pixel (a big deviation decreased the probabilty that the pixel is the occluder).
		const float g_sss_step_length                   = g_sss_ray_max_distance / float(g_sss_max_steps);

		bool is_valid_uv(float2 value) { return (value.x >= 0.0f && value.x <= 1.0f) && (value.y >= 0.0f && value.y <= 1.0f); }

		float ScreenSpaceShadows(float3 worldPosition, float3 lightDirection, in sampler2D depthTexture, int stepCount, float rayLength, float ditherOffset)
		{
			FCamera camera = GetCamera(frameData.defaultCameraID);
			float4x4 projection = GetProjectionMatrix(camera.matricesOffset);
			float4x4 view = GetViewMatrix(camera.matricesOffset);

			worldPosition.y *= -1.f;

			// Compute ray position and direction (in view-space)
			float3 ray_pos = float3(view * float4(worldPosition, 1.0));
			float3 ray_dir = float3(view * float4(-lightDirection, 0.0));

			// Compute ray step
			float3 ray_step = ray_dir * g_sss_step_length;
			ray_pos += ray_step;

			// Save the original depth
			float depth_original = ray_pos.z;

			// Ray march towards the light
			float occlusion = 0.0;
			float2 ray_uv = float2(0.0f);

			[unroll]
			for (uint i = 0; i < g_sss_max_steps; i++)
			{
				// Step the ray
				ray_pos += ray_step;

				float4 uv = projection * float4(ray_pos, 1.0);
				ray_uv =  (uv.xy / uv.w) * float2(0.5f, -0.5f) + 0.5f;

				// Ensure the UV coordinates are inside the screen
				if (!is_valid_uv(ray_uv))
				    return 1.0f;

				// Compute the difference between the ray's and the camera's depth
				float depth_z       = LinearizeDepth(textureLod(depthTexture, ray_uv, 0).r, camera.zNear, camera.zFar);
				float depth_delta   = ray_pos.z - depth_z;

				bool can_the_camera_see_the_ray     = (depth_delta > 0.0f) && (depth_delta < g_sss_thickness);
				bool occluded_by_the_original_pixel = abs(ray_pos.z - depth_original) < g_sss_max_delta_from_original_depth;
				if (can_the_camera_see_the_ray && occluded_by_the_original_pixel)
				{
				    // Mark as occluded
				    occlusion = 1.0f;

				    // Fade out as we approach the edges of the screen
				    occlusion *= screen_fade(ray_uv);

				    break;
				}
			}

			// Convert to visibility
			return 1.0f - occlusion;
		}
#endif
	""";
}