{
	includes: ["math", "atmosphere/constants"];

	code: 
	"""
		const float maxScatterDistance = (atmosphere_radius - atmosphere_planet_radius) * 2.0;

        const int integralStepCount = 32;
        const int lightIntegralStepCount = 8;
        
        const float3 DefaultColor = float3(0.01);
        const float BaseIntencity = 5.0;
        
        const float RayleighScaleHeight = 8e3;
        const float3 BetaRayleigh = float3(5.8e-6, 13.5e-6, 33.1e-6);
        
        const float MieScaleHeight = 1.2e3;
        const float3 BetaMie = float3(21e-6);
        
        const float AbsorptionScaleHeight = 30e3;
        const float3 BetaAbsorption = float3(2.04e-5, 4.97e-5, 1.95e-6);
        const float FalloffAbsorbtion = 4e3;
        const float3 BetaAmbient = float3(0.01);

        float2 raySphereIntersect(float3 r0, float3 rd, float3 s0, float sr) 
        {
            // - r0: ray origin
            // - rd: normalized ray direction
            // - s0: sphere center
            // - sr: sphere radius
            // - Returns distance from r0 to first intersecion with sphere,
            //   or -1.0 if no intersection.

            float3 oc = r0 - s0;
            float a = dot(rd, rd);
            float half_b = dot(oc, rd);
            float c = dot(oc, oc) - sr * sr;
            float discriminant = half_b * half_b - a * c;

            if (discriminant < 0.0)
                return float2(1e5, -1e5);

            float sq_d = sqrt(discriminant);

            float t1 = (-half_b - sq_d) / a;
            float t2 = (-half_b + sq_d) / a;
            return float2(t1, t2);
        }
        
        float phaseRayleight(float cosAngle)
        {
            float cosAngleSquare = cosAngle * cosAngle;
            return ((3.0 * PI) / 16.0) * (1.0 + cosAngleSquare);
        }
        
        float phaseMie(float cosAngle, float g)
        {
            float cosAngleSquare = cosAngle * cosAngle;
            float gSquare = g * g;
            return ((3.0 * PI) / 8.0) * (1.0 - gSquare) * (1.0 + cosAngleSquare) / ((2.0 + gSquare) * pow(1.0 + gSquare - 2. * g * cosAngle, 1.5));
        }
        
        // Calculate Rayleight, Mie and Absorbtion density 
        float3 calculateDensity(float height, float deltaHeight)
        {
            const float2 scaleHeight = float2(RayleighScaleHeight, MieScaleHeight);
        
            // Calculate density for Rayleight and Mie both
            float3 density = float3(exp(-height / scaleHeight), 0.0);
        
            // Calculate adsorption (Ozone)
            float denom = (AbsorptionScaleHeight - height) / FalloffAbsorbtion;
            density.z = (1.0 / (denom * denom + 1.0)) * density.x;
        
            density *= deltaHeight;
        
            return density;
        }
        
        float3 atmosphere(float3 origin, float3 direction, float3 sunDirection, float sunIntensity)
        {
            // Trace ray from viewer position to atmosphere
            float2 intersection = raySphereIntersect(origin, direction, float3(0.0), atmosphere_radius);
        
            if (intersection.x > intersection.y)
                return DefaultColor;
        
            float hitDistance = max(intersection.x, intersection.y);
        
            if (hitDistance < 0.0)
                return DefaultColor;
        
            hitDistance = min(hitDistance, maxScatterDistance);
        
            // Calculate point where ray hit a sphere
            float3 hitPosition = direction * hitDistance;
            float3 rayStep = hitPosition / float(integralStepCount);
            float stepHeight = length(rayStep);
        
            float3 opticalDepth = float3(0.0);
            float3 totalRayleight = float3(0.0);
            float3 totalMie = float3(0.0);
        
            // Solve first integral
            [unroll]
            for (int i = 0; i < integralStepCount; ++i)
            {
                // Calculate current ray step from VIEWER to SKY
                float3 integralPos = origin + rayStep * float(i);
                float integralHeight = length(integralPos) - atmosphere_planet_radius;
        
                // Accumulate air density
                float3 density = calculateDensity(integralHeight, stepHeight);
                opticalDepth += density;
        
                // Trace ray from current integral position to sun direction
                float2 sunIntersection = raySphereIntersect(integralPos, -sunDirection, float3(0.0), atmosphere_radius);
                float sunHitDistance = max(sunIntersection.x, sunIntersection.y);
        
                // Calculate point where ray hit a sphere
                float3 sunHitPosition = -sunDirection * sunHitDistance;
                float3 sunRayStep = sunHitPosition / float(lightIntegralStepCount);
                float sunStepHeight = length(sunRayStep);
        
                float3 sunOpticalDepth = float3(0.0);
        
                // Solve second integral
                [unroll]
                for (int j = 0; j < lightIntegralStepCount; ++j)
                {
                    // Calculate position from INTEGRAL POSITION to SUN
                    float3 sunIntegralPos = integralPos + sunRayStep * float(j);
                    float sunIntegralHeight = length(sunIntegralPos) - atmosphere_planet_radius;
        
                    // Accumulate sun density
                    float3 sunDensity = calculateDensity(sunIntegralHeight, sunStepHeight);
                    sunOpticalDepth += sunDensity;
                }
        
                // Calculate light attenuation
                float3 attenuation = exp(-(BetaRayleigh * (opticalDepth.x + sunOpticalDepth.x) + BetaMie * (opticalDepth.y + sunOpticalDepth.y) + BetaAbsorption * (opticalDepth.z + sunOpticalDepth.z)));
        
                // Accumulate Rayleight and Mie color
                totalRayleight += density.x * attenuation;
                totalMie += density.y * attenuation;
            }
        
            // Angle between viewer direction and sun direction
            float angle = dot(normalize(direction), -sunDirection);
        
            // Calculate total scattered color
            float3 rayleightColor = BaseIntencity * phaseRayleight(angle) * BetaRayleigh * totalRayleight;
            float3 mieColor = sunIntensity * phaseMie(angle, 0.45) * BetaMie * totalMie;
            float3 sunColor = sunIntensity * phaseMie(angle, 0.999) * BetaMie * totalMie;
        
            return rayleightColor + mieColor + sunColor;
        }
	""";
}