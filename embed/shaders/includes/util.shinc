	code: 
	"""
		float4 sRGBToLinear(in float4 srgbIn)
        {
            float3 bLess = step(float3(0.04045),srgbIn.xyz);
        	float3 linOut = lerp( srgbIn.xyz/float3(12.92), pow((srgbIn.xyz+float3(0.055))/float3(1.055),float3(2.4)), bLess );
        	return float4(linOut,srgbIn.w);
        }
        
        float4 linearTosRGB(float4 linearRGB)
        {
            bool4 cutoff = linearRGB < float4(0.0031308, 0.0031308, 0.0031308, 0.0031308);
    		float4 higher = 1.055 * pow(linearRGB, float4(1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4)) - float4(0.055, 0.055, 0.055, 0.055);
    		float4 lower = linearRGB * float4(12.92, 12.92, 12.92, 12.92);

    		return lerp(higher, lower, cutoff);
        }
        
        // From http://filmicworlds.com/blog/filmic-tonemapping-operators/
        float3 Uncharted2Tonemap(float3 color)
        {
        	float A = 0.15f;
        	float B = 0.50f;
        	float C = 0.10f;
        	float D = 0.20f;
        	float E = 0.02f;
        	float F = 0.30f;
        	float W = 11.2f;
        	return ((color*(A*color+C*B)+D*E)/(color*(A*color+B)+D*F))-E/F;
        }
        
        float3 getTangentSpaceNormalMap(in float3 normalColor, float3x3 TBN, float scale)
        {
            float3 normal = normalize(mul(((2.0 * normalColor - 1.0) * float3(scale, scale, 1.0)), TBN));
        	return normal;
        }
        
        // Calculate normal in tangent space
        float3x3 calculateTBN(float3 normal, float4 tangent)
        {
        	float3 N = normalize(normal);
        	float3 T = normalize(tangent.xyz);
            float3 B = normalize(cross(N, T) * tangent.w);
        	
        	return float3x3(T, B, N);
        }

		// Based omn http://byteblacksmith.com/improvements-to-the-canonical-one-liner-glsl-rand-for-opengl-es-2-0/
		float random(float2 co)
		{
			float a = 12.9898f;
			float b = 78.233f;
			float c = 43758.5453f;
			float dt= dot(co.xy ,float2(a,b));
			float sn= mod(dt,3.14f);
			return frac(sin(sn) * c);
		}

		float3 GetPositionFromDepth(float2 texcoord, float depth, float4x4 invViewProjection)
        {
            float4 clipSpaceLocation;
            clipSpaceLocation.x = texcoord.x * 2.0f - 1.0f;
            clipSpaceLocation.y = texcoord.y * 2.0f - 1.0f;
            clipSpaceLocation.z = depth;
            clipSpaceLocation.w = 1.0f;
            float4 homogenousLocation = mul(clipSpaceLocation, invViewProjection);
            return homogenousLocation.xyz / homogenousLocation.w;
        }

        #ifdef FRAGMENT_SHADER
        float3 GetNormalFromDepth(in float depth, in float2 uv, in float4x4 invProjection)
        {
            float4 clipSpace = float4(uv * 2.0 - 1.0, depth, 1.0);
            float4 viewSpace = mul(clipSpace, invProjection);
            viewSpace.xyz /= viewSpace.w;
        
            float3 pos = viewSpace.xyz;
            float3 n = normalize(cross(dFdx(pos), dFdy(pos)));
            n *= -1;
        
            return n;
        }
        #endif

        float LinearizeDepth(in float depth, in float zNear, in float zFar)
        {
            float z = depth * 2.0f - 1.0f;
            return (2.0f * zNear * zFar) / (zFar + zNear - z * (zFar - zNear));
        }

        float2 EncodeVelocity(in float2 velocity)
        {
#ifdef LOW_PRECISION_VELOCITY
            return pow(velocity * 0.5 + 0.5, float2(3.0));
#else
            return velocity * 0.5 + 0.5;
#endif
        }
        
        float2 DecodeVelocity(in float2 velocity)
        {
#ifdef LOW_PRECISION_VELOCITY
            return pow(velocity, float2(1.0 / 3.0)) * 2.0 - 1.0;
#else
            return velocity * 2.0 - 1.0;
#endif
        }

        float2 BarrelDistortion(float2 coord, float amt) {
			float2 cc = coord - 0.5;
			float dist = dot(cc, cc);
			return coord + cc * dist * amt;
		}

        bool is_saturated(float a) { return a == saturate(a); }
        bool is_saturated(float2 a) { return a == saturate(a); }
        bool is_saturated(float3 a) { return a == saturate(a); }
        bool is_saturated(float4 a) { return a == saturate(a); }
		
		float linterp( float t ) {
			return saturate( 1.0 - abs( 2.0*t - 1.0 ) );
		}
		
		float remap( float t, float a, float b ) {
			return saturate( (t - a) / (b - a) );
		}
		
		float4 spectrum_offset( float t ) {
			float4 ret;
			float lo = step(t,0.5);
			float hi = 1.0-lo;
			float w = linterp( remap( t, 1.0/6.0, 5.0/6.0 ) );
			ret = float4(lo,1.0,hi, 1.) * float4(1.0-w, w, 1.0-w, 1.);
		
			return pow( ret, float4(1.0/2.2) );
		}

		float3 convertXYZ2Yxy(float3 _xyz)
		{
			// Reference(s):
			// - XYZ to xyY
			//   https://web.archive.org/web/20191027010144/http://www.brucelindbloom.com/index.html?Eqn_XYZ_to_xyY.html
			float inv = 1.0/dot(_xyz, float3(1.0, 1.0, 1.0) );
			return float3(_xyz.y, _xyz.x*inv, _xyz.y*inv);
		}
		
		float3 convertXYZ2RGB(float3 _xyz)
		{
			float3 rgb;
			rgb.x = dot(float3( 3.2404542, -1.5371385, -0.4985314), _xyz);
			rgb.y = dot(float3(-0.9692660,  1.8760108,  0.0415560), _xyz);
			rgb.z = dot(float3( 0.0556434, -0.2040259,  1.0572252), _xyz);
			return rgb;
		}
		
		float3 convertRGB2XYZ(float3 _rgb)
		{
			// Reference(s):
			// - RGB/XYZ Matrices
			//   https://web.archive.org/web/20191027010220/http://www.brucelindbloom.com/index.html?Eqn_RGB_XYZ_Matrix.html
			float3 xyz;
			xyz.x = dot(float3(0.4124564, 0.3575761, 0.1804375), _rgb);
			xyz.y = dot(float3(0.2126729, 0.7151522, 0.0721750), _rgb);
			xyz.z = dot(float3(0.0193339, 0.1191920, 0.9503041), _rgb);
			return xyz;
		}
		
		float3 convertYxy2XYZ(float3 _Yxy)
		{
			// Reference(s):
			// - xyY to XYZ
			//   https://web.archive.org/web/20191027010036/http://www.brucelindbloom.com/index.html?Eqn_xyY_to_XYZ.html
			float3 xyz;
			xyz.x = _Yxy.x*_Yxy.y/_Yxy.z;
			xyz.y = _Yxy.x;
			xyz.z = _Yxy.x*(1.0 - _Yxy.y - _Yxy.z)/_Yxy.z;
			return xyz;
		}
		
		float3 convertRGB2Yxy(float3 _rgb)
		{
			return convertXYZ2Yxy(convertRGB2XYZ(_rgb) );
		}
		
		float3 convertYxy2RGB(float3 _Yxy)
		{
			return convertXYZ2RGB(convertYxy2XYZ(_Yxy) );
		}
		
		float reinhard2(float _x, float _whiteSqr)
		{
			return (_x * (1.0 + _x/_whiteSqr) ) / (1.0 + _x);
		}
		
		float3 toGamma(float3 _rgb, float gamma)
		{
			return pow(abs(_rgb), float3(1.0 / gamma) );
		}
	""";
}