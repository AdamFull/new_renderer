					{ base: "INDEX_16BIT" }
				];
			};
		},
		{
			shader_name: "shade";
			permutation_generator: {
				definitions: [
					{ base: "HAS_TEXCOORD" },
					{ base: "HAS_NORMAL" },
					{ base: "HAS_SKIN", var:[{ base: "JOINTS_8BIT" }, { base: "JOINTS_16BIT" }] },
					{ base: "COLOR_VEC3" },
					{ base: "COLOR_VEC4" },
					{ base: "TANGENT_VEC3" },
					{ base: "TANGENT_VEC4" },
					{ base: "INDEX_8BIT" },
					{ base: "INDEX_16BIT" }
				];
			};
		},
		{
			shader_name: "shade_frag";
			permutation_generator: {
				definitions: [
					{ base: "HAS_TEXCOORD" },
					{ base: "HAS_NORMAL" },
					{ base: "HAS_SKIN", var:[{ base: "JOINTS_8BIT" }, { base: "JOINTS_16BIT" }] },
					{ base: "COLOR_VEC3" },
					{ base: "COLOR_VEC4" },
					{ base: "TANGENT_VEC3" },
					{ base: "TANGENT_VEC4" },
