{
	name: "visibilitybuffer";

	shaders: [
		{
			name: "write";
			sources: [
				"visbufferwrite_vert",
				"visbufferwrite_frag"
			];
		},
		{
			name: "shade";
			sources: [
				"visbuffershade_comp"
			];
		}
	];

	compile: [
		{ 
			shader_name: "write";
			pattern: "geometry_pattern";
		},
		{
			shader_name: "shade";
			pattern: "geometry_pattern";
		}
	];
}