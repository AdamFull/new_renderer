{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA", "LIGHT_DATA"];

	require_extensions: [
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["visibility_buffer", "compute_common", "lighting_model"];

	code: 
	"""
		layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

		layout(set = 2, binding = 5, rgba16f) uniform writeonly image2D write_color;
		layout(set = 2, binding = 6) uniform sampler2D depth_buffer;

		vec4 sampleTexture(in uint s, in VertexAttribute va)
		{
			return textureGrad(textures[s], va.uv, va.uv_dx, va.uv_dy);
		}

		MaterialSample sampleMaterial(in FMaterial mat, in VertexAttribute va)
		{
			MaterialSample res;

			// Sample albedo
			vec4 base_color = mat.baseColorFactor * va.color;
			if(mat.baseColorTexture != ~0u)
				base_color *= sampleTexture(mat.baseColorTexture, va);

			res.albedo = base_color.rgb;
			res.opacity = base_color.a;

			// Sample emission
			res.emission = mat.emissiveFactor;
			if(mat.emissiveTexture != ~0u)
				res.emission *= sampleTexture(mat.emissiveTexture, va).rgb;
			res.emission *= mat.emissiveStrength;

			// Sample metallic roughness
			res.metallic = mat.metallicFactor;
			res.roughness = mat.roughnessFactor;
			if(mat.metallicRoughnessTexture != ~0u)
			{
				vec4 mr = sampleTexture(mat.metallicRoughnessTexture, va);
				res.metallic *= mr.b;
				res.roughness *= mr.g;
			}
			res.roughness = clamp(res.roughness, 0.04, 1.0);

			// Sample normals
			res.normal = va.normal;
			if(mat.normalTexture != ~0u)
			{
				vec3 ts_normal = sampleTexture(mat.normalTexture, va).rgb;

				vec3 b = cross(va.normal, va.tangent.xyz) * va.tangent.w;
				mat3 tbn = mat3(va.tangent.xyz, b, va.normal);

				res.normal = normalize(tbn * ((2.0 * ts_normal - 1.0) * vec3(mat.normalScale, mat.normalScale, 1.0)));
			}

			// Sample AO
			res.ao = 1.0;
			if(mat.occlusionTexture != ~0u)
				res.ao = sampleTexture(mat.occlusionTexture, va).r * mat.occlusionStrenth;

			res.ior = mat.ior;

			return res;
		}


		vec3 calculateDirectionalLight(in FDirectionalLightCommit light, in vec3 worldPosition, in vec3 albedo, in vec3 V, in vec3 N, in vec3 F0, in float metallic, in float roughness)
		{
			vec3 L = normalize(-light.direction);
		
			vec3 color = specularContribution(albedo, L, V, N, F0, metallic, roughness);
		
			float shadow_factor = 1.0;
			return light.color * light.intencity * color * shadow_factor;
		}

		vec3 calculatePointLight(in FPointLightCommit light, in vec3 worldPosition, in vec3 albedo, in vec3 V, in vec3 N, in vec3 F0, in float metallic, in float roughness)
		{
			vec3 L = normalize(light.position - worldPosition);
			float dist = distance(worldPosition, light.position);
			
			float atten = clamp(1.0 - pow(dist, 2.0f)/pow(light.radius, 2.0f), 0.0f, 1.0f); atten *= atten;
			vec3 color = specularContribution(albedo, L, V, N, F0, metallic, roughness);
		
			float shadow_factor = 1.0;
			return light.color * atten * color * light.intencity * shadow_factor;
		}

		vec3 calculateSpotlight(in FSpotLightCommit light, in vec3 worldPosition, in vec3 albedo, in vec3 V, in vec3 N, in vec3 F0, in float metallic, in float roughness)
		{
			vec3 L = normalize(light.position - worldPosition);
		
			// Direction vector from source to target
			vec3 dir = vec3(normalize(light.direction));
			if(light.toTarget > 0)
				dir = normalize(light.position - light.direction);
		
			vec3 color = specularContribution(albedo, L, V, N, F0, metallic, roughness);
		
			// https://github.com/KhronosGroup/glTF/blob/main/extensions/2.0/Khronos/KHR_lights_punctual/README.md
			float cd = dot(light.toTarget > 0 ? L : -L, dir);
			float angularAttenuation = clamp(cd * light.lightAngleScale + light.lightAngleOffset, 0.0, 1.0);
			angularAttenuation *= angularAttenuation;	
			
			float shadow_factor = 1.0;
			return light.color * light.intencity * color * angularAttenuation * shadow_factor;
		}

		vec3 calculateLights(in VertexAttribute va, in MaterialSample ms, in MaterialBRDF brdf)
		{
			vec3 Lo =  vec3(0.0);

			vec3 camera_pos = vec3(frameData.invView[3]);

			// Calculate direction from fragment to viewPosition
			vec3 V = normalize(camera_pos - va.pos);

			//Directional light
			for(uint i = 0u; i < frameData.directionalLightCount; i++)
			{
				FDirectionalLightCommit light = directional_lights[i];
				Lo += calculateDirectionalLight(light, va.pos, ms.albedo, V, ms.normal, brdf.f0, ms.metallic, ms.roughness);
			}

			//Point light
			for(uint i = 0u; i < frameData.pointLightCount; i++) 
			{
				FPointLightCommit light = point_lights[i];
				Lo += calculatePointLight(light, va.pos, ms.albedo, V, ms.normal, brdf.f0, ms.metallic, ms.roughness);
			}
			
			//Spot light
			for(uint i = 0u; i < frameData.spotLightCount; i++)
			{
				FSpotLightCommit light = spot_lights[i];
				Lo += calculateSpotlight(light, va.pos, ms.albedo, V, ms.normal, brdf.f0, ms.metallic, ms.roughness);
			}

			return Lo;
		}

		void main() 
		{
			uvec2 image_size = imageSize(write_color);

			uvec2 px = uvec2(0, 0);
			vec2 uv = vec2(0, 0);
			if(swizzle_compute_workgroups_8x8(gl_GlobalInvocationID.xy, gl_LocalInvocationID.xy, image_size, uv, px))
				return;

			vec4 pixel_color = vec4(0.35f, 0.55f, 0.7f, 1.0f);

			VisibilityBuffer visbuffer = loadVisBuffer(uv);
			if(visbuffer.vboID != meshData.vboId)
				return;

			VertexAttribute va = getVertexData(uv, visbuffer);
			FMaterial material = materials[visbuffer.matID];
			MaterialSample ms = sampleMaterial(material, va);
			MaterialBRDF brdf = calculateBRDF(ms);

			vec3 res = ms.ao * (brdf.diffuse / PI);
			res += calculateLights(va, ms, brdf);
			res += ms.emission;

			pixel_color = vec4(res, 1.0);

			imageStore(write_color, ivec2(px), pixel_color);
		}
	""";
}