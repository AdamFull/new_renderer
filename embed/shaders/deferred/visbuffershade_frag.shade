{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["shader_inputs"];

	code: 
	"""
		layout(set = 1, binding = 5) uniform sampler2D visibility_buffer;
		layout(set = 1, binding = 6) uniform sampler2D material_buffer;
		layout(set = 1, binding = 7) uniform sampler2D depth_buffer;

		layout (location = 0) in vec2 inUV;
		layout (location = 0) out vec4 outFragcolor;

		layout(std430, set = 1, binding = 8) readonly buffer VertexBuffer
		{
			RawVertex vertices[];
		} vb;

		layout(std430, set = 1, binding = 9) readonly buffer IndexBuffer
		{
			Index indices[];
		} ib;

		struct VertexAttribute
		{
			vec3 pos;
			float linearDepth;
			vec2 uv;
			vec3 normal;
			vec4 tangent;
			vec4 color;
		
			vec2 dx;
			vec2 dy;
			vec3 barycentrics;
		};

		struct BarycentricDeriv
		{
			vec3 barycentrics;
			vec3 ddx;
			vec3 ddy;
		};

		RawVertex[3] loadTriangle(in uint drawID, in uint primID)
		{
			RawVertex[3] vertices;

			// Index of the first vertex of this draw call's geometry
			uint startIndex = drawID; // There's only one draw call at the moment, so drawID should always be 0. This would work out the offset of the first vertex in the nth draw call if using MultiDraw commands. 

			// Get position in the Index Buffer of each vertex in this triangle (eg 31, 32, 33)
			uint triVert1IndexBufferPosition = (primID * 3 + 0) + startIndex;
			uint triVert2IndexBufferPosition = (primID * 3 + 1) + startIndex;
			uint triVert3IndexBufferPosition = (primID * 3 + 2) + startIndex;	

			// Now get vertex index from index buffer (eg, 17, 41, 32)
			Index triVert0Index = ib.indices[triVert1IndexBufferPosition];
			Index triVert1Index = ib.indices[triVert2IndexBufferPosition];
			Index triVert2Index = ib.indices[triVert3IndexBufferPosition];

			// Load vertex data of the 3 control points
			vertices[0] = vb.vertices[triVert0Index];
			vertices[1] = vb.vertices[triVert1Index];
			vertices[2] = vb.vertices[triVert2Index];

			return vertices;
		}


		float depthLinearization(float depth, float near, float far)
		{
			return (2.0 * near) / (far + near - depth * (far - near));
		}

		// Computes the partial derivatives of a triangle from the projected screen space vertices
		BarycentricDeriv computeBarycentrics(vec4 vertexCS0, vec4 vertexCS1, vec4 vertexCS2, vec2 pixelCS, vec2 winSize)
		{
			BarycentricDeriv ret ;

			vec3 pos0 = vertexCS0.xyz / vertexCS0.w;
			vec3 pos1 = vertexCS1.xyz / vertexCS1.w;
			vec3 pos2 = vertexCS2.xyz / vertexCS2.w;

			vec3 RcpW = 1.0 / vec3(vertexCS0.w, vertexCS1.w, vertexCS2.w);

			vec3 pos120X = vec3(pos1.x, pos2.x, pos0.x);
			vec3 pos120Y = vec3(pos1.y, pos2.y, pos0.y);
			vec3 pos201X = vec3(pos2.x, pos0.x, pos1.x);
			vec3 pos201Y = vec3(pos2.y, pos0.y, pos1.y);

			vec3 C_dx = pos201Y - pos120Y;
			vec3 C_dy = pos120X - pos201X;

			vec3 C = C_dx * (pixelCS.x - pos120X) + C_dy * (pixelCS.y - pos120Y);
			vec3 G = C * RcpW;

			float H = dot(C, RcpW);
			float rcpH = 1.0 / H;

			ret.barycentrics = G * rcpH;

			vec3 G_dx = C_dx * RcpW;
			vec3 G_dy = C_dy * RcpW;

			float H_dx = dot(C_dx, RcpW);
			float H_dy = dot(C_dy, RcpW);

			ret.ddx = (G_dx * H - G * H_dx) * (rcpH * rcpH) * ( 2.0f * winSize.x);
			ret.ddy = (G_dy * H - G * H_dy) * (rcpH * rcpH) * (-2.0f * winSize.y);

			return ret;
		}

		float interpolate(float a, float b, float c, vec3 barycentrics)
		{
			return a * barycentrics.x + b * barycentrics.y + c * barycentrics.z;
		}

		vec2 interpolate(vec2 a, vec2 b, vec2 c, vec3 barycentrics)
		{
			return a * barycentrics.x + b * barycentrics.y + c * barycentrics.z;
		}

		vec3 interpolate(vec3 a, vec3 b, vec3 c, vec3 barycentrics)
		{
			return a * barycentrics.x + b * barycentrics.y + c * barycentrics.z;
		}

		vec4 interpolate(vec4 a, vec4 b, vec4 c, vec3 barycentrics)
		{
			return a * barycentrics.x + b * barycentrics.y + c * barycentrics.z;
		}

		VertexAttribute getVertexData(vec2 uv, uint objID, uint drawID, uint triangleID)
		{
			RawVertex[3] vertices = loadTriangle(drawID, triangleID);

			// Load vertex data of the 3 vertices
			vec3 position0 = vec3(vertices[0].px, vertices[0].py, vertices[0].pz);
			vec3 position1 = vec3(vertices[1].px, vertices[1].py, vertices[1].pz);
			vec3 position2 = vec3(vertices[2].px, vertices[2].py, vertices[2].pz);

			// Load mesh model matrix
			mat4 model = modelStorage.model[objID];
			
#ifdef HAS_SKIN
#if defined(JOINTS_8BIT)
				u8vec4 joints;
				joints.x = uint8_t(vertices[0].joints_8 & 0xFF);
				joints.y = uint8_t((vertices[0].joints_8 >> 8) & 0xFF);
				joints.z = uint8_t((vertices[0].joints_8 >> 16) & 0xFF);
				joints.w = uint8_t((vertices[0].joints_8 >> 24) & 0xFF);
#elif defined(JOINTS_16BIT)
				u16vec4 joints;
#endif

				uint begin_pos = meshData.skinId * 128;
				mat4 skinMat = 
					vertices[0].wx * matrices[begin_pos + joints.x] +
					vertices[0].wy * matrices[begin_pos + joints.y] +
					vertices[0].wz * matrices[begin_pos + joints.z] +
					vertices[0].ww * matrices[begin_pos + joints.w];
		
				model = model * skinMat;
#endif // HAS_SKIN

			// Transform positions to clip space
			mat4 mvp = frameData.projection * frameData.view * model;
			vec4 clipPos0 = mvp * vec4(position0, 1.0);
			vec4 clipPos1 = mvp * vec4(position1, 1.0);
			vec4 clipPos2 = mvp * vec4(position2, 1.0);

			vec2 ndcClip = uv * 2.0 - 1.0;
			//ndcClip.y *= -1.0;

			BarycentricDeriv bary = computeBarycentrics(clipPos0, clipPos1, clipPos2, ndcClip, frameData.viewportDimension);

			VertexAttribute res;

			// INTERPOLATE POSITION
			position0 = (model * vec4(position0, 1.0)).xyz;
			position1 = (model * vec4(position1, 1.0)).xyz;
			position2 = (model * vec4(position2, 1.0)).xyz;
			res.pos = interpolate(position0, position1, position2, bary.barycentrics);
			res.linearDepth = interpolate(clipPos0.w, clipPos1.w, clipPos2.w, bary.barycentrics);
			res.barycentrics = bary.barycentrics;

			// INTERPOLATE TEXCOORD
#ifdef HAS_TEXCOORD
			vec2 uv0 = vec2(vertices[0].u, vertices[0].v);
			vec2 uv1 = vec2(vertices[1].u, vertices[1].v);
			vec2 uv2 = vec2(vertices[2].u, vertices[2].v);
			res.uv = interpolate(uv0, uv1, uv2, bary.barycentrics);
			res.dx = interpolate(uv0, uv1, uv2, bary.ddx);
			res.dy = interpolate(uv0, uv1, uv2, bary.ddy);
#endif

			// INTERPOLATE NORMAL
#ifdef HAS_NORMAL
			vec3 normal0 = vec3(vertices[0].nx, vertices[0].ny, vertices[0].nz);
			vec3 normal1 = vec3(vertices[1].nx, vertices[1].ny, vertices[1].nz);
			vec3 normal2 = vec3(vertices[2].nx, vertices[2].ny, vertices[2].nz);

			vec3 normal = interpolate(normal0, normal1, normal2, bary.barycentrics);
			res.normal = normalize(mat3(model) * normal);
#endif

			// INTERPOLATE TANGENT
#if defined(TANGENT_VEC3) || defined(TANGENT_VEC4)
			vec4 tangent0 = vec4(vertices[0].tx, vertices[0].ty, vertices[0].tz, 1.0);
			vec4 tangent1 = vec4(vertices[1].tx, vertices[1].ty, vertices[1].tz, 1.0);
			vec4 tangent2 = vec4(vertices[2].tx, vertices[2].ty, vertices[2].tz, 1.0);
#if defined(TANGENT_VEC4)
			tangent0.w = vertices[0].tw;
			tangent1.w = vertices[1].tw;
			tangent2.w = vertices[2].tw;
#endif // TANGENT_VEC4

			vec4 tangent = interpolate(tangent0, tangent1, tangent2, bary.barycentrics);
			res.tangent = vec4(normalize(mat3(model) * vec3(tangent)), tangent.w);
#endif // TANGENT

			// INTERPOLATE COLOR
#if defined(COLOR_VEC3) || defined(COLOR_VEC4)
			vec4 color0 = vec4(vertices[0].cr, vertices[0].cg, vertices[0].cb, 1.0);
			vec4 color1 = vec4(vertices[1].cr, vertices[1].cg, vertices[1].cb, 1.0);
			vec4 color2 = vec4(vertices[2].cr, vertices[2].cg, vertices[2].cb, 1.0);
#if defined(COLOR_VEC4)
			color0.a = vertices[0].ca;
			color1.a = vertices[1].ca;
			color2.a = vertices[2].ca;
#endif

			res.color = interpolate(color0, color1, color2, bary.barycentrics);
#endif // COLOR

			return res;
		}

		void main() 
		{
			// Sampling object/material buffer
			vec4 mb_raw = texture(material_buffer, inUV);

			uint packedMOID = packUnorm4x8(mb_raw);
			uint matID = packedMOID & 0xFFFF;
			uint objID = packedMOID >> 16;

			//outFragcolor = vec4(inUV, 1.f, 1.f);
			//return;

			float depth = texture(depth_buffer, inUV).r;

			if(objID != meshData.objectId || matID != meshData.materialId)
			{
				outFragcolor = vec4(0.35f, 0.55f, 0.7f, 1.0f);
				return;
			}

			vec4 pixel_color = vec4(0.35f, 0.55f, 0.7f, 1.0f);

			// Sampling visibility buffer
			vec4 vb_raw = texture(visibility_buffer, inUV);
			
			if(vb_raw != vec4(0.0))
			{
				// Unpack data
				uint packedVBID = packUnorm4x8(vb_raw);
				uint drawID = (packedVBID >> 23) & 0x000000FF;
				uint triangleID = (packedVBID & 0x007FFFFF);
				uint isTransparent = (packedVBID >> 31);
				
				VertexAttribute interpolated = getVertexData(inUV, objID, drawID, triangleID);

				pixel_color = vec4(interpolated.pos, 1.0);

				//FMaterial material = materials[matID];
				//
				//if(material.baseColorTexture != ~0u)
				//	//pixel_color = textureGrad(textures[material.baseColorTexture], texCoord, texCoordDX, texCoordDY);
				//	pixel_color = texture(textures[material.baseColorTexture], texCoord);
			}

			outFragcolor = pixel_color;
		}
	""";
}