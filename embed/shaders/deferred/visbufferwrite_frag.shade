{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack"
	];

	definitions: [];

	require_extensions: [];
	includes: [];

	code: 
	"""
		// Force early depth/stencil test
		layout(early_fragment_tests) in;

		layout(location = 0) in flat uint drawID;
		layout(location = 1) in flat uint matID;
		layout(location = 2) in flat uint objID;
		layout(location = 3) in flat uint vboID;
		
		layout(location = 0) out vec4 visBuffer;
		layout(location = 1) out vec4 matBuffer;
		layout(location = 2) out vec4 vboBuffer;

		// Engel's packing function (without alpha bit)
		uint packVBID(bool opaque, uint drawID, uint primitiveID)
		{
			uint drawID_primID = ((drawID << 23) & 0x7F800000) | (primitiveID & 0x007FFFFF);
			return (opaque) ? drawID_primID : (1 << 31) | drawID_primID;
		}

		uint packMOID(uint matID, uint objID)
		{
			return (objID << 16) | (matID & 0xFFFF);
		}

		void main() 
		{
			uint outVBID = packVBID(true, drawID, gl_PrimitiveID);
			visBuffer = unpackUnorm4x8(outVBID);

			uint outMOID = packMOID(matID, objID);
			matBuffer = unpackUnorm4x8(outMOID);

			vboBuffer = unpackUnorm4x8(vboID);
		}
	""";
}