{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_nonuniform_qualifier"
	];

	definitions: [];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];

	includes: ["shader_inputs", "util"];

	code: 
	"""
		struct PSInput 
		{
		    [[vk::location(0)]] nointerpolation uint drawID : TEXCOORD0;
		    [[vk::location(1)]] nointerpolation uint instanceID : TEXCOORD1;
		    [[vk::location(2)]] nointerpolation uint vboID : TEXCOORD2;
		    [[vk::location(3)]] float2 texCoord : TEXCOORD3;
			// float4 currentPos : TEXCOORD5; // Uncomment if needed
    		// float4 oldPos : TEXCOORD6; // Uncomment if needed
		};

		struct PSOutput 
		{
		    [[vk::location(0)]] uint vbid : SV_Target0;
		    [[vk::location(1)]] uint vbinst : SV_Target1;
		    // float2 mv : TEXCOORD3; // Uncomment if needed
		};

		// Engel's packing function (without alpha bit)
		uint packVBID(bool opaque, uint drawID, uint primitiveID)
		{
			uint drawID_primID = ((drawID << 23) & 0x7F800000) | (primitiveID & 0x007FFFFF);
			return (opaque) ? drawID_primID : (1 << 31) | drawID_primID;
		}

		uint packMOID(uint matID, uint objID)
		{
			return (objID << 16) | (matID & 0xFFFF);
		}

		// Force early depth/stencil test
		[earlydepthstencil]
		PSOutput main(PSInput input, uint primitiveID : SV_PrimitiveID) 
		{
			PSOutput output;
			
			uint32_t draw_index = input.drawID + input.instanceID;
			FGeometryBatch draw_info = GetDrawInfo(draw_index);
			FMesh mesh = GetMesh(draw_info.meshID);
			FMaterial material = GetMaterial(mesh.materialID);
			
			float opacity = material.baseColorFactor.a;
			if(material.baseColorTexture != INVALID_HANDLE)
				opacity = GlobSample2D(material.baseColorTexture, input.texCoord).a;
			
			if(material.alphaMode == 1u && opacity < material.alphaCutoff)
				discard;

			output.vbid = packVBID(true, input.drawID, primitiveID + 1u);
			output.vbinst = packMOID(input.vboID, input.instanceID);

			// Caclulate motion vectors
			//mv = EncodeVelocity(currentPos.xy - oldPos.xy);

			return output;
		}
	""";
}