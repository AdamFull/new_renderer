{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
		"GL_EXT_control_flow_attributes"
		"GL_EXT_mesh_shader"
	];
	includes: ["shader_inputs"];

	code: 
	"""
		const uint kVertexLoops = (kMaxVerticesPerMeshlet + kShaderGroupSize - 1) / kShaderGroupSize;
		const uint kTriangleLoops = (3 * kMaxTrianglesPerMeshlet + 4 * kShaderGroupSize - 1) / (kShaderGroupSize * 4);
	
		layout(local_size_x = kShaderGroupSize) in;
		layout(triangles, max_vertices = kMaxVerticesPerMeshlet, max_primitives = kMaxTrianglesPerMeshlet) out;

		struct Task
		{
			uint32_t meshletIndices[kShaderGroupSize];
		};

		taskPayloadSharedEXT Task inTask;

		layout(std140, set = 1, binding = 1) uniform GeometryBuffers
		{
			RawVertexBuffer vb;
			RawIndexBuffer ib;
			MeshletBuffer mb; 
			MeshletVertexRemapBuffer vrb;
			MeshletBoundsBuffer bb;
			MeshletTriangleBuffer tb;
		} gb;

		float3 getRandomColor(uint32_t _seed)
		{
			uint hash = (_seed ^ 61) ^ (_seed >> 16);
			hash = hash + (hash << 3);
			hash = hash ^ (hash >> 4);
			hash = hash * 0x27d4eb2d;
			hash = hash ^ (hash >> 15);
			return float3(float(hash & 255), float((hash >> 8) & 255), float((hash >> 16) & 255)) / 255.0;
		}

		void main()
		{
			//uint32_t groupIndex = gl_WorkGroupID.x;
			//uint32_t groupThreadIndex = gl_LocalInvocationID.x;
			//uint32_t meshletIndex = inTask.meshletIndices[groupIndex]; 
			//
			//FClusterInfo cluster = clusterBuffer.clusters[gl_DrawID];
			//FGeometryGPUBatch batch = batchBuffer.geometry_batches[cluster.drawID];
			//
			//float3 meshletColor = getRandomColor(meshletIndex);
			//FMeshlet meshlet = gb.mb.meshlets[meshletIndex];
			//
			//[unroll]
			//for (uint loopIndex = 0; loopIndex < kVertexLoops; ++loopIndex)
			//{
			//
			//}
		}
	""";
}