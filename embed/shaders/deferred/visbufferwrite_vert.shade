{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["shader_inputs"];

	code: 
	"""
		layout(location = 0) flat out uint drawID;
		layout(location = 1) flat out uint matID;
		layout(location = 2) flat out uint objID;
		layout(location = 3) flat out uint vboID;
		layout(location = 4) out vec2 texCoord;
		//layout(location = 5) smooth out vec4 currentPos;
		//layout(location = 6) smooth out vec4 oldPos;

		layout(push_constant) uniform UniformMeshData
		{
			uint32_t callID;
		} meshData;

		out gl_PerVertex
		{
			vec4 gl_Position;
		};

		void main() 
		{
			uint32_t draw_index = meshData.callID + gl_DrawIDARB + gl_InstanceIndex;
			FDrawMeshinfo draw_info = drawInfoBuffer.infos[draw_index];

			// Calculate skinned matrix from weights and joint indices of the current vertex
			FSceneNode node = nodeBuffer.nodes[draw_info.nodeID];
			mat4 modelMatrix = node.model;
			//mat4 oldModelMatrix = node.oldModel;

#ifdef HAS_SKIN
			if(node.skeletonID != ~0u)
			{
#if defined(JOINTS_8BIT)
				u8vec4 joints = u8vec4(uint8_t(inJoints.x * 255.0), uint8_t(inJoints.y * 255.0), uint8_t(inJoints.z * 255.0), uint8_t(inJoints.w * 255.0));
#elif defined(JOINTS_16BIT)
				u16vec4 joints = u16vec4(uint16_t(inJoints.x * 65535.0), uint16_t(inJoints.y * 65535.0), uint16_t(inJoints.z * 65535.0), uint16_t(inJoints.w * 65535.0));
#endif
				mat4 skinMat = 
					inWeights.x * matrixBuffer.matrices[node.skeletonID + joints.x] +
					inWeights.y * matrixBuffer.matrices[node.skeletonID + joints.y] +
					inWeights.z * matrixBuffer.matrices[node.skeletonID + joints.z] +
					inWeights.w * matrixBuffer.matrices[node.skeletonID + joints.w];
		
				modelMatrix = modelMatrix * skinMat;
				// oldModelMatrix = oldModelMatrix * skinMat; // TODO: should keep skinMat from prev frame
			}
#endif // HAS_SKIN

			FViewport viewport = viewportBuffer.viewports[frameData.defaultViewport];

			vec4 localPos = modelMatrix * vec4(inPosition, 1.0);
			localPos = vec4(localPos.xyz / localPos.w, 1.0);

			//currentPos = viewport.projection * frameData.view * localPos;

			//vec4 oldLocalPos = oldModelMatrix * vec4(inPosition, 1.0);
			//oldLocalPos = vec4(oldLocalPos.xyz / oldLocalPos.w, 1.0);
			
			//oldPos = viewport.projection * frameData.view * oldLocalPos;

			FMesh mesh = meshBuffer.meshes[draw_info.meshID];

			drawID = meshData.callID + gl_DrawIDARB;
			matID = mesh.materialID;
			objID = draw_info.nodeID;
			vboID = draw_info.vboID;
			texCoord = inTexCoord;

			gl_Position = viewport.projection * frameData.view * localPos;
		}
	""";
}