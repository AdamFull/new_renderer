{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["shader_inputs"];

	code: 
	"""
		struct VSOutput 
		{
		    nointerpolation uint drawID : TEXCOORD0;
		    nointerpolation uint instanceID : TEXCOORD1;
		    nointerpolation uint vboID : TEXCOORD2;
		    float2 texCoord : TEXCOORD3;
		    // float4 currentPos : TEXCOORD5; // Uncomment if needed
		    // float4 oldPos : TEXCOORD6; // Uncomment if needed
		    float4 position : SV_Position;
		};

		struct FPushConstant
		{
			uint32_t callID;
		};

		[[vk::push_constant]]
		FPushConstant meshData;

		out gl_PerVertex
		{
			vec4 gl_Position;
		};

		VSOutput main(VSMeshInput input, uint vertexID : SV_VertexID, uint instanceID : SV_InstanceID, uint drawID : SV_StartInstanceLocation) 
		{
			VSOutput output;

			uint32_t draw_index = meshData.callID + drawID + gl_InstanceIndex;
			FGeometryBatch draw_info = getDrawInfo(draw_index);

			// Calculate skinned matrix from weights and joint indices of the current vertex
			FSceneNode node = getSceneNode(draw_info.nodeID);
			float4x4 modelMatrix = getModelMatrix(node.matrixOffset);
			//float4x4 oldModelMatrix = getOldModelMatrix(node.matrixOffset)

#ifdef HAS_SKIN
			if(node.skeletonID != ~0u)
			{
#if defined(JOINTS_8BIT)
				u8vec4 joints = u8vec4(uint8_t(input.Joints.x * 255.0), uint8_t(input.Joints.y * 255.0), uint8_t(input.Joints.z * 255.0), uint8_t(input.Joints.w * 255.0));
#elif defined(JOINTS_16BIT)
				u16vec4 joints = u16vec4(uint16_t(input.Joints.x * 65535.0), uint16_t(input.Joints.y * 65535.0), uint16_t(input.Joints.z * 65535.0), uint16_t(input.Joints.w * 65535.0));
#endif
				float4x4 skinMat = 
					mul(getMatrixById(node.skeletonID, joints.x), input.Weights.x) +
					mul(getMatrixById(node.skeletonID, joints.y), input.Weights.y) +
					mul(getMatrixById(node.skeletonID, joints.z), input.Weights.z) +
					mul(getMatrixById(node.skeletonID, joints.w), input.Weights.w);
		
				modelMatrix = mul(skinMat, modelMatrix);
				// oldModelMatrix = oldModelMatrix * skinMat; // TODO: should keep skinMat from prev frame
			}
#endif // HAS_SKIN

			FCamera camera = getCamera(draw_info.cameraID);

			vec4 localPos = modelMatrix * (vec4(inPosition, 1.0));
			localPos = vec4(localPos.xyz / localPos.w, 1.0);

			float4x4 viewProjection = getViewProjectionMatrix(camera.matricesOffset);

			//currentPos = viewProjection * localPos;

			//vec4 oldLocalPos = oldModelMatrix * vec4(inPosition, 1.0);
			//oldLocalPos = vec4(oldLocalPos.xyz / oldLocalPos.w, 1.0);
			
			//oldPos = viewProjection * oldLocalPos;

			uint subsampleIndex = frameData.frameNumber % 2;
			vec2 texelSize = 0.25f / camera.size;

			vec4 clipSpacePos = viewProjection * localPos;

			//vec4 viewSpace = clipSpacePos / clipSpacePos.w;
			//viewSpace.x += ((subsampleIndex == 0) ? -texelSize.x : texelSize.x);
			//clipSpacePos = viewSpace * clipSpacePos.w;

			output.drawID = meshData.callID + gl_DrawIDARB;
			output.instanceID = gl_InstanceIndex;
			output.vboID = draw_info.vboID;
			output.texCoord = inTexCoord;

			gl_Position = clipSpacePos;
		}
	""";
}