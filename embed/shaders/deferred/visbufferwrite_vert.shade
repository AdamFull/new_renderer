{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["shader_inputs"];

	code: 
	"""
		layout(location = 0) flat out uint drawID;
		layout(location = 1) flat out uint matID;
		layout(location = 2) flat out uint objID;
		layout(location = 3) flat out uint skinID;
		layout(location = 4) flat out uint vboID;

		out gl_PerVertex
		{
			vec4 gl_Position;
		};

		void main() 
		{
			// Calculate skinned matrix from weights and joint indices of the current vertex
			mat4 modelMatrix = modelStorage.model[meshData.objectId];
#ifdef HAS_SKIN
			apply_joint_matrix(modelMatrix, inJoints, inWeights);
#endif


			vec4 localPos = modelMatrix * vec4(inPosition, 1.0);
			localPos = vec4(localPos.xyz / localPos.w, 1.0);

			drawID = gl_DrawIDARB;
			matID = meshData.materialId;
			objID = meshData.objectId;
			skinID = meshData.skinId;
			vboID = meshData.vboId;
			gl_Position = frameData.projection * frameData.view * localPos;
		}
	""";
}