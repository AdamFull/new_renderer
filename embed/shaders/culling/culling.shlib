{
	name: "culling";

	shaders: [
		{
			name: "cull_and_batch";
			sources: [
				{
					type: "compute";
					shader_name: "cull_and_batch_comp";
				}
			];
		}
	];

	compile: [
		{ 
			shader_name: "cull_and_batch";
			permutation_generator: {
				definitions: [
					{ base: "HAS_TEXCOORD" },
					{ base: "HAS_NORMAL" },
					{ base: "HAS_SKIN", var:[{ base: "JOINTS_8BIT" }, { base: "JOINTS_16BIT" }] },
					{ base: "COLOR_VEC3" },
					{ base: "COLOR_VEC4" },
					{ base: "TANGENT_VEC3" },
					{ base: "TANGENT_VEC4" },
					{ base: "INDEX_8BIT" },
					{ base: "INDEX_16BIT" }
				];
			};
		}
	];
}