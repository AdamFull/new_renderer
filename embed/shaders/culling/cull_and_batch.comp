#include "shader_inputs.glsl"

#define GROUP_SIZE 64

layout(local_size_x = GROUP_SIZE) in;

layout(push_constant) uniform PushConstant
{
	GET_PTR_T(DrawDescription) source_descriptions;
	GET_PTR_T(uint32_t) alive_bits;
} pc;

bool checkObjectInFrustum(in vec3 min_extents, in vec3 max_extents, in uint32_t frustum_offset)
{
	for (uint32_t i = 0; i < 6; i++)
	{
		vec4 edge = GetFrustumSide(frustum_offset + i);
		if (   edge.x * min_extents.x + edge.y * min_extents.y + edge.z * min_extents.z + edge.w <= 0.0f
			&& edge.x * max_extents.x + edge.y * min_extents.y + edge.z * min_extents.z + edge.w <= 0.0f
			&& edge.x * min_extents.x + edge.y * max_extents.y + edge.z * min_extents.z + edge.w <= 0.0f
			&& edge.x * max_extents.x + edge.y * max_extents.y + edge.z * min_extents.z + edge.w <= 0.0f
			&& edge.x * min_extents.x + edge.y * min_extents.y + edge.z * max_extents.z + edge.w <= 0.0f
			&& edge.x * max_extents.x + edge.y * min_extents.y + edge.z * max_extents.z + edge.w <= 0.0f
			&& edge.x * min_extents.x + edge.y * max_extents.y + edge.z * max_extents.z + edge.w <= 0.0f
			&& edge.x * max_extents.x + edge.y * max_extents.y + edge.z * max_extents.z + edge.w <= 0.0f)
			return false;
	}
	return true;
}

void main() 
{
	uint32_t global_draw_index = gl_GlobalInvocationID.x;

	if (global_draw_index >= frameData.draw_count) 
		return;

	// Compute the index of the bit in the bit array
	uint32_t word_index = global_draw_index >> 5;       // Divide by 32
	uint32_t bit_index = global_draw_index & 31;       // Modulo 32
	uint32_t bit_mask = 1u << bit_index;

	DrawDescription draw_info = pc.source_descriptions[global_draw_index].data;

	Mesh mesh = GetMesh(draw_info.mesh_index);
	SubMesh submesh = GetSubMesh(mesh.submesh_offset + draw_info.submesh_index);

	mat4 model = GetModelMatrix(mesh.matrix_offset);

	// Calculate bounding box
	BoundingBox bb = DecodeBoundingBox(mesh.ebb, model);
	BoundingBox submesh_bb = DecodeBoundingBox(submesh.ebb, model);

	Camera camera = GetCamera(draw_info.camera_index);
	if(checkObjectInFrustum(submesh_bb.min, submesh_bb.max, camera.frustum_offset))
	{
		// Instance culled
		atomicOr(pc.alive_bits[word_index].data, bit_mask);
	}
	else
	{
		// Instance skipped
		atomicAnd(pc.alive_bits[word_index].data, ~bit_mask);
	}

