#include "ptr.h"

#extension GL_KHR_memory_scope_semantics : enable
#pragma use_vulkan_memory_model
#define ACQUIRE gl_StorageSemanticsBuffer, gl_SemanticsAcquire
#define RELEASE gl_StorageSemanticsBuffer, gl_SemanticsRelease

#define N_ROWS 16
#define LG_WG_SIZE 9
#define WG_SIZE (1 << LG_WG_SIZE)
#define PARTITION_SIZE (WG_SIZE * N_ROWS)

layout(local_size_x = WG_SIZE) in;

layout(push_constant) uniform PushConstant
{
	GET_PTR_T(uint32_t) input_buffer;
    GET_PTR_T(uint32_t) output_buffer;

    uint32_t size;
} pc;

struct State
{
    uint32_t flag;
    uint32_t aggregate;
    uint32_t prefix;
};

// Perhaps this should be "nonprivate" with VKMM
layout(set = 1, binding = 0) volatile buffer StateBufer
{
    uint32_t part_counter;
    State[] state;
};

#define FLAG_NOT_READY 0u
#define FLAG_AGGREGATE_READY 1u
#define FLAG_PREFIX_READY 2u

shared uint32_t sh_scratch[WG_SIZE];
shared uint32_t sh_part_ix;
shared uint32_t sh_prefix;
shared uint32_t sh_flag;

uint32_t SampleBit(uint32_t global_id)
{
    // Handle bit array input
     uint32_t word_index = global_id >> 5;       // Divide by 32
     uint32_t bit_index = global_id & 31;       // Modulo 32
     uint32_t word = pc.input_buffer[word_index].data;
     return (word >> bit_index) & 1u;
}

void main()
{
    uint32_t local[N_ROWS];

    // Determine partition to process by atomic counter (described in Section
    // 4.4 of prefix sum paper).
    if (gl_LocalInvocationID.x == 0) 
    {
        sh_part_ix = atomicAdd(part_counter, 1);
    }
    barrier();
    uint32_t part_ix = sh_part_ix;

    uint32_t ix = part_ix * PARTITION_SIZE + gl_LocalInvocationID.x * N_ROWS;

    // TODO: gate buffer read? (evaluate whether shader check or
    // CPU-side padding is better)
    local[0] = SampleBit(ix);
    for (uint i = 1; i < N_ROWS; i++) 
    {
        local[i] = local[i - 1] + SampleBit(ix + i);
    }

    uint32_t agg = local[N_ROWS - 1];
    sh_scratch[gl_LocalInvocationID.x] = agg;
    for (uint32_t i = 0; i < LG_WG_SIZE; i++) 
    {
        barrier();
        if (gl_LocalInvocationID.x >= (1u << i)) 
        {
            uint32_t other = sh_scratch[gl_LocalInvocationID.x - (1u << i)];
            agg = other + agg;
        }
        barrier();
        sh_scratch[gl_LocalInvocationID.x] = agg;
    }

    // Publish aggregate for this partition
    if (gl_LocalInvocationID.x == WG_SIZE - 1) 
    {
        state[part_ix].aggregate = agg;
        if (part_ix == 0) 
        {
            state[0].prefix = agg;
        }
    }

    if (gl_LocalInvocationID.x == WG_SIZE - 1) 
    {
        uint flag = FLAG_AGGREGATE_READY;
        if (part_ix == 0) 
        {
            flag = FLAG_PREFIX_READY;
        }

        atomicStore(state[part_ix].flag, flag, gl_ScopeDevice, RELEASE);
    }

    uint32_t exclusive = 0u;
    if (part_ix != 0) 
    {
        // step 4 of paper: decoupled lookback
        uint32_t look_back_ix = part_ix - 1;

        uint32_t their_agg;
        uint32_t their_ix = 0;
        while (true) 
        {
            // Read flag with acquire semantics.
            if (gl_LocalInvocationID.x == WG_SIZE - 1) 
            {
                sh_flag = atomicLoad(state[look_back_ix].flag, gl_ScopeDevice, ACQUIRE);
            }
            // The flag load is done only in the last thread. However, because the
            // translation of memoryBarrierBuffer to Metal requires uniform control
            // flow, we broadcast it to all threads.
            barrier();
            uint32_t flag = sh_flag;
            barrier();

            if (flag == FLAG_PREFIX_READY) 
            {
                if (gl_LocalInvocationID.x == WG_SIZE - 1) 
                {
                    uint32_t their_prefix = state[look_back_ix].prefix;
                    exclusive = their_prefix + exclusive;
                }
                break;
            } 
            else if (flag == FLAG_AGGREGATE_READY) 
            {
                if (gl_LocalInvocationID.x == WG_SIZE - 1) 
                {
                    their_agg = state[look_back_ix].aggregate;
                    exclusive = their_agg + exclusive;
                }
                look_back_ix--;
                their_ix = 0;
                continue;
            }
            // else spin

            if (gl_LocalInvocationID.x == WG_SIZE - 1) 
            {
                // Unfortunately there's no guarantee of forward progress of other
                // workgroups, so compute a bit of the aggregate before trying again.
                // In the worst case, spinning stops when the aggregate is complete.
                uint32_t m = SampleBit(look_back_ix * PARTITION_SIZE + their_ix);
                if (their_ix == 0) 
                {
                    their_agg = m;
                } else 
                {
                    their_agg = their_agg + m;
                }
                their_ix++;
                if (their_ix == PARTITION_SIZE) 
                {
                    exclusive = their_agg + exclusive;
                    if (look_back_ix == 0) 
                    {
                        sh_flag = FLAG_PREFIX_READY;
                    } 
                    else 
                    {
                        look_back_ix--;
                        their_ix = 0;
                    }
                }
            }
            barrier();
            flag = sh_flag;
            barrier();
            if (flag == FLAG_PREFIX_READY) 
            {
                break;
            }
        }
        // step 5 of paper: compute inclusive prefix
        if (gl_LocalInvocationID.x == WG_SIZE - 1) 
        {
            uint32_t inclusive_prefix = exclusive + agg;
            sh_prefix = exclusive;
            state[part_ix].prefix = inclusive_prefix;
        }

        if (gl_LocalInvocationID.x == WG_SIZE - 1) 
        {
            atomicStore(state[part_ix].flag, FLAG_PREFIX_READY, gl_ScopeDevice, RELEASE);
        }
    }
    barrier();
    if (part_ix != 0) 
    {
        exclusive = sh_prefix;
    }

    uint32_t row = exclusive;
    if (gl_LocalInvocationID.x > 0) 
    {
        uint32_t other = sh_scratch[gl_LocalInvocationID.x - 1];
        row = row + other;
    }
    for (uint32_t i = 0; i < N_ROWS; i++) 
    {
        uint32_t m = row + local[i];
        // Make sure buffer allocation is padded appropriately.
        pc.output_buffer[ix + i].data =  m;
    }

