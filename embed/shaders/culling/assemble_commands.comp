#include "shader_inputs.glsl"

#define GROUP_SIZE 256

layout(local_size_x = GROUP_SIZE) in;

layout(push_constant) uniform PushConstant
{
	GET_PTR_T(DrawDescription) source_descriptions;
	GET_PTR_T(DrawDescription) alive_descriptions;
	GET_PTR_T(DrawIndexedIndirectData) alive_draw_commands;
	GET_PTR_T(uint32_t) alive_bits;
	GET_PTR_T(uint32_t) alive_offsets;
	GET_PTR_T(uint32_t) draw_counts;
} pc;

uint32_t SampleBit(uint32_t global_id)
{
    // Handle bit array input
     uint32_t word_index = global_id >> 5;       // Divide by 32
     uint32_t bit_index = global_id & 31;       // Modulo 32
     uint32_t word = pc.alive_bits[word_index].data;
     return (word >> bit_index) & 1u;
}

void main()
{
	uint32_t global_index = gl_GlobalInvocationID.x;

	if (global_index >= frameData.draw_count) 
		return;

	// Extract visibility bit (0 = culled, 1 = visible)
    uint32_t bit = SampleBit(global_index);

    DrawDescription draw_info = pc.source_descriptions[global_index].data;

    if (bit == 1) 
    {
		Mesh mesh = GetMesh(draw_info.mesh_index);
        SubMesh submesh = GetSubMesh(mesh.submesh_offset + draw_info.submesh_index);

        DrawIndexedIndirectData indirect_command;
		indirect_command.indexCount = submesh.index_count;
		indirect_command.instanceCount = 1;
		indirect_command.firstIndex = submesh.first_index;
		indirect_command.vertexOffset = submesh.first_vertex;
		indirect_command.firstInstance = 0;

		uint32_t inplace_offset = pc.alive_offsets[global_index].data;
		// inplece_offset should be converted in to camera space index

        pc.alive_draw_commands[inplace_offset].data = indirect_command;
		pc.alive_descriptions[inplace_offset].data = draw_info;

        atomicAdd(pc.draw_counts[draw_info.camera_index].data, 1);
    }
}