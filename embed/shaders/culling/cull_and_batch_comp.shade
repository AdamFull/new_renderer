{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA", "CULLING_DATA"];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];

	includes: ["shader_inputs"];

	code: 
	"""
		#define GROUP_SIZE 64

		layout(local_size_x = GROUP_SIZE) in;

		layout(std140, set = 1, binding = 0) uniform GeometryBuffers
		{
			RawVertexBuffer vb;
			RawIndexBuffer ib;
			MeshletBuffer mb; 
			MeshletVertexRemapBuffer vrb;
			MeshletBoundsBuffer bb;
			MeshletTriangleBuffer tb;
			MeshLodBuffer lb;

			uint32_t lastIndex;
			uint32_t lastVertex;
		};

		bool checkObjectInFrustum(in vec3 min_extents, in vec3 max_extents, in uint32_t frustumID)
		{
			for (uint32_t i = 0; i < 6; i++)
			{
				vec4 edge = frustumSidesBuffer.sides[frustumID * 6u + i];
				if (   edge.x * min_extents.x + edge.y * min_extents.y + edge.z * min_extents.z + edge.w <= 0.0f
					&& edge.x * max_extents.x + edge.y * min_extents.y + edge.z * min_extents.z + edge.w <= 0.0f
					&& edge.x * min_extents.x + edge.y * max_extents.y + edge.z * min_extents.z + edge.w <= 0.0f
					&& edge.x * max_extents.x + edge.y * max_extents.y + edge.z * min_extents.z + edge.w <= 0.0f
					&& edge.x * min_extents.x + edge.y * min_extents.y + edge.z * max_extents.z + edge.w <= 0.0f
					&& edge.x * max_extents.x + edge.y * min_extents.y + edge.z * max_extents.z + edge.w <= 0.0f
					&& edge.x * min_extents.x + edge.y * max_extents.y + edge.z * max_extents.z + edge.w <= 0.0f
					&& edge.x * max_extents.x + edge.y * max_extents.y + edge.z * max_extents.z + edge.w <= 0.0f)
					return false;
			}
			return true;
		}

		void main() 
		{
			uint global_draw_index = gl_GlobalInvocationID.x;

			if (global_draw_index >= frameData.rawCommandsCount) 
				return;

			// Sample info about current draw comand
			FGeometryBatch draw_info = rawDrawInfoBuffer.infos[global_draw_index];
			FSceneNode node = nodeBuffer.nodes[draw_info.nodeID];
			FMesh mesh = meshBuffer.meshes[draw_info.meshID];
			
			// output_index = culler_counter + draw_offset;
			
			// Calculate bounding box
			vec4 min_extents = node.model * vec4(mesh.bounds.min, 1.f);
			min_extents.xyz /= min_extents.w;

			vec4 max_extents = node.model * vec4(mesh.bounds.max, 1.f);
			max_extents.xyz /= max_extents.w;
			
			// Do frustum culling
			//if(checkObjectInFrustum(min_extents.xyz * 1.1, min_extents.xyz * 1.1, draw_info.cameraID))
			{	
				uint draw_offset = frameData.maxCommandsCount * draw_info.cameraID;
				uint culler_counter = atomicAdd(indirectCountBuffer.indices[draw_info.cameraID], 1);

				uint output_index = draw_offset + culler_counter;
				drawInfoBuffer.infos[output_index] = draw_info;
			
				// Construct  indirect draw command
				// TODO: In future thing about how to implement instancing here

				FCamera camera = cameraBuffer.cameras[draw_info.cameraID];
				mat4 view_projection = getViewProjectionMatrix(camera.matricesOffset);
				
				vec4 min_clip = view_projection * min_extents;
				vec4 max_clip = view_projection * max_extents;
				
				vec3 ndc_min = (min_clip.xyz / min_clip.w + 1.0f) * 0.5f;
				vec3 ndc_max = (max_clip.xyz / max_clip.w + 1.0f) * 0.5f;
				
				vec2 min_pos = ndc_min.xy * camera.size;
				vec2 max_pos = ndc_max.xy * camera.size;
				
				vec2 quad_size = abs(max_pos - min_pos);
				
				float quad_area = quad_size.x * quad_size.y;
				float screen_area = camera.size.x * camera.size.y;
				float lod_ratio = sqrt(screen_area / quad_area);
				uint lod_level = uint(log2(max(1.0f, lod_ratio * (mesh.lodCount - 1))));
				lod_level = clamp(lod_level, 0, mesh.lodCount - 1);

				FMeshLod lod = lb.lods[mesh.lodOffset + lod_level];
				
				FDrawIndexedIndirectData indirect_command;
				indirect_command.indexCount = lod.indexCount == 0 ? lastIndex : lod.indexCount;
				indirect_command.instanceCount = 1;
				indirect_command.firstIndex = lod.firstIndex;
				indirect_command.vertexOffset = int(lod.firstVertex);
				indirect_command.firstInstance = 0;

				indirectCommandBuffer.commands[output_index] = indirect_command;
			}
		}
	""";
}