{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];

	includes: ["shader_inputs"];

	code: 
	"""
		#define GROUP_SIZE 256

		layout(local_size_x = GROUP_SIZE) in;

		//layout(std430, set = 2, binding = 0) readonly buffer VertexBuffer
		//{
		//	RawVertex vertex_buffer[];
		//};
		//
		//layout(std430, set = 2, binding = 1) readonly buffer IndexBuffer
		//{
		//	Index index_buffer[];
		//};

		layout(std430, set = 1, binding = 10) buffer GeometryBatches
		{
			FGeometryGPUBatch geometry_batches[];
		};
		
		layout(std430, set = 1, binding = 11) buffer IndirectIndexedComands
		{
			FDrawIndexedIndirectData indexed_draw_commands[];
		};

		void main() 
		{
			uint gID = gl_GlobalInvocationID.x;

			if (gID >= frameData.rawCommandsCount) 
				return;

			indexed_draw_commands[gID].instanceCount = 1;
		}
	""";
}