{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];

	includes: ["shader_inputs"];

	code: 
	"""
		#define GROUP_SIZE 256

		layout(local_size_x = GROUP_SIZE) in;

		//layout(std430, set = 2, binding = 0) readonly buffer VertexBuffer
		//{
		//	RawVertex vertex_buffer[];
		//};
		//
		//layout(std430, set = 2, binding = 1) readonly buffer IndexBuffer
		//{
		//	Index index_buffer[];
		//};

		layout(std430, set = 1, binding = 10) readonly buffer GeometryBatches
		{
			FGeometryGPUBatch geometry_batches[];
		};
		
		layout(std430, set = 1, binding = 11) buffer IndirectIndexedComands
		{
			FDrawIndexedIndirectData indexed_draw_commands[];
		};

		layout(std430, set = 1, binding = 12) readonly buffer CullingInfo
		{
			FGeometryGPUCullInfo culling_infos[];
		};

		layout(std430, set = 1, binding = 13) readonly buffer SceneFrustum
		{
			vec4 scene_frustums[];
		};

		bool checkObjectInFrustum(in vec3 minExtents, in vec3 maxExtents, in uint32_t frustumID)
		{
			for (uint32_t i = 0; i < 6; i++)
			{
				if (   scene_frustums[frustumID * 6u + i].x * minExtents.x + scene_frustums[frustumID * 6u + i].y * minExtents.y + scene_frustums[frustumID * 6u + i].z * minExtents.z + scene_frustums[frustumID * 6u + i].w <= 0.0f
					&& scene_frustums[frustumID * 6u + i].x * maxExtents.x + scene_frustums[frustumID * 6u + i].y * minExtents.y + scene_frustums[frustumID * 6u + i].z * minExtents.z + scene_frustums[frustumID * 6u + i].w <= 0.0f
					&& scene_frustums[frustumID * 6u + i].x * minExtents.x + scene_frustums[frustumID * 6u + i].y * maxExtents.y + scene_frustums[frustumID * 6u + i].z * minExtents.z + scene_frustums[frustumID * 6u + i].w <= 0.0f
					&& scene_frustums[frustumID * 6u + i].x * maxExtents.x + scene_frustums[frustumID * 6u + i].y * maxExtents.y + scene_frustums[frustumID * 6u + i].z * minExtents.z + scene_frustums[frustumID * 6u + i].w <= 0.0f
					&& scene_frustums[frustumID * 6u + i].x * minExtents.x + scene_frustums[frustumID * 6u + i].y * minExtents.y + scene_frustums[frustumID * 6u + i].z * maxExtents.z + scene_frustums[frustumID * 6u + i].w <= 0.0f
					&& scene_frustums[frustumID * 6u + i].x * maxExtents.x + scene_frustums[frustumID * 6u + i].y * minExtents.y + scene_frustums[frustumID * 6u + i].z * maxExtents.z + scene_frustums[frustumID * 6u + i].w <= 0.0f
					&& scene_frustums[frustumID * 6u + i].x * minExtents.x + scene_frustums[frustumID * 6u + i].y * maxExtents.y + scene_frustums[frustumID * 6u + i].z * maxExtents.z + scene_frustums[frustumID * 6u + i].w <= 0.0f
					&& scene_frustums[frustumID * 6u + i].x * maxExtents.x + scene_frustums[frustumID * 6u + i].y * maxExtents.y + scene_frustums[frustumID * 6u + i].z * maxExtents.z + scene_frustums[frustumID * 6u + i].w <= 0.0f)
					return false;
			}
			return true;
		}

		void main() 
		{
			uint gID = gl_GlobalInvocationID.x;

			if (gID >= frameData.rawCommandsCount) 
				return;

			FGeometryGPUCullInfo cull_info = culling_infos[gID];
			FSceneNode node = nodes[cull_info.instanceID];
			FDrawIndexedIndirectData command = indexed_draw_commands[gID];

			vec4 minExtents = node.model * vec4(command.aabb.min, 1.f);
			minExtents = vec4(minExtents.xyz / minExtents.w, 1.0);

			vec4 maxExtents = node.model * vec4(command.aabb.max, 1.f);
			maxExtents = vec4(maxExtents.xyz / maxExtents.w, 1.0);

			indexed_draw_commands[gID].instanceCount = int(checkObjectInFrustum(minExtents.xyz, maxExtents.xyz, cull_info.frustumID));
		}
	""";
}