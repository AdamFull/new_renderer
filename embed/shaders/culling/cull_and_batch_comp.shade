{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack"
	];

	definitions: [];
	require_extensions: [];
	includes: ["shader_inputs"];

	code: 
	"""
		layout(local_size_x = 256) in;

		layout(std430, set = 1, binding = 0) buffer AtomicCounters
		{
			uint32_t indirectCommandCount;
			uint32_t batchCount;
		};

		layout(std430, set = 2, binding = 1) readonly buffer VertexBuffer
		{
			RawVertex vertex_buffer[];
		};

		layout(std430, set = 2, binding = 2) readonly buffer IndexBuffer
		{
			Index index_buffer[];
		};


		layout(std430, set = 2, binding = 3) readonly buffer RawDrawCommands
		{
			FGeometryRawCommand raw_commands[];
		};

		layout(std430, set = 2, binding = 3) buffer GeometryBatches
		{
			FGeometryDrawBatch computed_batches[];
		};
		
		layout(std430, set = 2, binding = 3) buffer IndirectIndexedComands
		{
			FDrawIndexedIndirectData indexed_draw_commands[];
		};
		
		void main() 
		{
			uint gID = gl_GlobalInvocationID.x;
		}
	""";
}