{
	lang: "hlsl";
	target_api: "vk11";

	include_directories: [ "includes" ];
	common_directories: [ "common" ];

	// Cached one time permutations
	permutation_patterns: {
		geometry_pattern: {
			permutation_generator: {
				rules: [
					{
						base: ["HAS_TEXCOORD", "HAS_NORMAL"];
						variants: [
							{ defines: ["", "INDEX_8BIT", "INDEX_16BIT"]; type: "or"; },
							{ defines: ["", "COLOR_VEC3", "COLOR_VEC4"]; type: "or"; },
							{ defines: ["TANGENT_VEC3", "TANGENT_VEC4"]; type: "or"; },
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["HAS_SKIN", "HAS_TEXCOORD", "HAS_NORMAL"];
						variants: [
							{ defines: ["", "INDEX_8BIT", "INDEX_16BIT"]; type: "or"; },
							{ defines: ["", "COLOR_VEC3", "COLOR_VEC4"]; type: "or"; },
							{ defines: ["TANGENT_VEC3", "TANGENT_VEC4"]; type: "or"; },
							{ defines: ["JOINTS_8BIT", "JOINTS_16BIT"]; type: "or"; },
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					}
				];
			};
		};
		shadows_pattern: {
			permutation_generator: {
				rules: [
					{
						base: ["HAS_TEXCOORD", "HAS_NORMAL"];
						variants: [
							{ defines: ["", "CASCADED_SHADOW", "OMNI_SHADOW"]; type: "or"; },
							{ defines: ["", "INDEX_8BIT", "INDEX_16BIT"]; type: "or"; },
							{ defines: ["", "COLOR_VEC3", "COLOR_VEC4"]; type: "or"; },
							{ defines: ["TANGENT_VEC3", "TANGENT_VEC4"]; type: "or"; },
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["HAS_SKIN", "HAS_TEXCOORD", "HAS_NORMAL"];
						variants: [
							{ defines: ["", "CASCADED_SHADOW", "OMNI_SHADOW"]; type: "or"; },
							{ defines: ["", "INDEX_8BIT", "INDEX_16BIT"]; type: "or"; },
							{ defines: ["", "COLOR_VEC3", "COLOR_VEC4"]; type: "or"; },
							{ defines: ["TANGENT_VEC3", "TANGENT_VEC4"]; type: "or"; },
							{ defines: ["JOINTS_8BIT", "JOINTS_16BIT"]; type: "or"; },
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					}
				];
			};
		};
		default_pattern: {
			permutation_generator: {
				rules: [
					{
						base: [];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					}
				];
			};
		};
		empty_pattern: {
			permutation_generator: {
				rules: [
					{
						base: [];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					}
				];
			};
		};
		downsample_pattern: {
			permutation_generator: {
				rules: [
					{
						base: [];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["FIRST_PASS"];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					}
				];
			};
		};
		mv_pattern: {
			permutation_generator: {
				rules: [
					{
						base: [];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["LOW_PRECISION_VELOCITY"];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					}
				];
			};
		};
		apply_effect_pattern: {
			permutation_generator: {
				rules: [
					{
						base: [];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["FXAA"];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["BLOOM"];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["DOF"];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["CHROMATIC_ABERRATION"];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["LENS_FLARES"];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["TONEMAP"];
						variants: [
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["MOTION_BLUR"];
						variants: [
							{ defines: ["", "LOW_PRECISION_VELOCITY"]; type: "or"; },
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					},
					{
						base: ["MOTION_BLUR"];
						variants: [
							{ defines: ["", "HORIZONTAL"]; type: "or"; },
							{ defines: ["", "BLUR_TYPE_5", "BLUR_TYPE_9", "BLUR_TYPE_13"]; type: "or"; },
							//{ defines: ["", "VENDOR_AMD", "VENDOR_NVIDIA", "VENDOR_INTEL"]; type: "or"; }
						];
					}
				];
			};
		};
	};

	build_modules: [
		"culling/culling.shlib",
		"deferred/visibilitybuffer.shlib",
		"lighting/lighting.shlib",
		"testing/testing.shlib",
		"utility/utility.shlib",
		"postprocess/postprocess.shlib"
	];
}