{
	lang: "glsl";
	target_api: "vk11";

	include_directories: [ "includes" ];
	common_directories: [ "common" ];

	// Cached one time permutations
	permutation_patterns: {
		geometry_pattern: {
			permutation_generator: {
				rules: [
					{
						base: ["HAS_TEXCOORD", "HAS_NORMAL"];
						variants: [
							{ defines: ["INDEX_8BIT", "INDEX_16BIT"]; type: "or"; },
							{ defines: ["COLOR_VEC3", "COLOR_VEC4"]; type: "or"; },
							{ defines: ["TANGENT_VEC3", "TANGENT_VEC4"]; type: "or"; }
						];
					},
					{
						base: ["HAS_SKIN", "HAS_TEXCOORD", "HAS_NORMAL"];
						variants: [
							{ defines: ["INDEX_8BIT", "INDEX_16BIT"]; type: "or"; },
							{ defines: ["COLOR_VEC3", "COLOR_VEC4"]; type: "or"; },
							{ defines: ["TANGENT_VEC3", "TANGENT_VEC4"]; type: "or"; },
							{ defines: ["JOINTS_8BIT", "JOINTS_16BIT"]; type: "or"; }
						];
					}
				];
			};
		};
		default_pattern: {
			permutations: [
				{ "defines": []; },
				{ "defines": ["EDITOR_MODE"]; }
			];
		};
		empty_pattern: {
			permutations: [
				{ "defines": []; }
			];
		};
	};

	build_modules: [
		"culling/culling.shlib",
		"deferred/visibilitybuffer.shlib",
		"lighting/lighting.shlib",
		"testing/testing.shlib",
		"utility/utility.shlib"
	];
}