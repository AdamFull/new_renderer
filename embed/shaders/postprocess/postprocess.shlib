{
	name: "postprocess";

	shaders: [
		{
			name: "ao_blur";
			sources: [
				"ao_blur_comp"
			];
		},
		{
			name: "apply_effect";
			sources: [
				"apply_effect_comp"
			];
		},
		{
			name: "bokeh";
			sources: [
				"bokeh_comp"
			];
		},
		{
			name: "brightdetect";
			sources: [
				"brightdetect_comp"
			];
		},
		{
			name: "downsample";
			sources: [
				"downsample_comp"
			];
		},
		{
			name: "filmic_smaa_tu2x";
			sources: [
				"filmic_smaa_tu2x_comp"
			];
		},
		{
			name: "generate_motion_vectors";
			sources: [
				"generate_motion_vectors_comp"
			];
		},
		{
			name: "compute_histogram";
			sources: [
				"comp_histogram_comp"
			];
		},
		{
			name: "compute_brightness";
			sources: [
				"comp_average_brightness_comp"
			];
		},
		{
			name: "upsample";
			sources: [
				"upsample_comp"
			];
		},
		{
			name: "tile_freq_classification";
			sources: [
				"tile_freq_classification_comp"
			];
		},
		{
			name: "clear_tiles";
			sources: [
				"clear_tiles_comp"
			];
		},
		{
			name: "classification_debug";
			sources: [
				"classification_debug_comp"
			];
		}
	];

	compile: [
		{ 
			shader_name: "ao_blur";
		},
		{ 
			shader_name: "apply_effect";
			permutations: [
				{ defines: []; },
				{ defines: ["FXAA"]; },
				{ defines: ["BLOOM"]; },
				{ defines: ["DOF"]; },
				{ defines: ["CHROMATIC_ABERRATION"]; },
				{ defines: ["LENS_FLARES"]; },
				{ defines: ["TONEMAP"]; },
				{ defines: ["MOTION_BLUR"]; },
				{ defines: ["MOTION_BLUR", "LOW_PRECISION_VELOCITY"]; },
				{ defines: ["GAUSSIAN_BLUR", "BLUR_TYPE_5"]; },
				{ defines: ["GAUSSIAN_BLUR", "BLUR_TYPE_9"]; },
				{ defines: ["GAUSSIAN_BLUR", "BLUR_TYPE_13"]; },
				{ defines: ["GAUSSIAN_BLUR", "HORIZONTAL", "BLUR_TYPE_5"]; },
				{ defines: ["GAUSSIAN_BLUR", "HORIZONTAL", "BLUR_TYPE_9"]; },
				{ defines: ["GAUSSIAN_BLUR", "HORIZONTAL", "BLUR_TYPE_13"]; },
			];
		},
		{ 
			shader_name: "bokeh";
		},
		{
			shader_name: "brightdetect";
		},
		{ 
			shader_name: "downsample";
			permutations: [
				{ defines: []; },
				{ defines: ["FIRST_PASS"]; }
			];
		},
		{
			shader_name: "filmic_smaa_tu2x";
		},
		{
			shader_name: "generate_motion_vectors";
			permutations: [
				{ defines: []; },
				{ defines: ["LOW_PRECISION_VELOCITY"]; }
			];
		},
		{ 
			shader_name: "compute_histogram";
		},
		{ 
			shader_name: "compute_brightness";
		},
		{ 
			shader_name: "upsample";
		},
		{
			shader_name: "tile_freq_classification";
		},
		{
			shader_name: "clear_tiles";
		},
		{
			shader_name: "classification_debug";
			permutations: [
				{ defines: []; },
				{ defines: ["HIGH_FREQUENCY"]; }
			];
		}
	];
}