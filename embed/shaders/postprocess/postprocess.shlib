{
	name: "postprocess";

	shaders: [
		{
			name: "ao_blur";
			sources: [
				{
					type: "compute";
					shader_name: "ao_blur_comp";
				}
			];
		},
		{
			name: "apply_effect";
			sources: [
				{
					type: "compute";
					shader_name: "apply_effect_comp";
				}
			];
		},
		{
			name: "bokeh";
			sources: [
				{
					type: "compute";
					shader_name: "bokeh_comp";
				}
			];
		},
		{
			name: "brightdetect";
			sources: [
				{
					type: "compute";
					shader_name: "brightdetect_comp";
				}
			];
		},
		{
			name: "downsample";
			sources: [
				{
					type: "compute";
					shader_name: "downsample_comp";
				}
			];
		},
		{
			name: "generate_motion_vectors";
			sources: [
				{
					type: "compute";
					shader_name: "generate_motion_vectors_comp";
				}
			];
		},
		{
			name: "compute_histogram";
			sources: [
				{
					type: "compute";
					shader_name: "comp_histogram_comp";
				}
			];
		},
		{
			name: "compute_brightness";
			sources: [
				{
					type: "compute";
					shader_name: "comp_average_brightness_comp";
				}
			];
		},
		{
			name: "upsample";
			sources: [
				{
					type: "compute";
					shader_name: "upsample_comp";
				}
			];
		}
	];

	compile: [
		{ 
			shader_name: "ao_blur";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "apply_effect";
			permutations: [
				{ defines: [] },
				{ defines: ["MOTION_BLUR"] },
				{ defines: ["MOTION_BLUR", "LOW_PRECISION_VELOCITY"] },
				{ defines: ["BLOOM"] },
				{ defines: ["DOF"] },
				{ defines: ["CHROMATIC_ABERRATION"] },
				{ defines: ["GAUSSIAN_BLUR", "BLUR_TYPE_5"] },
				{ defines: ["GAUSSIAN_BLUR", "BLUR_TYPE_9"] },
				{ defines: ["GAUSSIAN_BLUR", "BLUR_TYPE_13"] },
				{ defines: ["GAUSSIAN_BLUR", "HORIZONTAL", "BLUR_TYPE_5"] },
				{ defines: ["GAUSSIAN_BLUR", "HORIZONTAL", "BLUR_TYPE_9"] },
				{ defines: ["GAUSSIAN_BLUR", "HORIZONTAL", "BLUR_TYPE_13"] },
				{ defines: ["TONEMAP"] }
			];
		},
		{ 
			shader_name: "bokeh";
			pattern: "default_pattern";
		},
		{
			shader_name: "brightdetect";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "downsample";
			permutations: [
				{ defines: [] },
				{ defines: ["FIRST_PASS"] }
			];
		},
		{
			shader_name: "generate_motion_vectors";
			permutations: [
				{ defines: [] },
				{ defines: ["LOW_PRECISION_VELOCITY"] }
			];
		},
		{ 
			shader_name: "compute_histogram";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "compute_brightness";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "upsample";
			pattern: "default_pattern";
		}
	];
}