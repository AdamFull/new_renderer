{
	name: "postprocess";

	shaders: [
		{
			name: "ao_blur";
			sources: [
				"ao_blur_comp"
			];
		},
		{
			name: "apply_effect";
			sources: [
				"apply_effect_comp"
			];
		},
		{
			name: "bokeh";
			sources: [
				"bokeh_comp"
			];
		},
		{
			name: "brightdetect";
			sources: [
				"brightdetect_comp"
			];
		},
		{
			name: "downsample";
			sources: [
				"downsample_comp"
			];
		},
		{
			name: "filmic_smaa_tu2x";
			sources: [
				"filmic_smaa_tu2x_comp"
			];
		},
		{
			name: "generate_motion_vectors";
			sources: [
				"generate_motion_vectors_comp"
			];
		},
		{
			name: "compute_histogram";
			sources: [
				"comp_histogram_comp"
			];
		},
		{
			name: "compute_brightness";
			sources: [
				"comp_average_brightness_comp"
			];
		},
		{
			name: "upsample";
			sources: [
				"upsample_comp"
			];
		},
		{
			name: "tile_freq_classification";
			sources: [
				"tile_freq_classification_comp"
			];
		},
		{
			name: "clear_tiles";
			sources: [
				"clear_tiles_comp"
			];
		},
		{
			name: "classification_debug";
			sources: [
				"classification_debug_comp"
			];
		}
	];

	compile: [
		{ 
			shader_name: "ao_blur";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "apply_effect";
			pattern: "apply_effect_pattern";
		},
		{ 
			shader_name: "bokeh";
			pattern: "default_pattern";
		},
		{
			shader_name: "brightdetect";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "downsample";
			pattern: "downsample_pattern";
		},
		{
			shader_name: "filmic_smaa_tu2x";
			pattern: "default_pattern";
		},
		{
			shader_name: "generate_motion_vectors";
			pattern: "mv_pattern";
		},
		{ 
			shader_name: "compute_histogram";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "compute_brightness";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "upsample";
			pattern: "default_pattern";
		},
		{
			shader_name: "tile_freq_classification";
			pattern: "default_pattern";
		},
		{
			shader_name: "clear_tiles";
			pattern: "default_pattern";
		},
		{
			shader_name: "classification_debug";
			permutations: [
				{ defines: []; },
				{ defines: ["HIGH_FREQUENCY"]; }
			];
		}
	];
}