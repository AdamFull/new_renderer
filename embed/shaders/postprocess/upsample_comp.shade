{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: [];
	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["compute_common", "interop/base"];

	code: 
	"""
		// This shader performs upsampling on a texture,
		// as taken from Call Of Duty method, presented at ACM Siggraph 2014.
		
		// Remember to add bilinear minification filter for this texture!
		// Remember to use a floating-point texture format (for HDR)!
		// Remember to use edge clamping for this texture!

        REGISTER_UAV_SLOT(1, 0, RWTexture2D<float4>, write_color);
		REGISTER_TEXTURE_SLOT(1, 1, Texture2D<float4>, SamplerState, sampler_color);
        
        [numthreads(8, 8, 1)]
		void main(uint3 dispatchThreadID : SV_DispatchThreadID, uint3 groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID) 
		{
			uint2 image_size;
			write_color.GetDimensions(image_size.x, image_size.y);
        
        	uint2 px = uint2(0, 0);
        	float2 uv = float2(0.0, 0.0);
        	if(swizzle_workgroups_8x8(dispatchThreadID.xy, groupThreadID.xy, groupID.xy, image_size, uv, px))
                return;
        
            // The filter kernel is applied with a radius, specified in texture
            // coordinates, so that the radius will vary across mip resolutions.
            float x = postprocess.b_filter_radius;
            float y = postprocess.b_filter_radius;
        
            // Take 9 samples around current texel:
            // a - b - c
            // d - e - f
            // g - h - i
            // === ('e' is the current texel) ===
            float3 a = TEX2D(sampler_color, float2(uv.x - x, uv.y + y)).rgb;
            float3 b = TEX2D(sampler_color, float2(uv.x,     uv.y + y)).rgb;
            float3 c = TEX2D(sampler_color, float2(uv.x + x, uv.y + y)).rgb;
        
            float3 d = TEX2D(sampler_color, float2(uv.x - x, uv.y)).rgb;
            float3 e = TEX2D(sampler_color, float2(uv.x,     uv.y)).rgb;
            float3 f = TEX2D(sampler_color, float2(uv.x + x, uv.y)).rgb;
        
            float3 g = TEX2D(sampler_color, float2(uv.x - x, uv.y - y)).rgb;
            float3 h = TEX2D(sampler_color, float2(uv.x,     uv.y - y)).rgb;
            float3 i = TEX2D(sampler_color, float2(uv.x + x, uv.y - y)).rgb;
        
            // Apply weighted distribution, by using a 3x3 tent filter:
            //  1   | 1 2 1 |
            // -- * | 2 4 2 |
            // 16   | 1 2 1 |
            float3 color = e*4.0;
            color += (b+d+f+h)*2.0;
            color += (a+c+g+i);
            color *= 1.0 / 16.0;
        
            write_color[px] = float4(color, 1.0);
        }
	""";
}