{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage",
		"GL_EXT_control_flow_attributes",
		"GL_EXT_shader_atomic_float"
	];

	definitions: ["MESH_DATA", "CULLING_DATA"];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];

	includes: ["shader_inputs", "compute_common"];

	code: 
	"""
		#define TILE_SIZE 8
		#define GROUP_SIZE (TILE_SIZE * TILE_SIZE)

		layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE) in;

		layout(set = 2, binding = 0) uniform writeonly image2D write_color;
		layout(set = 1, binding = 1) uniform sampler2D sampler_color;
		REGISTER_RO_STORAGE_BUFFER(1, 2, tiles, uint32_t, packed_tiles);

		void main() 
		{
			uint tile_index = gl_WorkGroupID.x;
			uint tile_packed = packed_tiles.data[tile_index];
			uvec2 tile_pos = uvec2(tile_packed & 0xFFFF, (tile_packed >> 16) & 0xFFFF);

			uvec2 px = tile_pos * TILE_SIZE + gl_LocalInvocationID.xy;
			vec4 color = texelFetch(sampler_color, ivec2(px), 0);

			// Perform processing for high-frequency tiles
			#ifdef HIGH_FREQUENCY
			vec4 processed_color = color * vec4(1.0, 0.5, 0.5, 1.0);
			#else
			vec4 processed_color = color * vec4(0.5, 1.0, 0.5, 1.0);
			#endif

			imageStore(write_color, ivec2(px), processed_color);
		}
	""";
}