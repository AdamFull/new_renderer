{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_nonuniform_qualifier"
	];

	definitions: [];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];

	includes: ["shader_inputs", "compute_common", "util", "postprocess_common"];

	code: 
	"""
		layout(local_size_x = 8, local_size_y = 8) in;

		layout(set = 1, binding = 0) uniform writeonly image2D writeColor;
		layout(set = 1, binding = 1) uniform sampler2D samplerColor;
		layout(set = 1, binding = 2) uniform sampler2D samplerDepth;
		layout(set = 1, binding = 3) uniform sampler2D samplerBlured;
		layout(set = 1, binding = 4) uniform sampler2D bloomColor;
		layout(set = 1, binding = 5, r32f) uniform image2D avgLuminosity;

		vec2 barrelDistortion(vec2 coord, float amt) {
			vec2 cc = coord - 0.5;
			float dist = dot(cc, cc);
			return coord + cc * dist * amt;
		}
		
		float saturate( float t )
		{
			return clamp( t, 0.0, 1.0 );
		}
		
		float linterp( float t ) {
			return saturate( 1.0 - abs( 2.0*t - 1.0 ) );
		}
		
		float remap( float t, float a, float b ) {
			return saturate( (t - a) / (b - a) );
		}
		
		vec4 spectrum_offset( float t ) {
			vec4 ret;
			float lo = step(t,0.5);
			float hi = 1.0-lo;
			float w = linterp( remap( t, 1.0/6.0, 5.0/6.0 ) );
			ret = vec4(lo,1.0,hi, 1.) * vec4(1.0-w, w, 1.0-w, 1.);
		
			return pow( ret, vec4(1.0/2.2) );
		}

		vec3 convertXYZ2Yxy(vec3 _xyz)
		{
			// Reference(s):
			// - XYZ to xyY
			//   https://web.archive.org/web/20191027010144/http://www.brucelindbloom.com/index.html?Eqn_XYZ_to_xyY.html
			float inv = 1.0/dot(_xyz, vec3(1.0, 1.0, 1.0) );
			return vec3(_xyz.y, _xyz.x*inv, _xyz.y*inv);
		}
		
		vec3 convertXYZ2RGB(vec3 _xyz)
		{
			vec3 rgb;
			rgb.x = dot(vec3( 3.2404542, -1.5371385, -0.4985314), _xyz);
			rgb.y = dot(vec3(-0.9692660,  1.8760108,  0.0415560), _xyz);
			rgb.z = dot(vec3( 0.0556434, -0.2040259,  1.0572252), _xyz);
			return rgb;
		}
		
		vec3 convertRGB2XYZ(vec3 _rgb)
		{
			// Reference(s):
			// - RGB/XYZ Matrices
			//   https://web.archive.org/web/20191027010220/http://www.brucelindbloom.com/index.html?Eqn_RGB_XYZ_Matrix.html
			vec3 xyz;
			xyz.x = dot(vec3(0.4124564, 0.3575761, 0.1804375), _rgb);
			xyz.y = dot(vec3(0.2126729, 0.7151522, 0.0721750), _rgb);
			xyz.z = dot(vec3(0.0193339, 0.1191920, 0.9503041), _rgb);
			return xyz;
		}
		
		vec3 convertYxy2XYZ(vec3 _Yxy)
		{
			// Reference(s):
			// - xyY to XYZ
			//   https://web.archive.org/web/20191027010036/http://www.brucelindbloom.com/index.html?Eqn_xyY_to_XYZ.html
			vec3 xyz;
			xyz.x = _Yxy.x*_Yxy.y/_Yxy.z;
			xyz.y = _Yxy.x;
			xyz.z = _Yxy.x*(1.0 - _Yxy.y - _Yxy.z)/_Yxy.z;
			return xyz;
		}
		
		vec3 convertRGB2Yxy(vec3 _rgb)
		{
			return convertXYZ2Yxy(convertRGB2XYZ(_rgb) );
		}
		
		vec3 convertYxy2RGB(vec3 _Yxy)
		{
			return convertXYZ2RGB(convertYxy2XYZ(_Yxy) );
		}
		
		float reinhard2(float _x, float _whiteSqr)
		{
			return (_x * (1.0 + _x/_whiteSqr) ) / (1.0 + _x);
		}
		
		vec3 toGamma(vec3 _rgb, float gamma)
		{
			return pow(abs(_rgb), vec3(1.0 / gamma) );
		}
		
		void main()
		{
			uvec2 image_size = imageSize(writeColor);
		
			uvec2 px = uvec2(0, 0);
			vec2 uv = vec2(0.0, 0.0);
			if(swizzle_compute_workgroups_8x8_nv(gl_GlobalInvocationID.xy, gl_LocalInvocationID.xy, image_size, uv, px))
				return;
			
			vec3 fragcolor = texture(samplerColor, uv).rgb;
			float depth = texture(samplerDepth, uv).r;

			if(postprocess.enable_tonemap > 0)
			{
				float avgLum = imageLoad(avgLuminosity, ivec2(0, 0)).x;
		
				vec3 Yxy = convertRGB2Yxy(fragcolor);
		
				float lp = Yxy.x / (9.6 * avgLum + 0.0001);
		
				if(postprocess.tm_adaptive > 0)
					Yxy.x = reinhard2(lp, postprocess.tm_white_point);
				else
					Yxy.x = Yxy.x * pow(2.0, postprocess.tm_exposure);
		
				fragcolor = convertYxy2RGB(Yxy);
				fragcolor = toGamma(fragcolor, postprocess.tm_gamma);
			}

			if(postprocess.enable_bloom > 0)
			{
				fragcolor = mix(fragcolor,  texture(bloomColor, uv).xyz, postprocess.b_bloom_strength);
			}

			if(postprocess.enable_dof > 0)
			{
				float linear_depth = linearizeDepth(depth, frameData.nearPlane, frameData.farPlane);

				vec3 textureBlured = texture(samplerBlured, uv).rgb;

				float nearEnd = postprocess.df_near_field + postprocess.df_near_transition;
				float farStart = postprocess.df_far_field - postprocess.df_far_transition;
		
				float nearVisibility = smoothstep(postprocess.df_near_field * postprocess.df_focus_point, nearEnd * postprocess.df_focus_point, linear_depth);
				float farVisibility = 1.0f - smoothstep(farStart * postprocess.df_focus_point, postprocess.df_far_field * postprocess.df_focus_point, linear_depth);
		
				vec3 color = mix(textureBlured, fragcolor, nearVisibility);
				fragcolor = mix(textureBlured, color, farVisibility);
			}

			if(postprocess.enable_chromatic_aberration > 0)
			{
				const float reci_num_iter_f = 1.0 / float(postprocess.ca_iterations);
		
				vec4 sumcol = vec4(0.0);
				vec4 sumw = vec4(0.0);	
				for ( int i= 0; i < postprocess.ca_iterations; ++i )
				{
					float t = float(i) * reci_num_iter_f;
					vec4 w = spectrum_offset( t );
					sumw += w;
					sumcol += w * texture( samplerColor, barrelDistortion(uv, 0.6 * postprocess.ca_distortion * t ) );
				}

				fragcolor = (sumcol / sumw).rgb;
			}

			if(postprocess.enable_film_grain > 0)
			{
				float randomIntensity = fract(10000 * sin((gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * frameData.dt) * 3.14));
				fragcolor += postprocess.fg_amount * randomIntensity;
			}

			if(postprocess.enable_vignette > 0)
			{
				vec3 color = fragcolor;
				color *= 1.0f - smoothstep(postprocess.v_inner_radius, postprocess.v_outer_radius, length(uv - 0.5f));
				fragcolor = mix(fragcolor, color, postprocess.v_opacity);
			}
		
			imageStore(writeColor, ivec2(px), vec4(fragcolor, 1.0));
		}
	""";
}