{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: [];
	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["math", "compute_common", "interop/base"];

	code: 
	"""
		REGISTER_UAV_SLOT(1, 0, RWTexture2D<float4>, write_color);
		REGISTER_TEXTURE_SLOT(1, 1, Texture2D<float4>, SamplerState, sampler_color);
		
		float4 gamma_fun(float4 vector, float gamma)
		{
		    return float4(pow(vector.rgb, float3(gamma)), vector.w);
		}
		
		[numthreads(8, 8, 1)]
		void main(uint3 dispatchThreadID : SV_DispatchThreadID, uint3 groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID) 
		{
		    uint2 image_size;
			write_color.GetDimensions(image_size.x, image_size.y);

			float2 texSize = float2(image_size.xy);
		    float2 texelSize = 1.0 / texSize;
			
		    uint2 px = uint2(0, 0);
			float2 uv = float2(0.0, 0.0);
			if(swizzle_workgroups_8x8(dispatchThreadID.xy, groupThreadID.xy, groupID.xy, image_size, uv, px))
				return;
		
			float4 color = float4(0.0);
		
			for (float x = -postprocess.df_sample_count; x <= postprocess.df_sample_count; x += 1.0)
		    {
		        for (float y = -postprocess.df_sample_count; y <= postprocess.df_sample_count; y += 1.0)
		        {
		            float2 offset = float2(x, y);
		            float angle = atan(y, x);
		            float radius = sqrt(dot(offset, offset));
		
		            float paraPoly = cos(angle - (2.0 * PI * floor((PI + postprocess.df_poly * angle) / (2.0 * PI))) / postprocess.df_poly) / cos(PI / postprocess.df_poly);
		            float sdfPoly = paraPoly * radius - postprocess.df_sample_count;
		            float egdeFalloff = smoothstep(0.0, -1.0, sdfPoly);
		
		            float4 tap = TEX2D(sampler_color, uv  + texelSize.xy * offset.xy);
		
		            tap = gamma_fun(tap, 4.0);
		            color += tap * egdeFalloff;
		        }
		    }
		
		    color.rgb /= color.www;
		    color = gamma_fun(color, 1.0 / 4.0);
		
			write_color[px] = float4(color.rgb, 1.0);
		}
	""";
}