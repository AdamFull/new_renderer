#include "compute_common"
#include "interop/base"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 1) uniform writeonly image2D write_color;
layout(set = 1, binding = 2) uniform sampler2D prev_frame;
layout(set = 1, binding = 3) uniform sampler2D current_frame;

int SMAAMod2(float value) 
{
	return int(floor(mod(value, 2.0)));
}

bool SMAAXor(int a, int b) 
{
    return (a + b) % 2 == 1;
}

void main()
{
	uint sample_index = frameData.frameNumber % 2;
	uvec2 image_size = imageSize(write_color);

	uvec2 px = gl_GlobalInvocationID.xy;
	vec2 uv = (vec2(px) + vec2(0.5, 0.5)) / vec2(image_size);

	// First step
	float upsampled_position = 2.0f * float(image_size.x) * uv.x - 0.5f;
	float weight = fract(upsampled_position);

	// Second step
	int mod2 = SMAAMod2(upsampled_position);
	float current_offset = (mod2 == 1 && sample_index == 1) ? 1.0 : 0.0;
	float previous_offset = (mod2 == 1 && sample_index == 0) ? 1.0 : 0.0;

	vec2 cur_uv = uv;
	vec2 prev_uv = uv;

	cur_uv.x = (1.0 / vec2(image_size).x) * (floor(0.5 * (floor(upsampled_position) + current_offset) + 0.25) + 0.5);
	prev_uv.x = (1.0 / vec2(image_size).x) * (floor(0.5 * (floor(upsampled_position) + previous_offset) + 0.25) + 0.5);

	// Sample the textures
	vec4 current_color = texture(current_frame, cur_uv);
	vec4 previous_color = texture(prev_frame, prev_uv);

	// Step four
	bool subsample_swap = SMAAXor(int(sample_index), mod2);
	weight = subsample_swap ? weight : 1.0 - weight;

	// Output the final blended color
	vec4 out_color = mix(current_color, previous_color, weight);

	imageStore(write_color, ivec2(px), out_color);
}