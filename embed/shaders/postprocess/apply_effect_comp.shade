{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: [];
	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["compute_common", "shader_inputs", "nvidia_fxaa", "util"];

	code: 
	"""
		REGISTER_UAV_SLOT(1, 0, RWTexture2D<float4>, write_color);
		REGISTER_TEXTURE_SLOT(1, 1, Texture2D<float4>, SamplerState, sampler_color);

#if defined(MOTION_BLUR)
		REGISTER_TEXTURE_SLOT(1, 2, Texture2D<float4>, SamplerState, motion_vectors);
#elif defined(BLOOM)
		REGISTER_TEXTURE_SLOT(1, 2, Texture2D<float4>, SamplerState, bloom_color);
		REGISTER_TEXTURE_SLOT(1, 3, Texture2D<float4>, SamplerState, dirt_mask);
#elif defined(DOF)
		REGISTER_TEXTURE_SLOT(1, 2, Texture2D<float4>, SamplerState, bokeh_color);
		REGISTER_TEXTURE_SLOT(1, 3, Texture2D<float>, SamplerState, depth_image);
#elif defined(TONEMAP)
		REGISTER_IMAGE_SLOT(1, 2, Texture2D<float>, avg_luminosity);
#endif

#if defined(GAUSSIAN_BLUR)
		struct FPushConstant
		{
			float blur_scale;
		    float blur_strength;
		};

		[[vk::push_constant]]
		FPushConstant constants;
#endif
		
		[numthreads(8, 8, 1)]
		void main(uint3 dispatchThreadID : SV_DispatchThreadID, uint3 groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID) 
		{
			uint2 image_size;
			write_color.GetDimensions(image_size.x, image_size.y);
		
			uint2 px = uint2(0, 0);
			float2 uv = float2(0.0, 0.0);
			if(swizzle_workgroups_8x8(dispatchThreadID.xy, groupThreadID.xy, groupID.xy, image_size, uv, px))
				return;

			FCamera camera = GetCamera(frameData.defaultCameraID);
			
			float4 color = TEX2D(sampler_color, uv);
			float2 texel_size = 1.0 / float2(textureSize(sampler_color, 0));
#if defined(FXAA)
			if(postprocess.enable_fxaa > 0)
			{
				color.rgb = FxaaPixelShader(uv, sampler_color, postprocess.fxaa_quality, postprocess.fxaa_threshold, postprocess.fxaa_threshold_min).rgb;
			}
#elif defined(MOTION_BLUR)
			if(postprocess.enable_motion_blur > 0)
			{
				float2 velocity = TEX2D(motion_vectors, uv).rg;
				velocity = DecodeVelocity(velocity) * postprocess.mb_scale;
				velocity = min(float2(1.0), velocity);

				if(length(velocity) >= postprocess.mb_threshold)
				{
					float speed = length(velocity / texel_size);
					int n_samples = clamp(int(speed), 1, postprocess.mb_max_samples);

					for (int i = 1; i < n_samples; ++i) 
					{
						float2 offset = velocity * (float(i) / float(n_samples - 1) - 0.5);
						color += TEX2D(sampler_color, uv + offset);
					}
					color /= float(n_samples);
				}
			}
#elif defined(BLOOM)
			if(postprocess.enable_bloom > 0)
			{
				const float dirtMaskIntensity = 1.0f;
				float3 dirt = TEX2D(dirt_mask, float2(uv.x, 1.f - uv.y)).rgb * dirtMaskIntensity;
				float3 bloom = TEX2D(bloom_color, uv).rgb;
				color.rgb = lerp(color.rgb, bloom + bloom * dirt, float3(postprocess.b_bloom_strength));
			}
#elif defined(DOF)
			if(postprocess.enable_dof > 0)
			{
				float depth = TEX2D(depth_image, uv).r;
				float linear_depth = LinearizeDepth(depth, camera.zNear, camera.zFar);

				float3 texture_blured = TEX2D(bokeh_color, uv).rgb;

				float near_end = postprocess.df_near_field + postprocess.df_near_transition;
				float far_start = postprocess.df_far_field - postprocess.df_far_transition;
		
				float near_visibility = smoothstep(postprocess.df_near_field * postprocess.df_focus_point, near_end * postprocess.df_focus_point, linear_depth);
				float far_visibility = 1.0f - smoothstep(far_start * postprocess.df_focus_point, postprocess.df_far_field * postprocess.df_focus_point, linear_depth);
		
				float3 temp = lerp(texture_blured, color.rgb, near_visibility);
				color.rgb = lerp(texture_blured, temp, far_visibility);
			}
#elif defined(CHROMATIC_ABERRATION)
			if(postprocess.enable_chromatic_aberration > 0)
			{
				const float reci_num_iter_f = 1.0 / float(postprocess.ca_iterations);
		
				float4 sumcol = float4(0.0);
				float4 sumw = float4(0.0);	
				for ( int i= 0; i < postprocess.ca_iterations; ++i )
				{
					float t = float(i) * reci_num_iter_f;
					float4 w = spectrum_offset( t );
					sumw += w;
					sumcol += w * TEX2D( sampler_color, BarrelDistortion(uv, 0.6 * postprocess.ca_distortion * t ) );
				}

				color.rgb = (sumcol / sumw).rgb;
			}
#elif defined(TONEMAP)
			if(postprocess.enable_tonemap > 0)
			{
				float avgLum = avg_luminosity[uint2(0, 0)].x;
		
				float3 Yxy = convertRGB2Yxy(color.rgb);
		
				float lp = Yxy.x / (9.6 * avgLum + 0.0001);
		
				if(postprocess.tm_adaptive > 0)
					Yxy.x = reinhard2(lp, postprocess.tm_white_point);
				else
					Yxy.x = Yxy.x * pow(2.0, postprocess.tm_exposure);
		
				color.rgb = convertYxy2RGB(Yxy);
				color.rgb = toGamma(color.rgb, postprocess.tm_gamma);
			}
#elif defined(GAUSSIAN_BLUR)
#ifdef HORIZONTAL
				float2 direction = float2(constants.blur_strength, 0.0);
#else
				float2 direction = float2(0.0, constants.blur_strength);
#endif // HORIZONTAL

#if defined(BLUR_TYPE_5)
			{
				float2 off1 = float2(1.3333333333333333f) * direction;
				color += TEX2D(sampler_color, uv) * 0.29411764705882354 * constants.blur_scale;
				color += TEX2D(sampler_color, uv + (off1 / image_size)) * 0.35294117647058826f * constants.blur_scale;
				color += TEX2D(sampler_color, uv - (off1 / image_size)) * 0.35294117647058826f * constants.blur_scale;
			}
#elif defined(BLUR_TYPE_9)
			{
				float2 off1 = float2(1.3846153846f) * direction;
				float2 off2 = float2(3.2307692308f) * direction;
				color += TEX2D(sampler_color, uv) * 0.2270270270f * constants.blur_scale;
				color += TEX2D(sampler_color, uv + (off1 / image_size)) * 0.3162162162f * constants.blur_scale;
				color += TEX2D(sampler_color, uv - (off1 / image_size)) * 0.3162162162f * constants.blur_scale;
				color += TEX2D(sampler_color, uv + (off2 / image_size)) * 0.0702702703f * constants.blur_scale;
				color += TEX2D(sampler_color, uv - (off2 / image_size)) * 0.0702702703f * constants.blur_scale;
			}
#elif defined(BLUR_TYPE_13)
			{
				float2 off1 = float2(1.411764705882353f) * direction;
				float2 off2 = float2(3.2941176470588234f) * direction;
				float2 off3 = float2(5.176470588235294f) * direction;
				color += TEX2D(sampler_color, uv) * 0.1964825501511404f * constants.blur_scale;
				color += TEX2D(sampler_color, uv + (off1 / image_size)) * 0.2969069646728344f * constants.blur_scale;
				color += TEX2D(sampler_color, uv - (off1 / image_size)) * 0.2969069646728344f * constants.blur_scale;
				color += TEX2D(sampler_color, uv + (off2 / image_size)) * 0.09447039785044732f * constants.blur_scale;
				color += TEX2D(sampler_color, uv - (off2 / image_size)) * 0.09447039785044732f * constants.blur_scale;
				color += TEX2D(sampler_color, uv + (off3 / image_size)) * 0.010381362401148057f * constants.blur_scale;
				color += TEX2D(sampler_color, uv - (off3 / image_size)) * 0.010381362401148057f * constants.blur_scale;
			}
#endif // BLUR_TYPE
#elif defined(LENSFLARE)

			//float2 main = uv-pos;
			//float2 uvd = uv*(length(uv));
			//
			//float ang = atan(main.x,main.y);
			//float dist=length(main); dist = pow(dist,.1);
			//float n = noise(float2(ang*16.0,dist*32.0));
			//
			//float f0 = 1.0/(length(uv-pos)*16.0+1.0);
			//
			//f0 = f0 + f0*(sin(noise(sin(ang*2.+pos.x)*4.0 - cos(ang*3.+pos.y))*16.)*.1 + dist*.1 + .8);
			//
			//float f1 = max(0.01-pow(length(uv+1.2*pos),1.9),.0)*7.0;
			//
			//float f2 = max(1.0/(1.0+32.0*pow(length(uvd+0.8*pos),2.0)),.0)*00.25;
			//float f22 = max(1.0/(1.0+32.0*pow(length(uvd+0.85*pos),2.0)),.0)*00.23;
			//float f23 = max(1.0/(1.0+32.0*pow(length(uvd+0.9*pos),2.0)),.0)*00.21;
			//
			//float2 uvx = lerp(uv,uvd,-0.5);
			//
			//float f4 = max(0.01-pow(length(uvx+0.4*pos),2.4),.0)*6.0;
			//float f42 = max(0.01-pow(length(uvx+0.45*pos),2.4),.0)*5.0;
			//float f43 = max(0.01-pow(length(uvx+0.5*pos),2.4),.0)*3.0;
			//
			//uvx = lerp(uv,uvd,-.4);
			//
			//float f5 = max(0.01-pow(length(uvx+0.2*pos),5.5),.0)*2.0;
			//float f52 = max(0.01-pow(length(uvx+0.4*pos),5.5),.0)*2.0;
			//float f53 = max(0.01-pow(length(uvx+0.6*pos),5.5),.0)*2.0;
			//
			//uvx = lerp(uv,uvd,-0.5);
			//
			//float f6 = max(0.01-pow(length(uvx-0.3*pos),1.6),.0)*6.0;
			//float f62 = max(0.01-pow(length(uvx-0.325*pos),1.6),.0)*3.0;
			//float f63 = max(0.01-pow(length(uvx-0.35*pos),1.6),.0)*5.0;
			//
			//float3 c = float3(.0);
			//
			//c.r+=f2+f4+f5+f6; c.g+=f22+f42+f52+f62; c.b+=f23+f43+f53+f63;
			//c = c*1.3 - float3(length(uvd)*.05);
			//c+=float3(f0);
			//
			//color.rgb *= c;
#endif
		
			write_color[px] = color;
		}
	""";
}