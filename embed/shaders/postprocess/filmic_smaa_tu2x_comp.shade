{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: [];
	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];
	includes: ["compute_common", "interop/base"];

	code: 
	"""
		REGISTER_UAV_SLOT(1, 0, RWTexture2D<float4>, write_color);
		REGISTER_TEXTURE_SLOT(1, 1, Texture2D<float4>, SamplerState, prev_frame);
		REGISTER_TEXTURE_SLOT(1, 2, Texture2D<float4>, SamplerState, current_frame);

		int SMAAMod2(float value) 
		{
			return int(floor(mod(value, 2.0)));
		}

		bool SMAAXor(int a, int b) 
		{
		    return (a + b) % 2 == 1;
		}
		
		[numthreads(8, 8, 1)]
		void main(uint3 dispatchThreadID : SV_DispatchThreadID, uint3 groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID) 
		{
			uint sample_index = frameData.frameNumber % 2;

			uint2 image_size;
			write_color.GetDimensions(image_size.x, image_size.y);
		
			uint2 px = dispatchThreadID.xy;
			float2 uv = (float2(px) + float2(0.5, 0.5)) / float2(image_size);

			// First step
			float upsampled_position = 2.0f * float(image_size.x) * uv.x - 0.5f;
			float weight = frac(upsampled_position);

			// Second step
			int mod2 = SMAAMod2(upsampled_position);
			float current_offset = (mod2 == 1 && sample_index == 1) ? 1.0 : 0.0;
			float previous_offset = (mod2 == 1 && sample_index == 0) ? 1.0 : 0.0;

			float2 cur_uv = uv;
			float2 prev_uv = uv;

			cur_uv.x = (1.0 / float2(image_size).x) * (floor(0.5 * (floor(upsampled_position) + current_offset) + 0.25) + 0.5);
			prev_uv.x = (1.0 / float2(image_size).x) * (floor(0.5 * (floor(upsampled_position) + previous_offset) + 0.25) + 0.5);

			// Sample the textures
			float4 current_color = texture(current_frame, cur_uv);
			float4 previous_color = texture(prev_frame, prev_uv);

			// Step four
			bool subsample_swap = SMAAXor(int(sample_index), mod2);
			weight = subsample_swap ? weight : 1.0 - weight;

			// Output the final blended color
			float4 out_color = lerp(current_color, previous_color, weight);
		
			write_color[px] = out_color;
		}
	""";
}