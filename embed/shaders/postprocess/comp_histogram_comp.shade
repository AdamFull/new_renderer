{
	version: 460;

	enable_extensions: [
		"GL_ARB_compute_shader"
	];

	definitions: [];
	require_extensions: [];
	includes: [];

	code: 
	"""
		// Based on shader from this article https://bruop.github.io/exposure/

        #define THREADS_X 16
        #define THREADS_Y 16
        #define GROUP_SIZE THREADS_X * THREADS_Y
        
        #define EPSILON 0.005
        #define RGB_TO_LUM float3(0.2125, 0.7154, 0.0721)
      
        REGISTER_TEXTURE_SLOT(1, 0, Texture2D<float4>, SamplerState, sampler_color);
        [[vk::binding(1, 1)]] StructuredBuffer<uint> histogram;

        [[vk::binding(1, 2)]]
		    cbuffer FHistogramComputeParams : register(b4) 
		    { 
		    	  float minLogLum;
		    	  float logLumRange;
		    	  float timeCoeff;
		    	  float numPixelsX;
		    	  float numPixelsY;
		    };
        
        // Shared histogram buffer used for storing intermediate sums for each work group
        groupshared uint histogramShared[GROUP_SIZE];
        
        // For a given color and luminance range, return the histogram bin index
        uint colorToBin(float3 hdrColor, float fMinLogLum, float inverseLogLumRange) 
        {
            // Convert our RGB value to Luminance, see note for RGB_TO_LUM macro above
            float lum = dot(hdrColor, RGB_TO_LUM);
        
            // Avoid taking the log of zero
            if (lum < EPSILON) {
              return 0;
            }
        
            // Calculate the log_2 luminance and express it as a value in [0.0, 1.0]
            // where 0.0 represents the minimum luminance, and 1.0 represents the max.
            float logLum = saturate((log2(lum) - fMinLogLum) * inverseLogLumRange);
        
            // Map [0, 1] to [1, 255]. The zeroth bin is handled by the epsilon check above.
            return uint(logLum * 254.0 + 1.0);
        }
        
        [numthreads(THREADS_X, THREADS_Y, 1)]
		    void main(uint3 dispatchThreadID : SV_DispatchThreadID, uint3 groupIndex : SV_GroupIndex) 
        {
            // Initialize the bin for this thread to 0
            histogramShared[groupIndex] = 0;
            AllMemoryBarrierWithGroupSync();
        
            int2 dim = textureSize(sampler_color, 0).xy;
        
            // Ignore threads that map to areas beyond the bounds of our HDR image
            if (dispatchThreadID.x < dim.x && dispatchThreadID.y < dim.y) 
            {
              float3 hdrColor = texelFetch(sampler_color, int2(dispatchThreadID.xy) , 0).xyz;
              uint binIndex = colorToBin(hdrColor, minLogLum, 1.0 / logLumRange);
        
              // We use an atomic add to ensure we don't write to the same bin in our
            // histogram from two different threads at the same time.
              InterlockedAdd(histogramShared[binIndex], 1);
            }
        
             // Wait for all threads in the work group to reach this point before adding our
          // local histogram to the global one
            AllMemoryBarrierWithGroupSync();
        
            // Technically there's no chance that two threads write to the same bin here,
          // but different work groups might! So we still need the atomic add.
            InterlockedAdd(histogram[groupIndex], histogramShared[groupIndex]);
        }
	""";
}