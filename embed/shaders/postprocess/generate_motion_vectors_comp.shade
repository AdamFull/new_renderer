{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_nonuniform_qualifier"
	];

	definitions: [];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];

	includes: ["shader_inputs", "compute_common", "util"];

	code: 
	"""
		REGISTER_UAV_SLOT(1, 0, RWTexture2D<float2>, write_color);
		REGISTER_TEXTURE_SLOT(1, 1, Texture2D<float>, SamplerState, depth_texture);
		
		[numthreads(8, 8, 1)]
		void main(uint3 dispatchThreadID : SV_DispatchThreadID, uint3 groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID) 
		{
			uint2 image_size;
			write_color.GetDimensions(image_size.x, image_size.y);
		
			uint2 px = uint2(gl_GlobalInvocationID.xy);
			float2 uv = float2(px) / float2(image_size);;
			if(swizzle_workgroups_8x8(dispatchThreadID.xy, groupThreadID.xy, groupID.xy, image_size, uv, px))
				return;

			FCamera camera = cameraBuffer.cameras[frameData.defaultCameraID];
			float4x4 inv_view_projection = GetInvViewProjectionMatrix(camera.matricesOffset);
			float4x4 prev_view_projection = GetPrevViewProjectionMatrix(camera.matricesOffset);

			float depth = TEX2D(depth_texture, uv).r;

			float4 clipSpaceLocation;
			clipSpaceLocation.xy = uv * 2.0 - 1.0;
			clipSpaceLocation.zw = float2(depth, 1.0);
            float4 homogenousLocation = mul(clipSpaceLocation, inv_view_projection);
            float4 worldPos = homogenousLocation / homogenousLocation.w;

			float4 prevClipSpaceLocation = mul(worldPos, prev_view_projection);
			prevClipSpaceLocation /= prevClipSpaceLocation.w;

			// Use this frame's position and last frame's to compute the pixel velocity.    
			float2 velocity = (clipSpaceLocation.xy - prevClipSpaceLocation.xy) / 2.f;

			// Encode velocity
			velocity = EncodeVelocity(velocity);

			write_color[px] = velocity;
		}
	""";
}