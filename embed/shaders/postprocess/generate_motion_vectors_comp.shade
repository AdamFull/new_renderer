{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_nonuniform_qualifier"
	];

	definitions: [];

	require_extensions: [
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_EXT_shader_explicit_arithmetic_types_int8"
	];

	includes: ["shader_inputs", "compute_common", "util"];

	code: 
	"""
		layout(local_size_x = 8, local_size_y = 8) in;

		layout(set = 1, binding = 0) uniform writeonly image2D write_color;
		layout(set = 1, binding = 1) uniform sampler2D depth_texture;
		
		void main()
		{
			uvec2 image_size = imageSize(write_color);
		
			uvec2 px = uvec2(gl_GlobalInvocationID.xy);
			vec2 uv = vec2(px) / vec2(image_size);;
			if(swizzle_workgroups_8x8(gl_GlobalInvocationID.xy, gl_LocalInvocationID.xy, gl_WorkGroupID.xy, image_size, uv, px))
				return;

			FCamera camera = cameraBuffer.cameras[frameData.defaultCameraID];
			mat4 inv_view_projection = matrixBuffer.matrices[camera.matricesOffset + inv_view_projection_matrix_offset];
			mat4 prev_view_projection = matrixBuffer.matrices[camera.matricesOffset + prev_view_projection_matrix_offset];

			float depth = texture(depth_texture, uv).r;

			vec4 clipSpaceLocation;
			clipSpaceLocation.xy = uv * 2.0 - 1.0;
			clipSpaceLocation.zw = vec2(depth, 1.0);
            vec4 homogenousLocation = inv_view_projection * clipSpaceLocation;
            vec4 worldPos = homogenousLocation / homogenousLocation.w;

			vec4 prevClipSpaceLocation = prev_view_projection * worldPos;
			prevClipSpaceLocation /= prevClipSpaceLocation.w;

			// Use this frame's position and last frame's to compute the pixel velocity.    
			vec2 velocity = (clipSpaceLocation.xy - prevClipSpaceLocation.xy) / 2.f;

			// Encode velocity
			velocity = encodeVelocity(velocity);

			imageStore(write_color, ivec2(px), vec4(velocity, 1.0, 1.0));
		}
	""";
}