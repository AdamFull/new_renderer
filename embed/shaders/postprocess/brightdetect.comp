#include "compute_common"
#include "interop/base"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 1) uniform writeonly image2D write_color;
layout(set = 1, binding = 2) uniform sampler2D sampler_color;

void main()
{
	uvec2 image_size = imageSize(write_color);

	uvec2 px = uvec2(0, 0);
	vec2 uv = vec2(0.0, 0.0);
	if(swizzle_workgroups_8x8(gl_GlobalInvocationID.xy, gl_LocalInvocationID.xy, gl_WorkGroupID.xy, image_size, uv, px))
		return;

	vec3 color = texture(sampler_color, uv).rgb;
	
	float brightness = dot(color, vec3(0.2126, 0.7152, 0.0722));
	if(brightness > postprocess.b_threshold)
        imageStore(write_color, ivec2(px), vec4(color, 1.0));
    else
        imageStore(write_color, ivec2(px), vec4(0.0, 0.0, 0.0, 1.0));
}