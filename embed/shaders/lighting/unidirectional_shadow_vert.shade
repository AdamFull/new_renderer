{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA", "SHADOW_DATA"];

	require_extensions: [ 
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_ARB_shader_viewport_layer_array" 
	];
	includes: [ "shader_inputs" ];

	code: 
	"""
		layout(location = 0) out vec2 outTexcoord;
		layout(location = 1) flat out uint materialID;
		
		layout(push_constant) uniform ShadowmapData
		{
			uint32_t callID;
			uint32_t shadowIndex;
			int32_t layer;
		} shadowData;
		
		void main()
		{
			uint32_t batch_index = shadowData.callID + gl_DrawIDARB + gl_InstanceIndex;
			FGeometryGPUBatch batch = batchBuffer.geometry_batches[batch_index];

			FSceneNode node = nodeBuffer.nodes[batch.instanceID];
			mat4 modelMatrix = node.model;

#ifdef HAS_SKIN
			if(node.skin != ~0u)
			{
#if defined(JOINTS_8BIT)
				u8vec4 joints = u8vec4(uint8_t(inJoints.x * 255.0), uint8_t(inJoints.y * 255.0), uint8_t(inJoints.z * 255.0), uint8_t(inJoints.w * 255.0));
#elif defined(JOINTS_16BIT)
				u16vec4 joints = u16vec4(uint16_t(inJoints.x * 65535.0), uint16_t(inJoints.y * 65535.0), uint16_t(inJoints.z * 65535.0), uint16_t(inJoints.w * 65535.0));
#endif
				uint begin_pos = node.skin * 128;
				mat4 skinMat = 
					inWeights.x * jointsBuffer.matrices[begin_pos + joints.x] +
					inWeights.y * jointsBuffer.matrices[begin_pos + joints.y] +
					inWeights.z * jointsBuffer.matrices[begin_pos + joints.z] +
					inWeights.w * jointsBuffer.matrices[begin_pos + joints.w];
					
				modelMatrix = modelMatrix * skinMat;
			}
#endif // HAS_SKIN
		
			vec4 localPos = modelMatrix * vec4(inPosition, 1.0);
			localPos = vec4(localPos.xyz / localPos.w, 1.0);

#ifdef HAS_TEXCOORD
			outTexcoord = inTexCoord;
#endif

			mat4 viewProj;
#if defined(CASCADED_SHADOW)
			FCascadedShadowCommit shadow = cascadedShadowBuffer.cascaded_shadows[shadowData.shadowIndex];
			viewProj = shadow.cascadeViewProj[shadowData.layer];
#else
			FSpotShadowCommit shadow = spotShadowBuffer.spot_shadows[shadowData.shadowIndex];
			viewProj = shadow.viewProj;
#endif
			
			materialID = ~0u;
			if(batch.materialID != ~0u)
			{
				materialID = batch.materialID;
			}

			gl_Layer = shadowData.layer;
			gl_Position = viewProj * localPos;
		}
	""";
}