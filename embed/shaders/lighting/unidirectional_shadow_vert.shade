{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack"
	];

	definitions: ["MESH_DATA", "SHADOW_DATA"];

	require_extensions: [ 
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_ARB_shader_viewport_layer_array" 
	];
	includes: [ "shader_inputs" ];

	code: 
	"""
		layout(location = 0) out vec2 outTexcoord;
		
		layout(push_constant) uniform ShadowmapData
		{
			uint objectId;
			uint materialId;
			uint32_t shadowIndex;
			int32_t layer;
		} shadowData;
		
		void main()
		{
			FSceneNode node = nodes[shadowData.objectId];
			mat4 modelMatrix = node.model;

#ifdef HAS_SKIN
			if(node.skin != ~0u)
			{
#if defined(JOINTS_8BIT)
				u8vec4 joints = u8vec4(uint8_t(inJoints.x * 255.0), uint8_t(inJoints.y * 255.0), uint8_t(inJoints.z * 255.0), uint8_t(inJoints.w * 255.0));
#elif defined(JOINTS_16BIT)
				u16vec4 joints = u16vec4(uint16_t(inJoints.x * 65535.0), uint16_t(inJoints.y * 65535.0), uint16_t(inJoints.z * 65535.0), uint16_t(inJoints.w * 65535.0));
#endif
				uint begin_pos = node.skin * 128;
				mat4 skinMat = 
					inWeights.x * matrices[begin_pos + joints.x] +
					inWeights.y * matrices[begin_pos + joints.y] +
					inWeights.z * matrices[begin_pos + joints.z] +
					inWeights.w * matrices[begin_pos + joints.w];
					
				modelMatrix = modelMatrix * skinMat;
			}
#endif // HAS_SKIN
		
			vec4 localPos = modelMatrix * vec4(inPosition, 1.0);
			localPos = vec4(localPos.xyz / localPos.w, 1.0);

#ifdef HAS_TEXCOORD
			outTexcoord = inTexCoord;
#endif

			mat4 viewProj;
#if defined(CASCADED_SHADOW)
			FCascadedShadowCommit shadow = cascaded_shadows[shadowData.shadowIndex];
			viewProj = shadow.cascadeViewProj[shadowData.layer];
#else
			FSpotShadowCommit shadow = spot_shadows[shadowData.shadowIndex];
			viewProj = shadow.viewProj;
#endif

			gl_Layer = shadowData.layer;
			gl_Position = viewProj * localPos;
		}
	""";
}