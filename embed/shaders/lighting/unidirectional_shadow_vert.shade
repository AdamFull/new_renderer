{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_ARB_shader_draw_parameters",
		"GL_EXT_nonuniform_qualifier",
		"GL_EXT_shader_8bit_storage",
		"GL_EXT_shader_16bit_storage"
	];

	definitions: ["MESH_DATA", "SHADOW_DATA"];

	require_extensions: [ 
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_ARB_shader_viewport_layer_array" 
	];
	includes: [ "shader_inputs" ];

	code: 
	"""
		struct VSOutput 
		{
		    [[vk::location(0)]] float2 texcoord : TEXCOORD0;
		    [[vk::location(1)]] nointerpolation uint materialID : TEXCOORD1;
			[[vk::location(2)]] float4 pos : TEXCOORD2;
		    float4 position : SV_Position;
			uint layer : SV_RenderTargetArrayIndex;
		};

		struct FPushConstant
		{
			uint32_t callID;
			int32_t shadowIndex;
			int32_t layer;
		};

		[[vk::push_constant]]
		FPushConstant shadowData;
		
		VSOutput main(VSMeshInput input, uint vertexID : SV_VertexID, uint instanceID : SV_InstanceID, uint drawID : SV_StartInstanceLocation) 
		{
			VSOutput output;
			uint32_t draw_index = shadowData.callID + drawID + instanceID;
			FGeometryBatch draw_info = GetDrawInfo(draw_index);

			FSceneNode node = GetSceneNode(draw_info.nodeID);
			float4x4 modelMatrix = GetModelMatrix(node.matrixOffset);

#ifdef HAS_SKIN
			if(node.skeletonID != ~0u)
			{
#if defined(JOINTS_8BIT)
				u8vec4 joints = u8vec4(uint8_t(input.Joints.x * 255.0), uint8_t(input.Joints.y * 255.0), uint8_t(input.Joints.z * 255.0), uint8_t(input.Joints.w * 255.0));
#elif defined(JOINTS_16BIT)
				u16vec4 joints = u16vec4(uint16_t(input.Joints.x * 65535.0), uint16_t(input.Joints.y * 65535.0), uint16_t(input.Joints.z * 65535.0), uint16_t(input.Joints.w * 65535.0));
#endif
				float4x4 skinMat = 
					GetMatrixById(node.skeletonID, joints.x) * input.Weights.x +
					GetMatrixById(node.skeletonID, joints.y) * input.Weights.y +
					GetMatrixById(node.skeletonID, joints.z) * input.Weights.z +
					GetMatrixById(node.skeletonID, joints.w) * input.Weights.w;
					
				modelMatrix = mul(skinMat, modelMatrix);
			}
#endif // HAS_SKIN
		
			output.pos = mul(float4(inPosition, 1.0), modelMatrix);
			output.pos = float4(output.pos.xyz / output.pos.w, 1.0);

#ifdef HAS_TEXCOORD
			output.texcoord = inTexCoord;
#endif

			float4x4 viewProj;
#if defined(CASCADED_SHADOW)
			FCascadedShadowCommit shadow = GetCascadedShadowCommit(shadowData.shadowIndex);
			FCamera camera = GetCamera(draw_info.cameraID);
			viewProj = GetViewProjectionMatrix(camera.matricesOffset);
			output.layer = shadowData.shadowIndex * int(cascade_shadow_map_cascade_count) + shadowData.layer;
#elif defined(OMNI_SHADOW)
			FOmniShadowCommit shadow = GetOmniShadowCommit(shadowData.shadowIndex);
			FCamera camera = GetCamera(draw_info.cameraID);
			viewProj = GetViewProjectionMatrix(camera.matricesOffset);
			output.layer = shadowData.shadowIndex * 6 + shadowData.layer;
#else
			FSpotShadowCommit shadow = GetSpotShadowCommit(shadowData.shadowIndex);
			FCamera camera = GetCamera(draw_info.cameraID);
			viewProj = GetViewProjectionMatrix(camera.matricesOffset);
			output.layer = shadowData.layer;
#endif

			output.materialID = ~0u;

			FMesh mesh = GetMesh(draw_info.meshID);
			if(mesh.materialID != ~0u)
			{
				output.materialID = mesh.materialID;
			}

			
			output.position = mul(output.pos, viewProj);

			return output;
		}
	""";
}