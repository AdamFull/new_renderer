{
	name: "lighting";

	shaders: [
		{
			name: "brgflut_generator";
			sources: [
				{
					type: "compute";
					shader_name: "brdflut_comp";
				}
			];
		},
		{
			name: "irradiancecube_generator";
			sources: [
				{
					type: "compute";
					shader_name: "irradiancecube_comp";
				}
			];
		},
		{
			name: "prefilteredmap_generator";
			sources: [
				{
					type: "compute";
					shader_name: "prefilteredmap_comp";
				}
			];
		},
		{
			name: "unidirectional_shadow";
			sources: [
				{
					type: "vertex";
					shader_name: "unidirectional_shadow_vert";
				},
				{
					type: "fragment";
					shader_name: "unidirectional_shadow_frag";
				}
			];
		}
	];

	compile: [
		{ 
			shader_name: "brgflut_generator";
			permutations: [
				{ definitions: [] }
			];
		},
		{ 
			shader_name: "irradiancecube_generator";
			permutations: [
				{ definitions: [] }
			];
		},
		{ 
			shader_name: "prefilteredmap_generator";
			permutations: [
				{ definitions: [] }
			];
		},
		{ 
			shader_name: "unidirectional_shadow";
			permutation_generator: {
				definitions: [
					{ base: "HAS_TEXCOORD" },
					{ base: "HAS_NORMAL" },
					{ base: "HAS_SKIN", var:[{ base: "JOINTS_8BIT" }, { base: "JOINTS_16BIT" }] },
					{ base: "COLOR_VEC3" },
					{ base: "COLOR_VEC4" },
					{ base: "TANGENT_VEC3" },
					{ base: "TANGENT_VEC4" },
					{ base: "INDEX_8BIT" },
					{ base: "INDEX_16BIT" },
					{ base: "CASCADED_SHADOW" }
				];
			};
		}
	];
}