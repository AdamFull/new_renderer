#include "shader_inputs.glsl"
#include "compute_common.glsl"
#include "atmosphere/scattering.glsl"
#include "lighting_model.glsl"

layout(local_size_x = 13, local_size_y = 13, local_size_z = 6) in;

layout(set = 1, binding = 0) uniform writeonly imageCube write_image0;
layout(set = 1, binding = 1) uniform sampler1D sample_image0;

vec3 get_density_from_lut(float height, float delta_height)
{
    // Normalize the height to [0,1]
    float normalized_height = clamp(height / max_altitude, 0.0, 1.0);
    vec3 density = texture(sample_image0, normalized_height).rgb;
    return density * delta_height;
}

vec3 atmosphere_2(vec3 origin, vec3 direction, vec3 sunDirection, float sunIntensity)
{
    // Trace ray from viewer position to atmosphere
    vec2 intersection = raySphereIntersect(origin, direction, vec3(0.0), atmosphere_radius);

    if (intersection.x > intersection.y)
        return DefaultColor;

    float hitDistance = max(intersection.x, intersection.y);

    if (hitDistance < 0.0)
        return DefaultColor;

    hitDistance = min(hitDistance, maxScatterDistance);

    // Calculate point where ray hit a sphere
    vec3 hitPosition = direction * hitDistance;
    vec3 rayStep = hitPosition / float(integralStepCount);
    float stepHeight = length(rayStep);

    vec3 opticalDepth = vec3(0.0);
    vec3 totalRayleight = vec3(0.0);
    vec3 totalMie = vec3(0.0);

    // Solve first integral
    [[unroll]]
    for (int i = 0; i < integralStepCount; ++i)
    {
        // Calculate current ray step from VIEWER to SKY
        vec3 integralPos = origin + rayStep * float(i);
        float integralHeight = length(integralPos) - atmosphere_planet_radius;

        // Accumulate air density
        vec3 density = get_density_from_lut(integralHeight, stepHeight);
        opticalDepth += density;

        // Trace ray from current integral position to sun direction
        vec2 sunIntersection = raySphereIntersect(integralPos, -sunDirection, vec3(0.0), atmosphere_radius);
        float sunHitDistance = max(sunIntersection.x, sunIntersection.y);

        // Calculate point where ray hit a sphere
        vec3 sunHitPosition = -sunDirection * sunHitDistance;
        vec3 sunRayStep = sunHitPosition / float(lightIntegralStepCount);
        float sunStepHeight = length(sunRayStep);

        vec3 sunOpticalDepth = vec3(0.0);

        // Solve second integral
        [[unroll]]
        for (int j = 0; j < lightIntegralStepCount; ++j)
        {
            // Calculate position from INTEGRAL POSITION to SUN
            vec3 sunIntegralPos = integralPos + sunRayStep * float(j);
            float sunIntegralHeight = length(sunIntegralPos) - atmosphere_planet_radius;

            // Accumulate sun density
            vec3 sunDensity = get_density_from_lut(sunIntegralHeight, sunStepHeight);
            sunOpticalDepth += sunDensity;
        }

        // Calculate light attenuation
        vec3 attenuation = exp(-(BetaRayleigh * (opticalDepth.x + sunOpticalDepth.x) + BetaMie * (opticalDepth.y + sunOpticalDepth.y) + BetaAbsorption * (opticalDepth.z + sunOpticalDepth.z)));

        // Accumulate Rayleight and Mie color
        totalRayleight += density.x * attenuation;
        totalMie += density.y * attenuation;
    }

    // Angle between viewer direction and sun direction
    float angle = dot(normalize(direction), -sunDirection);

    // Calculate total scattered color
    vec3 rayleightColor = BaseIntencity * phaseRayleight(angle) * BetaRayleigh * totalRayleight;
    vec3 mieColor = sunIntensity * phaseMie(angle, 0.45) * BetaMie * totalMie;
    vec3 sunColor = sunIntensity * phaseMie(angle, 0.999) * BetaMie * totalMie;

    return rayleightColor + mieColor + sunColor;
}

void main() 
{
	uvec2 image_size = imageSize(write_image0);

	uvec3 px = gl_GlobalInvocationID.xyz;
	vec2 uv = (vec2(px.xy) + vec2(0.5, 0.5)) / vec2(image_size);

    if(px.x >= image_size.x || px.y >= image_size.y)
        return;

	Camera camera = GetCamera(0);
	mat4 inv_view = GetInvViewMatrix(camera.matrices_offset);

	const vec3 origin = vec3(0, atmosphere_planet_radius, 0) + vec3(inv_view[3]);

	uint sun_count = 0;
	vec3 pixel_color = vec3(0.0);

	vec3 dir_world_space = cubeDir(uv, px.z);

	for(int j = 0; j < frameData.lightCount; j++)
	{
		const LightCommit light = getLight(j);
		if(light.type == light_type_directional)
		{
			const vec3 dir_to_sun = normalize(-light.direction);
			pixel_color += atmosphere(origin, dir_world_space.xyz, -dir_to_sun, light.intencity);
			sun_count++;
		}
	}
	
	pixel_color /= float(sun_count);
	pixel_color = 1.0 - exp(-1.0 * pixel_color.rgb);

	imageStore(write_image0, ivec3(px), vec4(pixel_color, 1.0));
}