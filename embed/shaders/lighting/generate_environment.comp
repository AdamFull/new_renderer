#include "shader_inputs.glsl"
#include "atmosphere/scattering.glsl"
#include "lighting_model.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0) uniform writeonly imageCube write_image0;

void main() 
{
	uvec2 image_size = imageSize(write_image0);

	uvec2 px = gl_GlobalInvocationID.xy;
	vec2 uv = (vec2(px) + vec2(0.5, 0.5)) / vec2(image_size);

	Camera camera = GetCamera(0);
	mat4 inv_view = GetInvViewMatrix(camera.matrices_offset);

	const vec3 origin = vec3(0, atmosphere_planet_radius, 0) + vec3(inv_view[3]);

	for(int i = 0; i < 6; ++i)
	{
		uint sun_count = 0;
		vec3 pixel_color = vec3(0.0);

		vec3 dir_world_space = cubeDir(uv, i);

		for(int j = 0; j < frameData.lightCount; j++)
		{
			const LightCommit light = getLight(j);
			if(light.type == light_type_directional)
			{
				const vec3 dir_to_sun = normalize(-light.direction);
				pixel_color += atmosphere(origin, dir_world_space.xyz, -dir_to_sun, light.intencity);
				sun_count++;
			}
		}
		
		pixel_color /= float(sun_count);
		pixel_color = 1.0 - exp(-1.0 * pixel_color.rgb);

		imageStore(write_image0, ivec3(px, i), vec4(pixel_color, 1.0));
	}
}