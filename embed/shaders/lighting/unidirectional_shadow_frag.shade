{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_nonuniform_qualifier"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [ 
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_ARB_shader_viewport_layer_array" 
	];

	includes: [ "shader_inputs" ];

	code: 
	"""
		layout(location = 0) in vec2 inUV;
		layout(location = 1) flat in uint materialID;
		
		void main() 
		{
			if(materialID != ~0u)
			{
				FMaterial mat = materialBuffer.materials[materialID];
				if(mat.baseColorTexture != ~0u)
				{
					float smaple = sampleTexture2D(mat.baseColorTexture, 0, inUV).a;
					if(smaple < 1.f)
						discard;
				}
			}
		}
	""";
}