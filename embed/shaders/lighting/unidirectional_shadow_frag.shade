{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_nonuniform_qualifier"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [ 
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_ARB_shader_viewport_layer_array" 
	];

	includes: [ "shader_inputs" ];

	code: 
	"""
		layout(location = 0) in vec2 inUV;

		layout(push_constant) uniform ShadowmapData
		{
			uint objectId;
			uint materialId;
			uint32_t shadowIndex;
			int32_t layer;
		} shadowData;
		
		void main() 
		{
			if(shadowData.materialId != ~0u)
			{
				FMaterial mat = materials[shadowData.materialId];
				if(mat.baseColorTexture != ~0u)
				{
					float smaple = texture(globalTextures[mat.baseColorTexture], inUV).a;
					if(smaple < 1.f)
						discard;
				}
			}
		}
	""";
}