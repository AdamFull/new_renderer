{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack",
		"GL_EXT_nonuniform_qualifier"
	];

	definitions: ["MESH_DATA"];

	require_extensions: [ 
		"GL_EXT_buffer_reference",
		"GL_EXT_shader_explicit_arithmetic_types",
		"GL_ARB_shader_viewport_layer_array" 
	];

	includes: [ "shader_inputs" ];

	code: 
	"""
		struct PSInput 
		{
		    [[vk::location(0)]] float2 texcoord : TEXCOORD0;
		    [[vk::location(1)]] nointerpolation uint materialID : TEXCOORD1;
			[[vk::location(2)]] float4 pos : TEXCOORD2;
			float4 position : SV_Position;
		};

		struct FPushConstant
		{
			uint32_t callID;
			int32_t shadowIndex;
			int32_t layer;
		};

		[[vk::push_constant]]
		FPushConstant shadowData;
		
		float main(PSInput input) : SV_Depth
		{
			float depth = input.position.z;

			if(input.materialID != ~0u)
			{
				FMaterial mat = GetMaterial(input.materialID);
				if(mat.baseColorTexture != ~0u)
				{
					float smaple = GlobSample2D(mat.baseColorTexture, input.texcoord).a;
					if(smaple < 1.f)
						discard;
				}
			}

#if defined(OMNI_SHADOW)
			FOmniShadowCommit shadow = GetOmniShadowCommit(shadowData.shadowIndex);
			FLightCommit light = GetLight(shadow.index);

			// get distance between fragment and light source
			float lightDistance = length(input.pos.xyz - light.position);

			// map to [0;1] range by dividing by far_plane
			lightDistance = lightDistance / shadow.farPlane;

			// write this as modified depth
			depth = lightDistance;
#endif

			return depth;
		}
	""";
}