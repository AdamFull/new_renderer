{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack"
	];

	definitions: [];
	require_extensions: [];
	includes: ["compute_common", "lighting_model"];

	// TODO: add permute reject
	code: 
	"""
		REGISTER_UAV_SLOT(1, 0, RWTexture2DArray<float4>, out_color);
		REGISTER_TEXTURE_SLOT(1, 1, TextureCube<float4>, SamplerState, sampler_color);
		
		const float deltaPhi = (2.0f * PI) / 180.0f;
		const float deltaTheta = (0.5f * PI) / 64.0f;
		
		[numthreads(8, 8, 1)]
		void main(uint3 dispatchThreadID : SV_DispatchThreadID, uint3 groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID) 
		{
			uint2 image_size;
			out_color.GetDimensions(image_size.x, image_size.y);

			uint2 px = uint2(0, 0);
			float2 uv = float2(0, 0);
			if(swizzle_workgroups_8x8(dispatchThreadID.xy, groupThreadID.xy, groupID.xy, image_size, uv, px))
				return;
		
			[unroll]
			for (uint i = 0; i != 6; ++i) 
			{
				float3 N = normalize(cubeDir(uv, i));
				float3 up = float3(0.0f, 1.0f, 0.0f);
				float3 right = normalize(cross(up, N));
				up = cross(N, right);
		
				float3 colour = float3(0.0f);
				uint sampleCount = 0u;
		
				for (float phi = 0.0f; phi < TWO_PI; phi += deltaPhi) 
				{
					for (float theta = 0.0f; theta < HALF_PI; theta += deltaTheta) 
					{
						float3 tempVec = cos(phi) * right + sin(phi) * up;
						float3 sampleVector = cos(theta) * N + sin(theta) * tempVec;
						colour += TEX2D(sampler_color, sampleVector).rgb * cos(theta) * sin(theta);
						sampleCount++;
					}
				}
		
				out_color[uint2(px, i)] = float4(PI * colour / float(sampleCount), 1.0f);
			}
		}
	""";
}