#include "compute_common"
#include "shader_inputs"
#include "util"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 1) uniform writeonly image2D write_image0;
layout(set = 1, binding = 2) uniform sampler2D sample_image0;

void main()
{
	uvec2 image_size = imageSize(write_image0);

	uvec2 px = uvec2(0, 0);
	vec2 uv = vec2(0.0, 0.0);
	if(swizzle_workgroups_8x8(gl_GlobalInvocationID.xy, gl_LocalInvocationID.xy, gl_WorkGroupID.xy, image_size, uv, px))
		return;
	
	vec4 color = texture(sample_image0, uv);

	imageStore(write_image0, ivec2(px), color);
}