#include "compute_common"
#include "shader_inputs"
#include "util"

layout(local_size_x = 256) in;

layout(std140, set = 1, binding = 0) uniform bindings
{
	FGPUBufferDesc buffer_desc;
};

void main()
{
	uint index = gl_GlobalInvocationID.x;

	if (index >= buffer_desc.size) 
		return;
#if defined(INT32_BUFFER_PTR)
	PTRVAL(GET_BUFFER_POINTER(Int32Ptr, buffer_desc), index) = 0;
#elif defined(INT64_BUFFER_PTR)
	PTRVAL(GET_BUFFER_POINTER(Int64Ptr, buffer_desc), index) = 0;
#elif defined(UINT32_BUFFER_PTR)
	PTRVAL(GET_BUFFER_POINTER(UInt32Ptr, buffer_desc), index) = 0;
#elif defined(UINT64_BUFFER_PTR)
	PTRVAL(GET_BUFFER_POINTER(UInt64Ptr, buffer_desc), index) = 0;
#endif
}