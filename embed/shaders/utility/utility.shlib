{
	name: "utility";

	shaders: [
		{
			name: "copy";
			sources: [
				"screenspace_vert",
				"copy_frag"
			];
		},
		{
			name: "copy_compute";
			sources: [
				"copy_comp"
			];
		},
		{
			name: "clear_buffer";
			sources: [
				"clear_buffer_comp"
			];
		},
		{
			name: "generate_mips";
			sources: [
				"generate_mips_comp"
			];
		},
		{
			name: "generate_mips_4x";
			sources: [
				"generate_mips_4x_comp"
			];
		}
	];

	compile: [
		{ 
			shader_name: "copy";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "copy_compute";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "clear_buffer";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "generate_mips";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "generate_mips_4x";
			pattern: "default_pattern";
		}
	];
}