{
	name: "utility";

	shaders: [
		{
			name: "copy";
			sources: [
				"screenspace_vert",
				"copy_frag"
			];
		},
		{
			name: "copy_compute";
			sources: [
				"copy_comp"
			];
		},
		{
			name: "clear_buffer";
			sources: [
				"clear_buffer_comp"
			];
		},
		{
			name: "generate_mips";
			sources: [
				"generate_mips_comp"
			];
		},
		{
			name: "generate_mips_4x";
			sources: [
				"generate_mips_4x_comp"
			];
		}
	];

	compile: [
		{ 
			shader_name: "copy";
		},
		{ 
			shader_name: "copy_compute";
		},
		{ 
			shader_name: "clear_buffer";
		},
		{ 
			shader_name: "generate_mips";
		},
		{ 
			shader_name: "generate_mips_4x";
			permutations: [
				{ defines: []; },
				{ defines: ["MIP_2"]; },
				{ defines: ["MIP_2", "MIP_3"]; },
				{ defines: ["MIP_2", "MIP_3", "MIP_4"]; }
			];
		}
	];
}