{
	name: "utility";

	shaders: [
		{
			name: "copy";
			sources: [
				{
					type: "vertex";
					common: true;
					shader_name: "screenspace_vert";
				},
				{
					type: "fragment";
					shader_name: "copy_frag";
				}
			];
		},
		{
			name: "copy_compute";
			sources: [
				{
					type: "compute";
					shader_name: "copy_comp";
				}
			];
		},
		{
			name: "clear_buffer";
			sources: [
				{
					type: "compute";
					shader_name: "clear_buffer_comp";
				}
			];
		}
	];

	compile: [
		{ 
			shader_name: "copy";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "copy_compute";
			pattern: "default_pattern";
		},
		{ 
			shader_name: "clear_buffer";
			pattern: "default_pattern";
		}
	];
}