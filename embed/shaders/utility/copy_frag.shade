{
	version: 460;

	enable_extensions: [
		"GL_ARB_separate_shader_objects",
		"GL_ARB_shading_language_420pack"
	];

	definitions: [];

	require_extensions: [];
	includes: [];

	code: 
	"""
		struct VS_INPUT { [[vk::location(0)]] float2 inUV : TEXCOORD0; };
		struct PS_OUTPUT { [[vk::location(0)]] float4 outFragcolor : SV_Target; };

		REGISTER_TEXTURE_SLOT(1, 0, Texture2D<float4>, SamplerState, copy_target);

		PS_OUTPUT main(VS_INPUT input) 
		{
			PS_OUTPUT output;

			output.outFragcolor = TEX2D(copy_target, input.inUV);

			return output;
		}
	""";
}