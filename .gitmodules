[submodule "libraries/edge_framework/external/refl-cpp"]
	path = libraries/edge_framework/external/refl-cpp
	url = https://github.com/veselink1/refl-cpp.git
[submodule "libraries/edge_framework/external/spdlog"]
	path = libraries/edge_framework/external/spdlog
