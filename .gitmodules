[submodule "libraries/edge_framework/external/tinygltf"]
	path = libraries/edge_framework/external/tinygltf
	url = https://github.com/syoyo/tinygltf
[submodule "libraries/edge_framework/external/glm"]
	path = libraries/edge_framework/external/glm
	url = https://github.com/g-truc/glm.git
	branch = release-1.0.2
[submodule "libraries/edge_framework/external/vulkan"]
	path = libraries/edge_framework/external/vulkan
	url = https://github.com/KhronosGroup/Vulkan-Headers.git
	branch = vulkan-sdk-1.4.309
[submodule "libraries/edge_framework/external/vma"]
	path = libraries/edge_framework/external/vma
	url = https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
[submodule "libraries/edge_framework/external/ktx"]
	path = libraries/edge_framework/external/ktx
	url = https://github.com/KhronosGroup/KTX-Software.git
[submodule "libraries/edge_framework/external/volk"]
	path = libraries/edge_framework/external/volk
	url = https://github.com/zeux/volk.git
	branch = vulkan-sdk-1.4.309
[submodule "libraries/edge_framework/external/imgui"]
	path = libraries/edge_framework/external/imgui
	url = https://github.com/ocornut/imgui.git
	branch = docking
[submodule "libraries/edge_framework/external/glslang"]
	path = libraries/edge_framework/external/glslang
	url = https://github.com/KhronosGroup/glslang.git
	branch = vulkan-sdk-1.4.309
[submodule "libraries/edge_framework/external/spirv-cross"]
	path = libraries/edge_framework/external/spirv-cross
	url = https://github.com/KhronosGroup/SPIRV-Cross.git
	branch = vulkan-sdk-1.4.309
[submodule "libraries/edge_framework/external/stb"]
