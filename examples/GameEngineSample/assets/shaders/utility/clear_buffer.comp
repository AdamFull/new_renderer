#include "shlib.h"

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstant
{	
	GET_PTR_T(uint8_t) ptr;
	uint64_t size;
} buffer_desc;

void main()
{
	uint byte_index = gl_GlobalInvocationID.x;

	if (byte_index >= buffer_desc.size) 
		return;

	buffer_desc.ptr[byte_index].data = uint8_t(0);
}