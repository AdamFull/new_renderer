#include "compute_common.glsl"
#include "util.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform writeonly image2D image0;
layout(binding = 1) uniform texture2D texture0;
layout(binding = 2) uniform sampler sampler0;

void main()
{
	uvec2 image_size = imageSize(image0);

	uvec2 px = uvec2(0, 0);
	vec2 uv = vec2(0.0, 0.0);
	if(swizzle_workgroups_8x8(gl_GlobalInvocationID.xy, gl_LocalInvocationID.xy, gl_WorkGroupID.xy, image_size, uv, px))
		return;
	
	vec4 color = texture(sampler2D(texture0, sampler0), uv);

	imageStore(image0, ivec2(px), color);
}