#include "shader_inputs.glsl"
#include "compute_common.glsl"
#include "lighting_model.glsl"

//#define USE_TGSM
#define TILE_SIZE 8

#ifdef USE_TGSM
#define THREAD_GROUP_SIZE (TILE_SIZE * TILE_SIZE)
#define TGSM_ROW_SIZE (TILE_SIZE + 2)
#define TGSM_BUFFER_SIZE (TGSM_ROW_SIZE * TGSM_ROW_SIZE)

shared float tgsm_depth[TGSM_BUFFER_SIZE];
#define GET_TGSM_DEPTH(gs_location, offset) tgsm_depth[gs_location + flatten_2d(uvec2(offset), TGSM_ROW_SIZE)]
#endif

layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE) in;

layout(set = 1, binding = 1) uniform sampler2D sample_image0;
layout(set = 1, binding = 2) restrict uniform writeonly image2D write_image0;

const int AO_SAMPLE_COUNT = 16;
const float AO_RADIUS = 0.2f;
const float AO_DEPTH_THRESHOLD = 0.0025f;
const float AO_POWER = 1.2f;

#ifdef USE_TGSM
#define TEXEL_FETCH(offset) GET_TGSM_DEPTH(gs_location, offset)
#else
#define TEXEL_FETCH(offset) texelFetch(sample_image0, ivec2(px) + offset, 0).r
#endif

void main() {
	uvec2 px;
	vec2 uv;

	const uvec2 image_size = imageSize(write_image0);
	const vec2 texel_size = 1.0 / vec2(image_size);

	const Camera camera = GetCamera(0);
	const mat4 inv_proj = GetInvProjectionMatrix(camera.matrices_offset);

	const uvec2 local_id = gl_LocalInvocationID.xy;
	const uvec2 global_id = gl_GlobalInvocationID.xy;

#ifdef USE_TGSM
	const int gs_location = int(flatten_2d(local_id, TGSM_ROW_SIZE)) + TGSM_ROW_SIZE + 1;
	const int gs_prefetch_location_0 = int(flatten_2d(local_id, TILE_SIZE));
	const int gs_prefetch_location_1 = gs_prefetch_location_0 + TGSM_BUFFER_SIZE - THREAD_GROUP_SIZE;

	const ivec2 group_start = ivec2(global_id.x & -8, global_id.y & -8);

	ivec2 prefetch_location_0 = group_start - 1 + ivec2(gs_prefetch_location_0 % 10, gs_prefetch_location_0 / 10);
	ivec2 prefetch_location_1 = group_start - 1 + ivec2(gs_prefetch_location_1 % 10, gs_prefetch_location_1 / 10);

	tgsm_depth[gs_prefetch_location_0] = texelFetch(sample_image0, prefetch_location_0, 0).r;
	tgsm_depth[gs_prefetch_location_1] = texelFetch(sample_image0, prefetch_location_1, 0).r;

	groupMemoryBarrier();
	barrier();

	px = global_id;
	uv = (vec2(px) + 0.5) * texel_size;
#else
	if(swizzle_workgroups_8x8(global_id, local_id, gl_WorkGroupID.xy, image_size, uv, px))
		return;
#endif

	const float c0 = TEXEL_FETCH(ivec2( 0,  0));
    const float l2 = TEXEL_FETCH(ivec2(-2,  0));
    const float l1 = TEXEL_FETCH(ivec2(-1,  0));
    const float r1 = TEXEL_FETCH(ivec2( 1,  0));
    const float r2 = TEXEL_FETCH(ivec2( 2,  0));
    const float b2 = TEXEL_FETCH(ivec2( 0, -2));
    const float b1 = TEXEL_FETCH(ivec2( 0, -1));
    const float t1 = TEXEL_FETCH(ivec2( 0,  1));
    const float t2 = TEXEL_FETCH(ivec2( 0,  2));

    // depth slope estimates
    const float dl = abs(l1 * l2 / (2.0 * l2 - l1) - c0);
    const float dr = abs(r1 * r2 / (2.0 * r2 - r1) - c0);
    const float db = abs(b1 * b2 / (2.0 * b2 - b1) - c0);
    const float dt = abs(t1 * t2 / (2.0 * t2 - t1) - c0);

     // reconstruct centre position
    const vec3 ce = position_from_depth(uv, c0, inv_proj);

    // choose better neighbor in X and Y
    const vec3 dpdx = (dl < dr)
        ?  ce - position_from_depth(uv - vec2(texel_size.x, 0.0), l1, inv_proj)
        : -ce + position_from_depth(uv + vec2(texel_size.x, 0.0), r1, inv_proj);

    const vec3 dpdy = (db < dt)
        ?  ce - position_from_depth(uv - vec2(0.0, texel_size.y), b1, inv_proj)
        : -ce + position_from_depth(uv + vec2(0.0, texel_size.y), t1, inv_proj);

    const vec3 normal = normalize(cross(dpdx, dpdy));

	float depth = textureLod(sample_image0, uv, 0).r;
	const vec3 view_pos = position_from_depth(uv, depth, inv_proj);

	uint seed = rng_make_seed(global_id, image_size, frameData.frameNumber);
	const vec3 random_vec = rng_random_vec3_01(seed) * 2.0f - 1.0f;

	const vec3 tangent = normalize(random_vec - normal * dot(random_vec, normal));
	const vec3 bitangent = cross(tangent, normal);
	const mat3 tbn = mat3(tangent, bitangent, normal);

	const mat4 projection = GetProjectionMatrix(camera.matrices_offset);

	float occlusion = 0;
	for(int i = 0; i < AO_SAMPLE_COUNT; ++i) {
		const vec2 hamm = hammersley2d(i, AO_SAMPLE_COUNT);

		const float ao_range = AO_RADIUS * mix(0.2, 1.0, rng_random_01(seed));
		const vec3 hemisphere = hemispherepoint_uniform(hamm.x, hamm.y);
		const vec3 cone = tbn * hemisphere;
		const vec3 vpos = view_pos + cone * ao_range;

		vec4 new_tex_coord = projection * vec4(vpos, 1.0);
		new_tex_coord.xyz /= new_tex_coord.w;
		new_tex_coord.xy = clip_to_uv(new_tex_coord.xy);

		if (new_tex_coord.x < 0.0 || new_tex_coord.x > 1.0 || new_tex_coord.y < 0.0 || new_tex_coord.y > 1.0)
            continue;

		const float sample_depth = textureLod(sample_image0, new_tex_coord.xy, 0).r;
		const float linear_depth = -linearize_depth(sample_depth, camera.z_near, camera.z_far);
		const float range_check = smoothstep(0.0f, 1.0f, AO_RADIUS / abs(view_pos.z - linear_depth));
		occlusion += float(linear_depth >= vpos.z + AO_DEPTH_THRESHOLD) * range_check;
	}

	occlusion = occlusion / AO_SAMPLE_COUNT;
	occlusion = pow(clamp(1.0f - occlusion, 0.0, 1.0), AO_POWER);

	imageStore(write_image0, ivec2(px), vec4(occlusion, 0.0, 0.0, 1.0));
}