#include "math.glsl"
#include "compute_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform writeonly image2D image0;
layout(binding = 1) uniform texture2D texture0;
layout(binding = 2) uniform sampler sampler0;

layout(push_constant) uniform PushConstant {
    int enabled;
    int sample_count;
    int polygon_count;
} pc;

vec4 gamma_fun(vec4 vector, float gamma)
{
    return vec4(pow(vector.rgb, vec3(gamma)), vector.w);
}

void main()
{
    if(pc.enabled < 0) {
        return;
    }

    uvec2 image_size = imageSize(image0);
	vec2 texSize = vec2(image_size.xy);
    vec2 texelSize = 1.0 / texSize;
	
    uvec2 px = uvec2(0, 0);
	vec2 uv = vec2(0.0, 0.0);
	if(swizzle_workgroups_8x8(gl_GlobalInvocationID.xy, gl_LocalInvocationID.xy, gl_WorkGroupID.xy, image_size, uv, px))
		return;

	vec4 color = vec4(0.0);

	for (float x = -pc.sample_count; x <= pc.sample_count; x += 1.0)
    {
        for (float y = -pc.sample_count; y <= pc.sample_count; y += 1.0)
        {
            vec2 offset = vec2(x, y);
            float angle = atan(y, x);
            float radius = sqrt(dot(offset, offset));

            float paraPoly = cos(angle - (TWO_PI * floor((PI + pc.polygon_count * angle) / TWO_PI)) / pc.polygon_count) / cos(PI / pc.polygon_count);
            float sdfPoly = paraPoly * radius - pc.sample_count;
            float egdeFalloff = smoothstep(0.0, -1.0, sdfPoly);

            vec4 tap = texture(sampler2D(texture0, sampler0), uv  + texelSize.xy * offset.xy);

            tap = gamma_fun(tap, 4.0);
            color += tap * egdeFalloff;
        }
    }

    color.rgb /= color.www;
    color = gamma_fun(color, 1.0 / 4.0);

	imageStore(image0, ivec2(px), vec4(color.rgb, 1.0));
}