#include "compute_common.glsl"

// This shader performs upsampling on a texture,
// as taken from Call Of Duty method, presented at ACM Siggraph 2014.

// Remember to add bilinear minification filter for this texture!
// Remember to use a floating-point texture format (for HDR)!
// Remember to use edge clamping for this texture!

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform writeonly image2D image0;
layout(binding = 1) uniform texture2D texture0;
layout(binding = 2) uniform sampler sampler0;

layout(push_constant) uniform PushConstant {
	float filter_radius;
} pc;

void main()
{
    uvec2 image_size = imageSize(image0);

	uvec2 px = uvec2(0, 0);
	vec2 uv = vec2(0.0, 0.0);
	if(swizzle_workgroups_8x8(gl_GlobalInvocationID.xy, gl_LocalInvocationID.xy, gl_WorkGroupID.xy, image_size, uv, px))
        return;

    // The filter kernel is applied with a radius, specified in texture
    // coordinates, so that the radius will vary across mip resolutions.
    float x = pc.filter_radius;
    float y = pc.filter_radius;

    // Take 9 samples around current texel:
    // a - b - c
    // d - e - f
    // g - h - i
    // === ('e' is the current texel) ===
    vec3 a = texture(sampler2D(texture0, sampler0), vec2(uv.x - x, uv.y + y)).rgb;
    vec3 b = texture(sampler2D(texture0, sampler0), vec2(uv.x,     uv.y + y)).rgb;
    vec3 c = texture(sampler2D(texture0, sampler0), vec2(uv.x + x, uv.y + y)).rgb;

    vec3 d = texture(sampler2D(texture0, sampler0), vec2(uv.x - x, uv.y)).rgb;
    vec3 e = texture(sampler2D(texture0, sampler0), vec2(uv.x,     uv.y)).rgb;
    vec3 f = texture(sampler2D(texture0, sampler0), vec2(uv.x + x, uv.y)).rgb;

    vec3 g = texture(sampler2D(texture0, sampler0), vec2(uv.x - x, uv.y - y)).rgb;
    vec3 h = texture(sampler2D(texture0, sampler0), vec2(uv.x,     uv.y - y)).rgb;
    vec3 i = texture(sampler2D(texture0, sampler0), vec2(uv.x + x, uv.y - y)).rgb;

    // Apply weighted distribution, by using a 3x3 tent filter:
    //  1   | 1 2 1 |
    // -- * | 2 4 2 |
    // 16   | 1 2 1 |
    vec3 color = e*4.0;
    color += (b+d+f+h)*2.0;
    color += (a+c+g+i);
    color *= 1.0 / 16.0;

    imageStore(image0, ivec2(px), vec4(color, 1.0));
}