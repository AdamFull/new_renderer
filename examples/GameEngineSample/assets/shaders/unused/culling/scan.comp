#include "ptr.h"

#define GROUP_SIZE 256

layout(local_size_x = GROUP_SIZE) in;

layout(push_constant) uniform PushConstant
{
	GET_PTR_T(uint32_t) input_buffer;
    GET_PTR_T(uint32_t) output_buffer;

    uint32_t size;
} pc;

shared uint32_t temp[GROUP_SIZE * 2];

uint32_t SampleBit(uint32_t global_id)
{
    // Handle bit array input
     uint32_t word_index = global_id >> 5;       // Divide by 32
     uint32_t bit_index = global_id & 31;       // Modulo 32
     uint32_t word = pc.input_buffer[word_index].data;
     return (word >> bit_index) & 1u;
}

void main()
{
    uint32_t thid = gl_LocalInvocationID.x;
    uint32_t n = gl_WorkGroupSize.x * 2;  // n = 2 * local_size_x

    // Compute global indices. 
    // If each workgroup handles n elements, the global index for the data:
    uint32_t globalIndex = gl_GlobalInvocationID.x * 2;

    // Load input into shared memory:
    // Note: the original CUDA code shows temp[2*thid+1] commented out, but presumably it should be loaded as well.
#ifdef INPUT_BIT_ARRAY
    temp[2 * thid] = SampleBit(globalIndex);
    temp[2 * thid + 1] = SampleBit(globalIndex + 1);
#else
    temp[2 * thid] = pc.input_buffer[globalIndex].data;
    temp[2 * thid + 1] = pc.input_buffer[globalIndex + 1].data;
#endif


    int offset = 1;

    // Build sum in place up the tree
    for (int d = int(n >> 1); d > 0; d >>= 1) 
    {
        barrier(); // sync threads
        if (int(thid) < d) 
        {
            int ai = offset * (2 * int(thid) + 1) - 1;
            int bi = offset * (2 * int(thid) + 2) - 1;
            temp[bi] += temp[ai];
        }
        offset *= 2;
    }

    // Clear the last element
    if (thid == 0) 
    {
        temp[n - 1] = 0u;
    }

    // Traverse down tree and build scan
    for (int d = 1; d < int(n); d *= 2) 
    {
        offset >>= 1;
        barrier(); // sync threads
        if (int(thid) < d) 
        {
            int ai = offset * (2 * int(thid) + 1) - 1;
            int bi = offset * (2 * int(thid) + 2) - 1;
            uint32_t t = temp[ai];
            temp[ai] = temp[bi];
            temp[bi] += t;
        }
    }

    barrier(); // ensure all data is ready

    // Write results to global memory
    pc.output_buffer[globalIndex].data = temp[2 * thid];
    pc.output_buffer[globalIndex + 1].data = temp[2 * thid + 1];
}